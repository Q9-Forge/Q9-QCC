// Beispiel für die Quant-Syntax mit Kontrollfluss
import namespace IO.Console;

namespace Math.Geometry {

    interface Shape {
        area(): int;
    }

    class Point implements Shape {
        x: int;
        y: int;

        constructor(x: int, y: int) {
            this.x = x;
            this.y = y;
        }

        area(): int {
            // Beispiel für Kontrollfluss
            if (this.x < 0) {
                return 0;
            } else {
                return this.x * this.y;
            }
        }
    }
}

function main(): int {
    let p: Point = Point(10, 20);
    let result: int = 0;

    // Beispiel für eine Schleife
    while (result < 5) {
        result = result + 1;
    }

    return p.area();
}
