// Beispiel für die Quant-Syntax mit Kontrollfluss, Sichtbarkeit und Pointern
import namespace IO.Console;

namespace Math.Geometry {

    interface Shape {
        area(): int;
    }

    class Point implements Shape {
        private x: int;
        private y: int;

        public constructor(x: int, y: int) {
            this.x = x;
            this.y = y;
        }

        public area(): int {
            if (this.x < 0) {
                return 0;
            } else {
                return this.x * this.y;
            }
        }
    }
}

// Beispiel für Memory-Mapped I/O und Pointer
[& 0xFF0020] let UART_STATUS: int;

function main(): int {
    let p: Point = Point(10, 20);
    let ptr: *Point = &p;
    
    // Dereferenzierung
    let val: int = (*ptr).area();

    // Zugriff auf Memory-Mapped Register
    if (UART_STATUS == 1) {
        return 1;
    }

    return 0;
}
