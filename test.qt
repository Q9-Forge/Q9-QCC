// Beispiel für die Quant-Syntax gemäß README-Spezifikation
import namespace IO.Console;

namespace Math.Geometry {

    interface Shape {
        area(): int;
    }

    class Point implements Shape {
        x: int;
        y: int;

        constructor(x: int, y: int) {
            this.x = x;
            this.y = y;
        }

        area(): int {
            return this.x * this.y;
        }
    }
}

function main(): int {
    let p: Point = Point(10, 20);
    let result: int = p.area();

    return result;
}
