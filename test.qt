// Beispiel für die Quant-Syntax mit Kontrollfluss, Sichtbarkeit, Pointern, Arrays, Casting und dynamischen Klassen
import namespace IO.Console;

namespace Math.Geometry {

    interface Shape {
        area(): int;
    }

    class Point implements Shape {
        private x: int;
        private y: int;

        public constructor(x: int, y: int) {
            this.x = x;
            this.y = y;
        }

        public area(): int {
            if (this.x < 0) {
                return 0;
            } else {
                return this.x * this.y;
            }
        }
    }
}

// Beispiel für dynamische Klassen
[@dynamic]
class Config {
    public id: int;
}

// Beispiel für Memory-Mapped I/O, Pointer, Arrays und Casting
[& 0xFF0020] let UART_STATUS: int;

function main(): int {
    let p: Point = Point(10, 20);
    let ptr: *Point = &p;
    
    // Array-Deklaration
    let buffer: int[10];
    
    // Dereferenzierung
    let val: int = (*ptr).area();

    // Expliziter Type-Cast
    let statusPtr: *int = (*int)0xFF0020;

    // Zugriff auf Memory-Mapped Register
    if (UART_STATUS == 1) {
        return 1;
    }

    // Dynamischer Zugriff
    let c: Config = Config();
    let key: int = 100;
    c[key] = 500;
    let dynamicVal: int = c[key];

    return 0;
}
