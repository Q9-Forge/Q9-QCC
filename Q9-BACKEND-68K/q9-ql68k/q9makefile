# QCC 68000 object linker builds.
[global]
TOOLCHAIN_FILE = ../../Q9-Make/toolchains/qmake.conf

[ACA]
all: macCla
macCla: mac
mac: $(Q9SDK)/macOS/ARM64/CMDS/ql68k
$(Q9SDK)/macOS/ARM64/CMDS/ql68k: src/ql68.c
	mkdir -p "$(Q9SDK)/macOS/ARM64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -Wno-builtin-requires-header -o "$(Q9SDK)/macOS/ARM64/CMDS/ql68k" src/ql68.c
clean:
	rm -f "$(Q9SDK)/macOS/ARM64/CMDS/ql68k"

[AXQ]
all: macXCC
macXCC: mac-qcpp-host xcc
xcc: $(Q9SDK)/Q9/68k/CMDS_XCC/ql68k

mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp
$(HOST_OUTPUT_DIR)/qcpp: ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c

$(Q9SDK)/Q9/68k/CMDS_XCC/ql68k: src/ql68.c ../../tools/build_xcc_sdk.sh
	bash ../../tools/build_xcc_sdk.sh ql68k
clean:
	rm -f "$(Q9SDK)/Q9/68k/CMDS_XCC/ql68k"

[AQQ]
all: macQCC
macQCC: mac-qcpp-host xqcc $(HOST_OUTPUT_DIR)/qcc
xqcc: $(Q9SDK)/Q9/68k/CMDS_XQCC/ql68k
$(Q9SDK)/Q9/68k/CMDS_XQCC/ql68k: src/ql68.c $(TARGET_CC)
	mkdir -p "$(TARGET_OUTPUT_DIR)" && Q9SDK="$(Q9SDK)" PATH="$(HOST_OUTPUT_DIR):$PATH" $(TARGET_CC) --largedata --stack 512K -o "$(TARGET_OUTPUT_DIR)/ql68k" src/ql68.c
$(HOST_OUTPUT_DIR)/qcc: ../../Q9-QCC/src/qcc.c
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" ../../Q9-QCC/src/qcc.c
mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp
$(HOST_OUTPUT_DIR)/qcpp: ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
clean:
	rm -f "$(Q9SDK)/Q9/68k/CMDS_XQCC/ql68k"

[QQQ]
all: q9QCC
q9QCC: q9
q9: /dd/CMDS_QCC/ql68k
/dd/CMDS_QCC/ql68k: src/ql68.c
	qcc --largedata --stack 512K -o /dd/CMDS_QCC/ql68k src/ql68.c
clean:
	rm -f /dd/CMDS_QCC/ql68k

[ACI]
all: macX64
macX64: $(Q9SDK)/macOS/x86_64/CMDS/ql68k
$(Q9SDK)/macOS/x86_64/CMDS/ql68k: src/ql68.c
	mkdir -p "$(Q9SDK)/macOS/x86_64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -Wno-builtin-requires-header -o "$(Q9SDK)/macOS/x86_64/CMDS/ql68k" src/ql68.c
clean:
	rm -f "$(Q9SDK)/macOS/x86_64/CMDS/ql68k"
