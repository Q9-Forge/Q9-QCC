* Wurzel-psect mit KRUMMEN Datengroessen -- damit -b= sichtbar wird.
* dc: ein Byte, dann ein Zeiger (r68 richtet den auf Wort aus) = 6 Byte.
* ds: 5 Byte. Beides ungerade Vielfache jeder -b=-Grenze.
         psect   oa,$0101,$8000,1,100,start
start    moveq   #1,d0
         jsr     sub1(pc)
         move.l  aptr(a6),d1
         move.b  aklein(a6),d2
         move.b  abuf(a6),d3
         rts
         vsect
aklein   dc.b    $77
aptr     dc.l    start
abuf     ds.b    5
         ends
         ends
