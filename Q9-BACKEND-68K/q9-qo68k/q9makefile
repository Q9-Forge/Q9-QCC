# QCC 68000 machine-code optimizer builds.
[global]
TOOLCHAIN_FILE = ../../Q9-Make/toolchains/qmake.conf

[ACA]
all: macCla
macCla: mac
mac: $(Q9SDK)/macOS/ARM64/CMDS/qo68k
$(Q9SDK)/macOS/ARM64/CMDS/qo68k: src/main.c src/qo68.c
	mkdir -p "$(Q9SDK)/macOS/ARM64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(Q9SDK)/macOS/ARM64/CMDS/qo68k" src/main.c
clean:
	rm -f "$(Q9SDK)/macOS/ARM64/CMDS/qo68k"

[AXQ]
all: macXCC
macXCC: mac-qcpp-host xcc
xcc: $(Q9SDK)/Q9/68k/CMDS_XCC/qo68k

mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp
$(HOST_OUTPUT_DIR)/qcpp: ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c

$(Q9SDK)/Q9/68k/CMDS_XCC/qo68k: src/main.c src/qo68.c ../../tools/build_xcc_sdk.sh
	bash ../../tools/build_xcc_sdk.sh qo68k
clean:
	rm -f "$(Q9SDK)/Q9/68k/CMDS_XCC/qo68k"

[AQQ]
all: macQCC
macQCC: mac-qcpp-host xqcc $(HOST_OUTPUT_DIR)/qcc
xqcc: $(Q9SDK)/Q9/68k/CMDS_XQCC/qo68k
$(Q9SDK)/Q9/68k/CMDS_XQCC/qo68k: src/main.c src/qo68.c $(TARGET_CC)
	mkdir -p "$(TARGET_OUTPUT_DIR)" && Q9SDK="$(Q9SDK)" PATH="$(HOST_OUTPUT_DIR):$PATH" $(TARGET_CC) --largedata --stack 512K -o "$(TARGET_OUTPUT_DIR)/qo68k" src/main.c
$(HOST_OUTPUT_DIR)/qcc: ../../Q9-QCC/src/qcc.c
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" ../../Q9-QCC/src/qcc.c
mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp
$(HOST_OUTPUT_DIR)/qcpp: ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
clean:
	rm -f "$(Q9SDK)/Q9/68k/CMDS_XQCC/qo68k"

[LQQ]
all: linuxQCC
linuxQCC: linux-qcpp-host xqcc $(HOST_OUTPUT_DIR)/qcc
xqcc: $(Q9SDK)/Q9/68k/CMDS_XQCC/qo68k
$(Q9SDK)/Q9/68k/CMDS_XQCC/qo68k: src/main.c src/qo68.c $(TARGET_CC)
	mkdir -p "$(TARGET_OUTPUT_DIR)" && Q9SDK="$(Q9SDK)" PATH="$(HOST_OUTPUT_DIR):$PATH" $(TARGET_CC) --largedata --stack 512K -o "$(TARGET_OUTPUT_DIR)/qo68k" src/main.c
$(HOST_OUTPUT_DIR)/qcc: ../../Q9-QCC/src/qcc.c
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" ../../Q9-QCC/src/qcc.c
linux-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp
$(HOST_OUTPUT_DIR)/qcpp: ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
clean:
	rm -f "$(Q9SDK)/Q9/68k/CMDS_XQCC/qo68k"

[QQQ]
all: q9QCC
q9QCC: q9
q9: /dd/CMDS_QCC/qo68k
/dd/CMDS_QCC/qo68k: src/main.c src/qo68.c
	qcc --largedata --stack 512K -o /dd/CMDS_QCC/qo68k src/main.c
clean:
	rm -f /dd/CMDS_QCC/qo68k

[ACI]
all: macX64
macX64: $(Q9SDK)/macOS/x86_64/CMDS/qo68k
$(Q9SDK)/macOS/x86_64/CMDS/qo68k: src/main.c src/qo68.c
	mkdir -p "$(Q9SDK)/macOS/x86_64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -o "$(Q9SDK)/macOS/x86_64/CMDS/qo68k" src/main.c
clean:
	rm -f "$(Q9SDK)/macOS/x86_64/CMDS/qo68k"

[LGL]
all: linux
linux: $(HOST_OUTPUT_DIR)/qo68k
$(HOST_OUTPUT_DIR)/qo68k: src/main.c src/qo68.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qo68k" src/main.c
clean:
	rm -f "$(HOST_OUTPUT_DIR)/qo68k"
