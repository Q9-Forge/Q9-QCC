	cat "$(BUILD_DIR)/extra_file_c.r" "$(BUILD_DIR)/extra_bsearch_c.r" "$(BUILD_DIR)/extra_qsort_c.r" "$(BUILD_DIR)/printf.r" "$(BUILD_DIR)/printf_c.r" "$(BUILD_DIR)/file.r" "$(BUILD_DIR)/file_c.r" "$(BUILD_DIR)/str.r" "$(BUILD_DIR)/str_c.r" "$(BUILD_DIR)/ctype.r" "$(BUILD_DIR)/ctype_c.r" "$(BUILD_DIR)/mem.r" "$(BUILD_DIR)/mem_c.r" "$(BUILD_DIR)/iob.r" "$(BUILD_DIR)/os9call.r" >> "$(BUILD_DIR)/qclib.l"
