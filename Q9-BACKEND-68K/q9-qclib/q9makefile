	cat "$(BUILD_DIR)/extra_locale.r" "$(BUILD_DIR)/extra_mb.r" "$(BUILD_DIR)/extra_mbs.r" "$(BUILD_DIR)/extra_memchr.r" "$(BUILD_DIR)/extra_memcmp.r" "$(BUILD_DIR)/extra_memmove.r" "$(BUILD_DIR)/extra_perror.r" "$(BUILD_DIR)/extra_putc.r" "$(BUILD_DIR)/extra_qsort.r" "$(BUILD_DIR)/extra_rand.r" "$(BUILD_DIR)/extra_remove.r" "$(BUILD_DIR)/extra_rename.r" >> "$(BUILD_DIR)/qclib.l"
