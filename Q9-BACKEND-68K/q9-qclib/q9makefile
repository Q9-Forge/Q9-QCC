# qclib uses Q9-QCC's own IR pipeline; library member order below is ABI-significant.
[global]
TOOLCHAIN_FILE = ../../Q9-Make/toolchains/qmake.conf
QCPP = $(Q9_TOOL_DIR)/qcpp
QCIR = $(Q9_TOOL_DIR)/qcir
QCCB = $(Q9_TOOL_DIR)/qir68k
QR68 = $(Q9_TOOL_DIR)/qr68k
QCPP_INCLUDE = ../../Q9-FRONTEND-C/q9-qcpp/include

check-sdk:
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }
	test -d "$(Q9SDK)" || { echo "Q9SDK directory does not exist: $(Q9SDK)" >&2; exit 2; }

help:
	echo "\\nqmake: QCLIB - Q9 C runtime library"
	echo "  macCla  build qclib with the native ARM64 Q9-QCC tools"
	echo "  macX64  build qclib with the Intel-host Q9-QCC tools"
	echo "  test    run target/emulator qclib regression tests"
	echo "  clean   remove qclib build outputs\\n"

[mac-clang]
Q9_TOOL_DIR = $(HOST_OUTPUT_DIR)
BUILD_DIR = build/mac-clang
all: build/mac-clang/qclib.l build/mac-clang/q9_start.r
macCla: all

[mac-clang-x86_64]
Q9_TOOL_DIR = $(HOST_OUTPUT_DIR)
BUILD_DIR = build/mac-clang-x86_64
all: build/mac-clang-x86_64/qclib.l build/mac-clang-x86_64/q9_start.r
macX64: all

[global]
$(HOST_OUTPUT_DIR)/qcpp: check-sdk ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -Wno-builtin-requires-header -o "$(HOST_OUTPUT_DIR)/qcpp" ../../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
$(HOST_OUTPUT_DIR)/qcir: check-sdk ../../Q9-FRONTEND-C/q9-qcir/data/qcc_p.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcir" ../../Q9-FRONTEND-C/q9-qcir/data/qcc_p.c
$(HOST_OUTPUT_DIR)/qir68k: check-sdk ../q9-qir68k/src/qcc_backend_c.cpp ../q9-qir68k/src/qcc_backend_peephole.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -x c -std=c11 -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qir68k" ../q9-qir68k/src/qcc_backend_c.cpp
$(HOST_OUTPUT_DIR)/qr68k: check-sdk ../q9-qr68k/src/qr68.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -Wno-builtin-requires-header -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qr68k" ../q9-qr68k/src/qr68.c

