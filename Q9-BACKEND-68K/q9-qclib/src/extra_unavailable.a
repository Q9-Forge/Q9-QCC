* Stable failure returns for OS-9 services not yet exposed by qclib.
         psect qunavailable,0,0,0,0,0
signal:
raise:
clock:
         moveq #-1,d0
         rts
time:
         moveq #-1,d0
         rts
tmpfile:
tmpnam:
         moveq #0,d0
         rts
vprintf:
vfprintf:
vsprintf:
scanf:
sscanf:
fscanf:
         moveq #-1,d0
         rts
strtod:
atof:
         moveq #0,d0
         moveq #0,d1
         rts
         ends
