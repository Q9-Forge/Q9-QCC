* Stable failure returns for OS-9 services not yet exposed by qclib.
         psect qunavailable,0,0,0,0,0
signal:
raise:
clock:
         moveq #-1,d0
         rts
time:
         moveq #-1,d0
         rts
tmpfile:
tmpnam:
         moveq #0,d0
         rts
vprintf:
vfprintf:
vsprintf:
scanf:
sscanf:
fscanf:
         moveq #-1,d0
         rts
strtod:
atof:
         moveq #0,d0
         moveq #0,d1
         rts
frexp:
fmod:
ldexp:
modf:
         moveq #0,d0
         moveq #0,d1
         rts
localtime:
gmtime:
asctime:
ctime:
         moveq #0,d0
         rts
mktime:
         moveq #-1,d0
         rts
strftime:
         moveq #0,d0
         rts
log:
cos:
sin:
exp:
atan:
pow:
cosh:
log10:
tan:
sinh:
         moveq #0,d0
         moveq #0,d1
         rts
acos:
asin:
tanh:
atan2:
         moveq #0,d0
         moveq #0,d1
         rts
localeconv:
         moveq #0,d0
         rts
longjmp:
div:
ldiv:
fgetpos:
         moveq #-1,d0
         rts
bsearch:
         moveq #0,d0
         rts
         ends
