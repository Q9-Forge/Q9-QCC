* q9-qclib ABI adapters for ASCII ctype functions.

         psect   qctype,0,0,0,0,0

isalnum:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_isalnum
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

isalpha:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_isalpha
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

