* q9-qclib OS-9 system-call wrappers
*
* Purpose: provide the small, self-contained OS-9 ABI layer required by qclib.
*
* Edition history:
*   2026-09-11  Introduced the English source-header format.
*
* _os_write und _os_exit -- die beiden Systemaufrufe, die die Kette
* braucht. Damit entfaellt die Abhaengigkeit von der Herstellerbibliothek os_lib.l.
*
* WARUM DAS HIER STEHT: os_lib.l ist wie clib.l ein libgen-Archiv
* (Kennung $2d00d5bc) und damit fuer ql68 unlesbar. Solange die Kette
* daran haengt, muss mit l68 gebunden werden. Es sind aber nur zwei
* Aufrufe -- und ein Systemaufruf ist unter OS-9/68000 nichts weiter als
* TRAP #0 mit dem Servicewort dahinter.
*
* Grundlagen:
*   - Trap-Muster: im OS-9/68000-ABI folgt das Servicewort direkt auf
*     TRAP #0 (siehe Q9DEFS/q9sys.d; auf 68030 bestaetigt).
*   - Servicenummern: I$Write $8a, F$Exit $06, F$SRqMem $28, F$SRtMem $29
*     (siehe Q9DEFS/q9sys.d).
*   - Registerbelegung: d0 = Pfadnummer, d1 = Anzahl, a0 = Puffer
*     (auf 68030 bestaetigt).
*
* Die Konstanten stehen bewusst HIER und nicht in einem "use" auf eine
* externe Definitionsdatei -- qclib soll ohne fremden Baum uebersetzbar sein.

Q9I_Create     equ     $83                      * I$Create, Datei anlegen
Q9I_Delete     equ     $87                      * I$Delete, Datei loeschen
Q9I_Rename     equ     $86                      * I$Rename, Datei umbenennen
Q9I_Open       equ     $84                      * I$Open, Datei oeffnen
Q9I_Read       equ     $89                      * I$Read, Daten lesen
Q9I_Write      equ     $8a                      * I$Write, Daten schreiben
Q9I_Close      equ     $8f                      * I$Close, Pfad schliessen
Q9I_Dup        equ     $82                      * I$Dup, Pfad duplizieren
Q9F_Exit       equ     $06                      * F$Exit, Prozess beenden
Q9F_SRqMem     equ     $28                      * F$SRqMem, Speicher holen
Q9F_SRtMem     equ     $29                      * F$SRtMem, Speicher zurueck
Q9F_SysDbg     equ     $52                      * F$SysDbg, Systemdebugger aufrufen
Q9F_GPrDBT     equ     $1f                      * F$GPrDBT, Prozessdeskriptor-Basistabelle kopieren
Q9F_Event      equ     $53                      * F$Event, benanntes Event anlegen/verwalten
Q9F_Link       equ     $00                      * F$Link, an geladenes Modul anhaengen
Q9F_Load       equ     $01                      * F$Load, Modul ueber den IOMan laden
Q9F_GPrDsc     equ     $18                      * F$GPrDsc, EINEN Prozessdeskriptor kopieren
Q9F_UnLink     equ     $02                      * F$UnLink, Modullink freigeben
Q9F_Fork       equ     $03                      * F$Fork, Kindprozess starten
Q9F_Wait       equ     $04                      * F$Wait, auf Kindprozess warten
Q9I_Attach     equ     $80                      * I$Attach, Geraet am System anmelden
Q9I_Detach     equ     $81                      * I$Detach, Geraet vom System abmelden
Q9I_GetStt     equ     $8d                      * I$GetStt, Pfad-/Geraetestatus lesen
Q9I_SetStt     equ     $8e                      * I$SetStt, Pfad-/Geraetestatus setzen
Q9I_Seek       equ     $88                      * I$Seek, Dateizeiger versetzen
Q9F_SetSys     equ     $27                      * F$SetSys, Systemglobale lesen/setzen
Q9F_GBlkMp     equ     $19                      * F$GBlkMp, Kopie der freien Speicherblockliste

         psect   qos9,0,0,0,0,0

* error_code _os_write(path_id path, const void *buffer, u_int32 *count)
*
* C-Seite (Microware-Konvention): d0 = path, d1 = buffer, 4(a7) = &count.
* count ist ein IN/OUT-Zeiger: hinein die gewuenschte Anzahl, heraus die
* tatsaechlich geschriebene.
* OS-9 meldet einen Fehler ueber das Uebertragsbit, der Code steht in d1.

* Function: _os_write
* Writes a byte range to an open OS-9 path.
* Parameters: d0 path, d1 buffer, stack argument points to byte count.
* Returns: OS-9 error code in d0 (zero on success).
_os_write:
         movea.l d1,a0                           * Puffer nach a0
         movea.l 4(a7),a1                        * &count
         move.l  (a1),d1                         * gewuenschte Anzahl
         trap    #0
         dc.w    Q9I_Write
         bcs.s   ow_err
         move.l  d1,(a1)                         * tatsaechlich geschrieben
         moveq   #0,d0                           * kein Fehler
         rts
ow_err
         moveq   #0,d0
         move.w  d1,d0                           * Fehlercode zurueckgeben
         rts

* void _os_exit(int status) -- kehrt nicht zurueck.
* Der zweite Aufruf ist die Sicherung fuer den Fall, dass ein Debugger den
* ersten abfaengt.

* Function: _os_exit
* Terminates the current OS-9 process.
* Parameters: d0 process status.
* Returns: Does not return under normal OS-9 operation.
_os_exit:
         move.l  d0,d1                           * Status nach d1
         trap    #0
         dc.w    Q9F_Exit
         trap    #0
         dc.w    Q9F_Exit
         rts


* error_code _os_open(const char *name, u_int32 mode, path_id *path)
*
* C-Seite: d0 = name, d1 = mode, 4(a7) = &path.
* OS-9-Seite: d0.w = Zugriffsmodus, a0 = Pfadname; zurueck kommt die
* Pfadnummer in d0. Sie wird auf 16 Bit maskiert, sonst stehen im oberen
* Wort Reste.

* Function: _os_open
* Opens an existing OS-9 file.
* Parameters: d0 name, d1 mode, stack argument points to path output.
* Returns: OS-9 error code in d0.
_os_open:
         movea.l d0,a0                           * Name nach a0
         move.l  d1,d0                           * Modus nach d0
         trap    #0
         dc.w    Q9I_Open
         bcs.s   oo_err
         andi.l  #$0000ffff,d0                   * nur die Pfadnummer
         movea.l 4(a7),a1                        * &path
         move.l  d0,(a1)
         moveq   #0,d0
         rts
oo_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_close(path_id path) -- d0 traegt den Pfad schon.

* Function: _os_close
* Closes an OS-9 path.
* Parameters: d0 path number.
* Returns: OS-9 error code in d0.
_os_close:
         trap    #0
         dc.w    Q9I_Close
         bcs.s   oc_err
         moveq   #0,d0
         rts
oc_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_read(path_id, void *buffer, u_int32 *count)
* Spiegelbild von _os_write: d0 = Pfad, d1 = Puffer, 4(a7) = &count.

* Function: _os_read
* Reads a byte range from an open OS-9 path.
* Parameters: d0 path, d1 buffer, stack argument points to byte count.
* Returns: OS-9 error code in d0.
_os_read:
         movea.l d1,a0                           * Puffer nach a0
         movea.l 4(a7),a1                        * &count
         move.l  (a1),d1                         * gewuenschte Anzahl
         trap    #0
         dc.w    Q9I_Read
         bcs.s   or_err
         move.l  d1,(a1)                         * tatsaechlich gelesen
         moveq   #0,d0
         rts
or_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_create(const char *name, u_int32 mode, path_id *path,
*                       u_int32 perms)
* Wie _os_open, zusaetzlich die Dateirechte in d1.w (I$Create erwartet
* den Zugriffsmodus in d0.b und die Attribute in d1.w).

* Function: _os_create
* Creates and opens an OS-9 file.
* Parameters: d0 name, d1 mode, stack arguments contain path and permissions.
* Returns: OS-9 error code in d0.
* Function: _os_delete
* Deletes an OS-9 directory entry by pathname.
* Parameters: d0 pathname.
* Returns: OS-9 error code in d0.
_os_delete:
         movea.l d0,a0
         trap    #0
         dc.w    Q9I_Delete
         bcs.s   odel_err
         moveq   #0,d0
         rts
odel_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_rename(const char *old_name, const char *new_name)
* OS-9 I$Rename receives the two pathnames in a0 and a1.
_os_rename:
         movea.l d0,a0
         movea.l d1,a1
         trap    #0
         dc.w    Q9I_Rename
         bcs.s   oren_err
         moveq   #0,d0
         rts
oren_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* int _os_load(const char *name, int mode, int color, void **module)
*
* F$Load (Servicewort $01): d0.w = Zugriffsmodus (1 = Read), d1.l = Farbe,
* a0 = Pfadname; bei Erfolg liefert a2 den Modulkopf. Der Q9-Kernel leitet
* diesen Call an den IOMan weiter, der die Datei liest und validiert.
_os_load:
         move.l  a2,-(a7)
         movea.l d0,a0
         move.l  d1,d0
         move.l  8(a7),d1                       * Farbe (3. C-Argument)
         move.w  d0,d2                          * Zugriffsmodus kurz sichern
         move.w  d2,d0
         trap    #0
         dc.w    Q9F_Load
         bcs.s   old_err
         movea.l 12(a7),a1                      * &module (4. C-Argument)
         move.l  a2,(a1)
         moveq   #0,d0
         movea.l (a7)+,a2
         rts
old_err
         moveq   #0,d0
         move.w  d1,d0
         movea.l (a7)+,a2
         rts

* int _os_unlink(void *module)
* F$UnLink receives the resident module header in a2.
_os_unlink:
         movea.l d0,a2
         trap    #0
         dc.w    Q9F_UnLink
         bcs.s   ounl_err
         moveq   #0,d0
         rts
ounl_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* int _os_fork(int typelang, long addmem, long paramsize, int numpaths,
*              int priority, const char *name, const char *params)
*
* QCC ABI: first two args in d0/d1; remaining args follow the return PC on
* the stack. F$Fork uses d0-d4 and a0-a1 exactly as laid out below.
_os_fork:
	 move.l  4(a7),d2                       * parameter size
	 move.l  8(a7),d3                       * number of paths to inherit
	 move.l  12(a7),d4                      * priority
         movea.l 16(a7),a0                      * module name
         movea.l 20(a7),a1                      * parameter string
         trap    #0
         dc.w    Q9F_Fork
         bcs.s   ofork_err
         andi.l  #$0000ffff,d0
         rts
ofork_err
         moveq   #0,d0
         move.w  d1,d0                           * Return -E$code for diagnostics
         neg.l   d0
         rts

* int _os_wait(int *status)
* F$Wait returns child PID in d0.w and child exit status in d1.w.
_os_wait:
         movea.l d0,a0
         move.l  a0,-(a7)
         trap    #0
         dc.w    Q9F_Wait
         bcs.s   owai_err
         movea.l (a7)+,a0
         clr.l   (a0)
         move.w  d1,2(a0)                       * C int: status in low word (68000 big-endian)
         andi.l  #$0000ffff,d0
         rts
owai_err
         addq.l  #4,a7
         moveq   #-1,d0
         rts

_os_create:
         movea.l d0,a0                           * Name nach a0
         move.l  d1,d0                           * Modus nach d0
         move.l  8(a7),d1                        * Rechte nach d1
         trap    #0
         dc.w    Q9I_Create
         bcs.s   ocr_err
         andi.l  #$0000ffff,d0
         movea.l 4(a7),a1
         move.l  d0,(a1)
         moveq   #0,d0
         rts
ocr_err
         moveq   #0,d0
         move.w  d1,d0
         rts


* error_code _os_srqmem(u_int32 want, u_int32 *granted, void **addr)
*
* Speicher beim System holen. 0 = geholt, sonst der OS-9-Fehlercode.
*
* DREIFACH BELEGT, weil hier nichts abgeleitet werden durfte:
*   1. Das technische Handbuch (68k_tech.pdf, "F$SRqMem System Memory
*      Request"): d0.l ein = Byteanzahl, d0.l aus = gewaehrte Anzahl,
*      (a2) = Zeiger auf den Block, Fehler ueber das Uebertragsbit mit
*      dem Code in d1.w. Die Anzahl wird auf ein Vielfaches der
*      Systemblockgroesse aufgerundet (derzeit 16), die Adresse ist
*      immer gerade. Mit -1 in d0.l kommt der GROESSTE freie Block --
*      damit laesst sich die Obergrenze der Maschine messen.
*   2. Die Farbvariante TRAP $5c (F$SRqCMem) hat denselben Registersatz,
*      mit der Farbe als drittem Argument. Das Handbuch dazu: "F$SRqMem is
*      equivalent to a F$SRqCMem request with a color of 0."
*   3. Der eigene Kernel (Q9-OS, q9kernel_entry.a) dokumentiert fuer
*      F$SRqMem genau diese Belegung -- und er kennt $28, nicht $5c.
*      Deshalb steht hier $28: qclib soll auch auf dem eigenen System
*      laufen.
*
* a2 wird gerettet: der Aufruf gibt darin sein Ergebnis zurueck, und ob
* der Aufrufer a2 fuer erhalten haelt, waere eine eigene Messung. Der
* Microware-Rumpf rettet es ebenfalls.
*
* ACHTUNG BEIM DRITTEN ARGUMENT: es liegt bei 4(a7), aber das a2 auf dem
* Stack schiebt es auf 8(a7). Wer hier 4(a7) liest, bekommt die
* Ruecksprungadresse und schreibt den Zeiger dorthin.

* Function: _os_srqmem
* Requests a block of OS-9 system memory.
* Parameters: d0 requested size, d1 granted-size pointer, stack argument address output.
* Returns: OS-9 error code in d0.
_os_srqmem:
         move.l  a2,-(a7)                        * a2 retten
         movea.l d1,a1                           * &granted
         trap    #0                              * d0.l = gewuenschte Anzahl
         dc.w    Q9F_SRqMem
         bcs.s   sq_err
         move.l  d0,(a1)                         * gewaehrte Anzahl
         movea.l 8(a7),a1                        * &addr (4(a7) + das a2)
         move.l  a2,(a1)                         * der Blockanfang
         moveq   #0,d0                           * kein Fehler
         movea.l (a7)+,a2
         rts
sq_err
         moveq   #0,d0
         move.w  d1,d0                           * Fehlercode zurueckgeben
         movea.l (a7)+,a2
         rts

* error_code _os_srtmem(u_int32 size, void *addr)
* d0 = Groesse (wie geholt), d1 = Zeiger; OS-9 erwartet den Zeiger in a2.

* Function: _os_srtmem
* Returns a previously requested memory block to OS-9.
* Parameters: d0 block size, d1 block address.
* Returns: OS-9 error code in d0.
_os_srtmem:
         move.l  a2,-(a7)
         movea.l d1,a2                           * Blockadresse
         trap    #0                              * d0.l = Groesse
         dc.w    Q9F_SRtMem
         bcs.s   st_err
         moveq   #0,d0
         movea.l (a7)+,a2
         rts
st_err
         moveq   #0,d0
         move.w  d1,d0                           * Fehlercode zurueckgeben
         movea.l (a7)+,a2
         rts

* int _os_dup(path_id path) -- d0 traegt den zu duplizierenden Pfad schon.
* Liefert die NEUE Pfadnummer (>= 0) oder -1 bei Fehler. OS-9 vergibt dabei
* stets die niedrigste freie Nummer -- zusammen mit _os_close reicht das,
* um einen Pfad "an eine feste Stelle zurueckzuklappen" (dup, close,
* dup): erst den Originalpfad duplizieren, dann Pfad 1 schliessen und neu
* oeffnen, und am Ende per zweitem _os_dup auf das gemerkte Duplikat die
* Originalnummer zurueckbekommen, weil sie inzwischen wieder frei ist.

* Function: _os_dup
* Duplicates an OS-9 path.
* Parameters: d0 path number.
* Returns: New path number in d0, or -1 on error.
_os_dup:
         trap    #0
         dc.w    Q9I_Dup
         bcs.s   od_err
         andi.l  #$0000ffff,d0                    * nur die Pfadnummer
         rts
od_err
         moveq   #-1,d0
         rts


* error_code _os_sysdbg(void *, void *)
*
* F$SysDbg (Servicewort $52) kennt KEIN Eingaberegister und liefert auch
* keins zurueck (68k_tech.pdf, "OS-9 for 68K Processors Technical Manual"
* V3.3, S.517-519) -- die zwei void*-Parameter unseres Prototyps haben
* also keine ABI-Bedeutung, sie werden einfach nicht angefasst.

* Function: _os_sysdbg
* Invokes the system-level debugger.
* Parameters: none (the two C arguments carry no register meaning).
* Returns: OS-9 error code in d0.
_os_sysdbg:
         trap    #0
         dc.w    Q9F_SysDbg
         bcs.s   osd_err
         moveq   #0,d0
         rts
osd_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_get_prtbl(void *buffer, u_int32 *count)
*
* F$GPrDBT (Servicewort $1f): (a0) = Puffer, d1.l EIN = max. Byteanzahl,
* d1.l AUS = tatsaechlich kopierte Byteanzahl -- dasselbe Register fuer
* beide Richtungen (68k_tech.pdf S.439). d0 traegt den Puffer schon (erstes
* CALLEXT-Register), d1 den &count-Zeiger (zweites Register); der
* gewuenschte Hoechstwert wird vor dem Trap aus *count geladen.

* Function: _os_get_prtbl
* Copies the process descriptor base table.
* Parameters: d0 buffer, d1 pointer to max/actual byte count (in/out).
* Returns: OS-9 error code in d0.
_os_get_prtbl:
         movea.l d0,a0                           * Puffer
         movea.l d1,a1                           * &count
         move.l  (a1),d1                         * max. Byteanzahl (Eingabe)
         trap    #0
         dc.w    Q9F_GPrDBT
         bcs.s   ogp_err
         move.l  d1,(a1)                         * tatsaechliche Byteanzahl
         moveq   #0,d0
         rts
ogp_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_ev_delete(const char *name)
*
* F$Event (Servicewort $53) ist eine Sammelfunktion, die Unterfunktion
* steht in d1.w -- Ev$Delet ist Nummer 3
* (Ev$Link=0, Ev$UnLnk=1, Ev$Creat=2, Ev$Delet=3, ...). (a0) traegt den
* Eventnamen (68k_tech.pdf S.411). d0 traegt den Namenszeiger schon
* (einziges CALLEXT-Argument).

* Function: _os_ev_delete
* Deletes a named OS-9 event.
* Parameters: d0 event name pointer.
* Returns: OS-9 error code in d0.
_os_ev_delete:
         movea.l d0,a0                           * Eventname
         moveq   #3,d1                           * Ev$Delet-Unterfunktion
         trap    #0
         dc.w    Q9F_Event
         bcs.s   oed_err
         moveq   #0,d0
         rts
oed_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_link(char **name, mh_com **header, void **data,
*                     u_int16 *type_lang, u_int16 *attr_rev)
*
* F$Link (Servicewort $00): d0.w EIN = gewuenschter Typ/Sprache (0 =
* beliebig), (a0) = Modulname. AUS: d0.w = tatsaechlicher Typ/Sprache,
* d1.w = Attribute/Revision, a1 = Ausfuehrungseinsprung, a2 = Modulkopf-
* Zeiger (68k_tech.pdf S.460-461). Der Kernel liefert KEINEN eigenen
* "Datenbereich"-Zeiger zurueck -- *data bekommt deshalb hier bewusst 0
* (kein Feld in unserem eigenen mh_exec-Layout haengt direkt daran, und
* keine unserer Quellen liest *data ueberhaupt aus, siehe link.c).
*
* CALLEXT-Register: d0 = &name (Zeiger auf den Namenszeiger, dereferenziert
* nach a0), d1 = &header, Stapel (VOR jedem eigenen Push) 4(a7) = &data,
* 8(a7) = &type_lang, 12(a7) = &attr_rev. a2 wird vom Kernel benutzt und
* darum wie bei _os_srqmem gerettet; d2 haelt &header ueber den Trap
* hinweg (a1 traegt danach den Ausfuehrungseinsprung, nicht mehr &header).

* Function: _os_link
* Links to (registers with) an already-loaded OS-9 module by name.
* Parameters: d0 &name, d1 &header, stack pointers to &data/&type_lang/&attr_rev.
* Returns: OS-9 error code in d0.
_os_link:
         move.l  a2,-(a7)                        * a2 retten (Kernel liefert Modulkopf darin)
         move.l  d2,-(a7)                        * d2 als Zwischenspeicher fuer &header
         movea.l d0,a1                           * &name
         movea.l (a1),a0                         * tatsaechlicher Modulname nach a0
         movea.l d1,d2                           * &header ueber den Trap hinweg merken
         moveq   #0,d0                           * gewuenschter Typ/Sprache: beliebig
         trap    #0
         dc.w    Q9F_Link
         bcs.s   ol_err
         movea.l d2,a1
         move.l  a2,(a1)                         * Modulkopf-Zeiger speichern
         movea.l 12(a7),a1                       * &data (4(a7) + zwei gerettete Langworte)
         clr.l   (a1)                            * kein eigener Datenzeiger vom Kernel -- 0
         movea.l 16(a7),a1                       * &type_lang
         move.w  d0,(a1)
         movea.l 20(a7),a1                       * &attr_rev
         move.w  d1,(a1)
         moveq   #0,d0
         move.l  (a7)+,d2
         movea.l (a7)+,a2
         rts
ol_err
         moveq   #0,d0
         move.w  d1,d0
         move.l  (a7)+,d2
         movea.l (a7)+,a2
         rts


* error_code _os_gprdsc(process_id pid, void *buffer, u_int32 *count)
*
* F$GPrDsc (Servicewort $18, 68k_tech.pdf S.440): d0.w = Prozess-ID,
* d1.w = Byteanzahl, (a0) = Puffer -- KEIN Ausgaberegister (anders als
* F$GPrDBT liefert der Kernel die tatsaechlich kopierte Anzahl nicht
* zurueck). *count bleibt deshalb nach dem Aufruf unveraendert, es
* traegt nur die vom Aufrufer gewuenschte Hoechstgrenze hinein.
*
* CALLEXT-Register: d0 = pid (bleibt fuer den Trap unangetastet), d1 =
* Puffer (nach a0 verschoben), 4(a7) = &count.

* Function: _os_gprdsc
* Copies a single process descriptor by process ID.
* Parameters: d0 process id, d1 buffer, stack argument points to max byte count.
* Returns: OS-9 error code in d0.
_os_gprdsc:
         movea.l d1,a0                           * Puffer
         movea.l 4(a7),a1                        * &count
         move.l  (a1),d1                         * gewuenschte Byteanzahl (Eingabe)
         trap    #0
         dc.w    Q9F_GPrDsc
         bcs.s   ogd_err
         moveq   #0,d0
         rts
ogd_err
         moveq   #0,d0
         move.w  d1,d0
         rts


* error_code _getsys(int offset, int flags)
*
* F$SetSys (Servicewort $27): d1.l = Groesse der Variable in Byte, Bit 31
* von d1 gesetzt = Lesezugriff ("examine"), Rueckgabewert in d2.l --
* _getsys nimmt BEIDE Werte vom Aufrufer entgegen
* (devs.c ruft z.B. _getsys(D_DevCnt, 0x80000002) fuer eine 2-Byte- und
* _getsys(D_DevTbl, 0x80000004) fuer eine 4-Byte-Systemglobale auf) --
* d0 traegt den Offset schon (erstes CALLEXT-Register), d1 das
* Groessen-/Examine-Wort (zweites Register), beide unveraendert fuer den
* Trap verwendbar.

* Function: _getsys
* Reads (examines) a system global variable by D_xxx offset.
* Parameters: d0 offset, d1 size-with-examine-bit (bit 31 set).
* Returns: the variable's value in d0 (no documented error path; matches
*          the original Microware template, which does not check carry).
_getsys:
         move.l  d2,-(a7)                         * d2 traegt das Ergebnis, retten
         trap    #0
         dc.w    Q9F_SetSys
         move.l  d2,d0                            * Ergebnis von F$SetSys
         move.l  (a7)+,d2
         rts

* void *attach(const char *name, int mode)
*
* I$Attach (Servicewort $80, 68k_tech.pdf S.537-539): d0.b = Zugriffsmodus
* (Read_/Write_/Updat_), (a0) = Geraetename. Rueckgabe: (a2) = Zeiger auf
* den neuen Geraetetabelleneintrag. d0 traegt den Namenszeiger schon
* (erstes CALLEXT-Register), d1 den Modus (zweites Register, nur das
* niedrigste Byte zaehlt).

* Function: attach
* Attaches a named I/O device to the system (or verifies it is attached).
* Parameters: d0 device name pointer, d1 access mode.
* Returns: device table entry pointer in d0, or NULL on error.
attach:
         move.l  a2,-(a7)                         * a2 retten (Kernel liefert den Zeiger darin)
         movea.l d0,a0                            * Geraetename
         move.b  d1,d0                            * Zugriffsmodus
         trap    #0
         dc.w    Q9I_Attach
         bcs.s   iat_err
         move.l  a2,d0                            * Geraetetabellen-Zeiger als Rueckgabewert
         movea.l (a7)+,a2
         rts
iat_err
         moveq   #0,d0                            * NULL bei Fehler
         movea.l (a7)+,a2
         rts

* error_code detach(void *device)
*
* I$Detach (Servicewort $81, 68k_tech.pdf S.549): (a2) = Geraetetabellen-
* Zeiger (derselbe Wert, den attach() zurueckgegeben hat). d0 traegt ihn
* schon (einziges CALLEXT-Argument).

* Function: detach
* Detaches a device previously attached with attach().
* Parameters: d0 device table entry pointer (as returned by attach()).
* Returns: OS-9 error code in d0.
detach:
         move.l  a2,-(a7)
         movea.l d0,a2                            * Geraetetabellen-Zeiger
         trap    #0
         dc.w    Q9I_Detach
         bcs.s   idt_err
         moveq   #0,d0
         movea.l (a7)+,a2
         rts
idt_err
         moveq   #0,d0
         move.w  d1,d0
         movea.l (a7)+,a2
         rts

* error_code _os_gs_devnm(path_id path, char *name) -- 32-Byte-Puffer
*
* I$GetStt/SS_DevNm (Servicewort $8d, Funktionscode $0e, 68k_tech.pdf
* S.557): d0.w = Pfadnummer, d1.w = SS_DevNm, (a0) = 32-Byte-Puffer. d0
* traegt den Pfad schon, d1 den Namenspuffer (nach a0 verschoben).

* Function: _os_gs_devnm
* Reads the device name of an open path into a 32-byte buffer.
* Parameters: d0 path number, d1 32-byte name buffer.
* Returns: OS-9 error code in d0.
_os_gs_devnm:
         movea.l d1,a0                            * Namenspuffer
         move.w  #$0e,d1                          * SS_DevNm-Funktionscode
         trap    #0
         dc.w    Q9I_GetStt
         bcs.s   ogn_err
         moveq   #0,d0
         rts
ogn_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* int _gs_devn(int path, char *name) -- identisch zu _os_gs_devnm, nur
* unter dem Namen, den pd.c dafuer erwartet (zwei Namen fuer denselben
* GetStt-Aufruf, kein eigenes Verhalten).

* Function: _gs_devn
* Reads the device name of an open path into a 32-byte buffer.
* Parameters: d0 path number, d1 32-byte name buffer.
* Returns: OS-9 error code in d0.
_gs_devn:
         movea.l d1,a0
         move.w  #$0e,d1                          * SS_DevNm-Funktionscode
         trap    #0
         dc.w    Q9I_GetStt
         bcs.s   ogd2_err
         moveq   #0,d0
         rts
ogd2_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_gs_pos(path_id path, u_int32 *position)
*
* I$GetStt/SS_Pos (Servicewort $8d, Funktionscode $05, 68k_tech.pdf
* S.563): d0.w = Pfadnummer, d1.w = SS_Pos. Rueckgabe: d2.l = aktuelle
* Dateiposition (ANDERS als SS_DevNm/SS_FD -- kein Puffer, das Ergebnis
* kommt in d2 zurueck).

* Function: _os_gs_pos
* Reads the current file position of an open path.
* Parameters: d0 path number, d1 pointer to the position output.
* Returns: OS-9 error code in d0.
_os_gs_pos:
         movea.l d1,a1                            * &position
         move.w  #$05,d1                          * SS_Pos-Funktionscode
         trap    #0
         dc.w    Q9I_GetStt
         bcs.s   ogpo_err
         move.l  d2,(a1)                          * aktuelle Dateiposition
         moveq   #0,d0
         rts
ogpo_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_gs_size(path_id path, u_int32 *size)
*
* I$GetStt/SS_Size (Servicewort $8d, Funktionscode $02, 68k_tech.pdf
* S.565): d0.w = Pfadnummer, d1.w = SS_Size. Rueckgabe: d2.l = aktuelle
* Dateigroesse -- gleiches Muster wie _os_gs_pos, nur anderer Code.

* Function: _os_gs_size
* Reads the current size of an open file.
* Parameters: d0 path number, d1 pointer to the size output.
* Returns: OS-9 error code in d0.
_os_gs_size:
         movea.l d1,a1                            * &size
         move.w  #$02,d1                          * SS_Size-Funktionscode
         trap    #0
         dc.w    Q9I_GetStt
         bcs.s   ogsz_err
         move.l  d2,(a1)                          * aktuelle Dateigroesse
         moveq   #0,d0
         rts
ogsz_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os9_gs_free(path_id path, u_int32 *free_space)
*
* I$GetStt/SS_Free (Servicewort $8d, Funktionscode $43, 68k_tech.pdf
* S.561): d0.l = Pfadnummer, d1.w = SS_Free. Rueckgabe: d0.l = Freiraum
* in Byte (ANDERS als die uebrigen GetStt-Codes -- hier kommt das
* Ergebnis in d0 zurueck, nicht ueber einen Puffer). d1 wird deshalb vor
* dem Trap auf den Zeiger NICHT mehr gebraucht und kann den Funktionscode
* aufnehmen; der Zeiger wird vorher nach a1 gerettet.

* Function: _os9_gs_free
* Reads the free-space statistic of an open device path.
* Parameters: d0 path number, d1 pointer to the free-space output.
* Returns: OS-9 error code in d0.
_os9_gs_free:
         movea.l d1,a1                            * &free_space
         move.w  #$43,d1                          * SS_Free-Funktionscode
         trap    #0
         dc.w    Q9I_GetStt
         bcs.s   o9f_err
         move.l  d0,(a1)                          * Freiraumgroesse
         moveq   #0,d0
         rts
o9f_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_gs_fd(path_id path, u_int32 size, fd_stats *fdbuf)
*
* I$GetStt/SS_FD (Servicewort $8d, Funktionscode $0f, 68k_tech.pdf
* S.559): d0.w = Pfadnummer, d1.w = SS_FD, d2.w = Byteanzahl (<=
* logische Sektorgroesse), (a0) = Puffer. d0 traegt den Pfad schon, d1
* die gewuenschte Byteanzahl (muss nach d2 wandern, bevor d1 den
* Funktionscode bekommt), der Pufferzeiger steht auf dem Stapel (drittes
* CALLEXT-Argument).
*
* ACHTUNG (touch.c): ruft dies mit size=0 auf -- dann kopiert der Kernel
* laut Dokumentation buchstaeblich null Byte, *fdbuf bleibt bis auf das
* von touch.c selbst gesetzte fd_date unveraendert (Stack-Inhalt). Keine
* Besonderbehandlung hier ergaenzt, da dies kein dokumentiertes
* GetStt-Verhalten waere -- siehe STATUS.md fuer die Einordnung.

* Function: _os_gs_fd
* Reads the file descriptor sector of an open path into a buffer.
* Parameters: d0 path number, d1 byte count, stack argument points to buffer.
* Returns: OS-9 error code in d0.
_os_gs_fd:
         movea.l 4(a7),a0                         * fdbuf-Zeiger vom Stapel
         move.w  d1,d2                            * gewuenschte Byteanzahl nach d2
         move.w  #$0f,d1                          * SS_FD-Funktionscode
         trap    #0
         dc.w    Q9I_GetStt
         bcs.s   ogf_err
         moveq   #0,d0
         rts
ogf_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_ss_fd(path_id path, fd_stats *fdinfo)
*
* I$SetStt/SS_FD (Servicewort $8e, Funktionscode $0f, 68k_tech.pdf
* S.587): d0.w = Pfadnummer, d1.w = SS_FD, (a0) = FD-Sektorabbild. Nur
* FD_ATT, FD_OWN und FD_Creat werden tatsaechlich zurueckgeschrieben (lt.
* Dokumentation), den Zeitstempel (FD_DAT) eingeschlossen ueber
* FD_Creat -- der Pfad muss zum Schreiben geoeffnet sein.

* Function: _os_ss_fd
* Writes back the file descriptor sector of an open path.
* Parameters: d0 path number, d1 FD sector image pointer.
* Returns: OS-9 error code in d0.
_os_ss_fd:
         movea.l d1,a0                            * FD-Sektorabbild
         move.w  #$0f,d1                          * SS_FD-Funktionscode
         trap    #0
         dc.w    Q9I_SetStt
         bcs.s   osf_err
         moveq   #0,d0
         rts
osf_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_seek(path_id path, u_int32 position)
*
* I$Seek (Servicewort $88, 68k_tech.pdf S.576): d0.w = Pfadnummer, d1.l =
* neue Position. Beide CALLEXT-Register stimmen bereits unveraendert mit
* der OS-9-Konvention ueberein, kein Umladen noetig.

* Function: _os_seek
* Repositions the logical file pointer of an open path.
* Parameters: d0 path number, d1 new position.
* Returns: OS-9 error code in d0.
_os_seek:
         trap    #0
         dc.w    Q9I_Seek
         bcs.s   osk_err
         moveq   #0,d0
         rts
osk_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code q9_gblkmp(void *block_map, struct q9_gblkmp_info *info)
*
* F$GBlkMp (Servicewort $19, 68k_tech.pdf S.435-437): d0.l = Anfangs-
* adresse (0 = von vorn berichten), d1.l = Puffergroesse in Byte, (a0) =
* Puffer. Rueckgabe: d0.l = Mindestblockgroesse, d1.l = Fragmentanzahl,
* d2.l = Gesamt-RAM beim Start, d3.l = aktuell freies RAM. Die
* Puffergroesse 1024 ist FEST verdrahtet -- sie passt exakt zu
* mfree.c's "u_int32 block_map[256]" (256 Langworte = 128 Adresse/Groesse-
* Paare) und ist der einzige Aufrufer dieses Wrappers.

* Function: q9_gblkmp
* Copies the system's free-RAM block map and summary counters.
* Parameters: d0 buffer (>=1024 bytes), d1 info struct (4 u_int32 fields).
* Returns: OS-9 error code in d0.
q9_gblkmp:
         movea.l d0,a0                            * Puffer fuer die Fragmentliste
         movea.l d1,a1                            * &info
         moveq   #0,d0                            * ab Adresse 0 berichten
         move.l  #1024,d1                         * Puffergroesse in Byte
         trap    #0
         dc.w    Q9F_GBlkMp
         bcs.s   qgb_err
         move.l  d0,(a1)+                         * minimum_block
         move.l  d1,(a1)+                         * fragments
         move.l  d2,(a1)+                         * total_ram
         move.l  d3,(a1)                          * total_free
         moveq   #0,d0
         rts
qgb_err
         moveq   #0,d0
         move.w  d1,d0
         rts

         ends
