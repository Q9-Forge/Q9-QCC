* perror: write prefix plus the qclib fallback error text to stderr (path 2).
         psect qperror,0,0,0,0,0
perror:
         movea.l d0,a0
         lea pe_buf,a1
         movea.l a1,a2
         moveq #0,d2
pe_copy
         tst.l a0
         beq pe_sep
         move.b (a0)+,d1
         beq pe_sep
         cmpi.l #240,d2
         bge pe_sep
         move.b d1,(a1)+
         addq.l #1,d2
         bra pe_copy
pe_sep
         move.b #':',(a1)+
         move.b #' ',(a1)+
         move.b #'U',(a1)+
         move.b #'n',(a1)+
         move.b #'k',(a1)+
         move.b #'n',(a1)+
         move.b #'o',(a1)+
         move.b #'w',(a1)+
         move.b #'n',(a1)+
         move.b #' ',(a1)+
         move.b #'e',(a1)+
         move.b #'r',(a1)+
         move.b #'r',(a1)+
         move.b #'o',(a1)+
         move.b #'r',(a1)+
         move.b #10,(a1)+
         move.b #0,(a1)
         addi.l #16,d2
         move.l d2,pe_count
         moveq #2,d0
         move.l a2,d1
         pea pe_count
         bsr _os_write
         addq.l #4,a7
         rts
         vsect
pe_buf ds.b 256
pe_count dc.l 0
         ends
