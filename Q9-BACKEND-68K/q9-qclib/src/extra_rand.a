* rand/srand: deterministic 15-bit generator. C leaves the sequence
* implementation-defined; the state is process-local and seedable.
*
* 2026-09-23 (vsect-Adressierungs-Audit nach dem atexit-Fund, `c342e53`):
* rand_state lag in einem separaten "vsect"-Block und wurde als BARE
* absolutes Label referenziert -- dieselbe Signatur wie bei
* extra_atexit.a. Live reproduziert: rand() OHNE vorheriges srand()
* stuerzte ab, weil es vom statischen Initialisierer (dc.l 1) abhaengt.
* Fix nach demselben Muster: das Feld liegt jetzt direkt im psect,
* referenziert ueber PC-relative Adressierung.
         psect qrand,0,0,0,0,0
srand:
         lea rand_state(pc),a0
         move.l d0,(a0)
         rts
rand:
         move.l rand_state(pc),d0
         * xorshift32: avoids 16-bit multiply limitations of the target.
         move.l d0,d1
         lsl.l #8,d1
         lsl.l #5,d1
         eor.l d1,d0
         move.l d0,d1
         lsr.l #8,d1
         lsr.l #8,d1
         lsr.l #1,d1
         eor.l d1,d0
         move.l d0,d1
         lsl.l #5,d1
         eor.l d1,d0
         lea rand_state(pc),a0
         move.l d0,(a0)
         andi.l #$7fff,d0
         rts

         align 4
rand_state: dc.l 1
         ends
