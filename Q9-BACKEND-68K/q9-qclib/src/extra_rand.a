* rand/srand: deterministic 15-bit generator. C leaves the sequence
* implementation-defined; the state is process-local and seedable.
         psect qrand,0,0,0,0,0
srand:
         move.l d0,rand_state
         rts
rand:
         move.l rand_state,d0
         * xorshift32: avoids 16-bit multiply limitations of the target.
         move.l d0,d1
         lsl.l #8,d1
         lsl.l #5,d1
         eor.l d1,d0
         move.l d0,d1
         lsr.l #8,d1
         lsr.l #8,d1
         lsr.l #1,d1
         eor.l d1,d0
         move.l d0,d1
         lsl.l #5,d1
         eor.l d1,d0
         move.l d0,rand_state
         andi.l #$7fff,d0
         rts
         vsect
rand_state dc.l 1
         ends
