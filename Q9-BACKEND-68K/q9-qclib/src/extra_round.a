*
* 2026-09-23 (vsect-Adressierungs-Audit nach dem atexit-Fund, `c342e53`):
* "one" (1.0 als IEEE-754-Bitmuster) lag in einem separaten "vsect"-Block
* und wurde als BARES absolutes Label referenziert -- dieselbe Signatur
* wie bei extra_atexit.a. Fix nach demselben Muster: das Feld liegt jetzt
* direkt im psect, referenziert ueber PC-relative Adressierung.
         psect qround,0,0,0,0,0
floor:
         move.l d1,-(a7)
         move.l d0,-(a7)
         fmove.d (a7)+,fp0
         fmove.d fp0,-(a7)
         fmove.d (a7)+,fp1
         fintrz.x fp0,fp0
         fcmp.x fp1,fp0
         fbeq fr_done
         ftst.x fp1
         fbge fr_done
         lea one(pc),a0
         fmove.d (a0),fp2
         fsub.x fp2,fp0
fr_done
         fmove.d fp0,-(a7)
         move.l (a7)+,d0
         move.l (a7)+,d1
         rts
ceil:
         move.l d1,-(a7)
         move.l d0,-(a7)
         fmove.d (a7)+,fp0
         fmove.d fp0,-(a7)
         fmove.d (a7)+,fp1
         fintrz.x fp0,fp0
         fcmp.x fp1,fp0
         fbeq cr_done
         ftst.x fp1
         fble cr_done
         lea one(pc),a0
         fmove.d (a0),fp2
         fadd.x fp2,fp0
cr_done
         fmove.d fp0,-(a7)
         move.l (a7)+,d0
         move.l (a7)+,d1
         rts

         align 4
one: dc.d 0x3ff00000,0
         ends
