* sqrt: IEEE double in d0:d1, returned in d0:d1. Uses the same 68881
* F-line runtime path as compiler-generated double arithmetic.
         psect qsqrt,0,0,0,0,0
sqrt:
         move.l d1,-(a7)
         move.l d0,-(a7)
         fmove.d (a7)+,fp0
         fsqrt.x fp0,fp0
         fmove.d fp0,-(a7)
         move.l (a7)+,d0
         move.l (a7)+,d1
         rts
         ends
