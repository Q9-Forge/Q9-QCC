* q9-qclib file ABI adapters: fopen, fclose, fread, fwrite, puts, fputc,
* fputs, fgets and ferror.
* Edition history: 2026-09-11  Introduced the English source-header format.
*
* Die Adapter fuer fopen, fclose, fread, fwrite, puts, fputc, fputs,
* fgets und ferror.
*
* WARUM ES SIE BRAUCHT -- zwei gemessene Gruende:
*
* 1. QCC benennt eine DEFINITION "tc_<name>", ein AUFRUF geht aber auf
*    den nackten Namen. Ohne Adapter definierte die Bibliothek
*    "tc_fopen", waehrend die Werkzeuge "fopen" suchen.
*
* 2. Die Konventionen sind verschieden. Der Aufrufer folgt Microwares
*    ABI (d0 = Argument 1, d1 = Argument 2, ab dem dritten auf dem
*    Stack), QCCs eigene Definitionen erwarten dagegen ALLES auf dem
*    Stack -- und zwar in umgekehrter Folge, weil QCC von links nach
*    rechts pusht (slotAddress() rechnet 8 + 4*(nargs-1-slot)).
*
* Statt diese Reihenfolge je Funktion nachzubilden, legt jeder Adapter
* ein ZUSAMMENHAENGENDES Argumentfeld an und uebergibt dessen Adresse --
* dieselbe Bauform wie bei printf, dort schon erprobt. Der C-Rumpf ist
* damit immer "... qf_xxx(int *a)" und liest a[0], a[1], ...
*
* Der Handgriff: d1 wandert auf den Platz der Ruecksprungadresse, d0
* darueber. Damit liegen Argument 1, 2, 3, ... lueckenlos hintereinander,
* denn ab dem dritten stehen sie ohnehin schon dort. Die
* Ruecksprungadresse wird ueber den STACK gerettet, nicht in einem
* Register: welche Register den Aufruf ueberleben, waere eine eigene
* Messung, und diese Fassung braucht sie nicht.
*
* Den Stack raeumt wie ueblich der Aufrufer -- er hat die Argumente ab
* dem dritten selbst abgelegt.

         psect   qfile,0,0,0,0,0

* Ein Adapter je Funktion. Der Rumpf ist bei allen derselbe, nur das
* Sprungziel unterscheidet sich; ein Makro waere kuerzer, aber fuenf
* ausgeschriebene Faelle sind hier leichter zu lesen als eine
* Makroexpansion, die man beim Nachmessen erst wieder aufloesen muss.

* Function: fopen -- opens a file; returns a Q9 FILE handle.
fopen:
         move.l  (a7),a1                 * Ruecksprungadresse merken
         move.l  d1,(a7)                 * Argument 2 an ihren Platz
         move.l  d0,-(a7)                * Argument 1 darueber
         move.l  a1,-(a7)                * Ruecksprungadresse sichern
         pea     4(a7)                   * &args
         bsr     tc_qf_open
         addq.l  #4,a7                   * &args weg
         move.l  (a7)+,a1                * Ruecksprungadresse zurueck
         addq.l  #8,a7                   * Argument 1 und 2 weg
         move.l  a1,-(a7)
         rts

* Function: fclose -- closes a Q9 FILE handle; returns status in d0.
fclose:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_close
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: fread -- reads complete items into the caller buffer.
fread:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_read
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: fwrite -- writes complete items from the caller buffer.
fwrite:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_write
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: puts -- writes a string followed by a newline.
puts:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_puts
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts


* Function: fputc -- writes one character to a selected stream.
fputc:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_putc
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: putc -- functionally identical to fputc (C89 allows either a
* function or a macro; this is the function form).
putc:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_putc
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: putchar -- writes one character to standard output.
putchar:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_putchar
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: fputs -- writes a string without a newline.
fputs:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_puts_f
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts


* Function: fgets -- reads one line into the caller buffer.
fgets:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_gets
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

* Function: ferror -- returns the stream error state.
ferror:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_error
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
	rts

* Function: feof -- returns the stream end-of-file state.
feof:
         move.l  (a7),a1
         move.l  d1,(a7)
         move.l  d0,-(a7)
         move.l  a1,-(a7)
         pea     4(a7)
         bsr     tc_qf_eof_state
         addq.l  #4,a7
         move.l  (a7)+,a1
         addq.l  #8,a7
         move.l  a1,-(a7)
         rts

         ends
