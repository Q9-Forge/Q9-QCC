* memcmp: unsigned-byte comparison, including embedded zero bytes.
* ABI: d0=s1, d1=s2, 4(sp)=unsigned count; preserve d2.
         psect qmemcmp,0,0,0,0,0
memcmp:
         move.l d2,-(a7)
         movea.l d0,a0
         movea.l d1,a1
         move.l 8(a7),d2
         moveq #0,d0
mc_loop
         tst.l d2
         beq mc_done
         moveq #0,d0
         moveq #0,d1
         move.b (a0)+,d0
         move.b (a1)+,d1
         sub.l d1,d0
         bne mc_done
         subq.l #1,d2
         bra mc_loop
mc_done
         move.l (a7)+,d2
         rts
         ends
