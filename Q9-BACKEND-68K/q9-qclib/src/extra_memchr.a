* memchr: search n bytes for (unsigned char)c, including zero.
* d0=buffer, d1=c, 4(sp)=count. Preserve d2.
         psect qmemchr,0,0,0,0,0
memchr:
         move.l d2,-(a7)
         movea.l d0,a0
         move.l 8(a7),d2
         moveq #0,d0
mh_loop
         tst.l d2
         beq mh_done
         cmp.b (a0)+,d1
         beq mh_found
         subq.l #1,d2
         bra mh_loop
mh_found
         move.l a0,d0
         subq.l #1,d0
mh_done
         move.l (a7)+,d2
         rts
         ends
