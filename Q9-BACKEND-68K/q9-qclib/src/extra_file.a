         psect qextra_file,0,0,0,0,0
clearerr:
         move.l (a7),a1
         move.l d1,(a7)
         move.l d0,-(a7)
         move.l a1,-(a7)
         pea 4(a7)
         bsr tc_qf_clearerr
         addq.l #4,a7
         move.l (a7)+,a1
         addq.l #8,a7
         move.l a1,-(a7)
         rts
fflush:
         move.l (a7),a1
         move.l d1,(a7)
         move.l d0,-(a7)
         move.l a1,-(a7)
         pea 4(a7)
         bsr tc_qf_flush
         addq.l #4,a7
         move.l (a7)+,a1
         addq.l #8,a7
         move.l a1,-(a7)
         rts
         ends
