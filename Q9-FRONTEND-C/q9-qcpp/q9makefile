# QCPP targets. qmake reads the shared profile names from Q9-Make.
[global]
TOOLCHAIN_FILE = ../../Q9-Make/toolchains/qmake.conf

help:
	echo "\nqmake: QCPP - Q9 C preprocessor"
	echo "  macCla  build qcpp on macOS with clang"
	echo "  macX64  cross-build Intel macOS qcpp with clang"
	echo "  macXCC  build qcpp on macOS with XCC for Q9/68K"
	echo "  macQCC  build qcpp on macOS with QCC for Q9/68K"
	echo "  q9QCC   build qcpp on Q9/68K with QCC"
	echo "  q9CC    build qcpp on Q9/68K with Microware CC"
	echo "  all     build all qcpp targets for available configurations"
	echo "  test    run qcpp regression tests"
	echo "  clean   clean all qcpp builds\n"

check-sdk:
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }
	test -d "$(Q9SDK)" || { echo "Q9SDK directory does not exist: $(Q9SDK)" >&2; exit 2; }

[ACA]
all: macCla

# Track the real SDK binary so unchanged sources are not rebuilt.
macCla: $(Q9SDK)/macOS/ARM64/CMDS/qcpp

$(Q9SDK)/macOS/ARM64/CMDS/qcpp: check-sdk src/qcpp.c
	mkdir -p "$(Q9SDK)/macOS/ARM64/CMDS" && $(HOST_CC) -std=c89 -O2 -Wall -Wextra -Wno-builtin-requires-header -o "$(Q9SDK)/macOS/ARM64/CMDS/qcpp" src/qcpp.c

test: macCla
	QCPP="$(Q9SDK)/macOS/ARM64/CMDS/qcpp" ./tests/run_tests.sh

clean:
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; rm -f "$(Q9SDK)/macOS/ARM64/CMDS/qcpp"

[ACI]
all: macX64
macX64: $(Q9SDK)/macOS/x86_64/CMDS/qcpp

$(Q9SDK)/macOS/x86_64/CMDS/qcpp: check-sdk src/qcpp.c
	mkdir -p "$(Q9SDK)/macOS/x86_64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -Wno-builtin-requires-header -o "$(Q9SDK)/macOS/x86_64/CMDS/qcpp" src/qcpp.c

clean:
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; rm -f "$(Q9SDK)/macOS/x86_64/CMDS/qcpp"

[AXQ]
all: macXCC

# Track the staged module and build script to avoid rebuilding unchanged input.
macXCC: mac-qcpp-host $(Q9SDK)/Q9/68k/CMDS_XCC/qcpp

# XCC's preprocessing stage invokes the native qcpp from the SDK.
mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp

$(HOST_OUTPUT_DIR)/qcpp: check-sdk src/qcpp.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" src/qcpp.c

$(Q9SDK)/Q9/68k/CMDS_XCC/qcpp: check-sdk src/qcpp.c ../../tools/build_xcc_sdk.sh
	bash ../../tools/build_xcc_sdk.sh qcpp

clean:
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; rm -f "$(Q9SDK)/Q9/68k/CMDS_XCC/qcpp"

[AQQ]
all: macQCC

macQCC: mac-qcpp-host $(HOST_OUTPUT_DIR)/qcc $(Q9SDK)/Q9/68k/CMDS_XQCC/qcpp

# The macOS QCC driver starts qcpp by command name via PATH. Recreate its
# native helper after `clean` before asking QCC to build the 68k target.
mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp

$(HOST_OUTPUT_DIR)/qcpp: check-sdk src/qcpp.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" src/qcpp.c

$(HOST_OUTPUT_DIR)/qcc: ../../Q9-QCC/src/qcc.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" ../../Q9-QCC/src/qcc.c

$(Q9SDK)/Q9/68k/CMDS_XQCC/qcpp: check-sdk src/qcpp.c $(TARGET_CC)
	mkdir -p "$(Q9SDK)/Q9/68k/CMDS_XQCC" && Q9SDK="$(Q9SDK)" PATH="$(HOST_OUTPUT_DIR):$PATH" $(TARGET_CC) --largedata --stack 512K -o "$(Q9SDK)/Q9/68k/CMDS_XQCC/qcpp" src/qcpp.c

clean:
	test -n "$(Q9SDK)" || { echo 'Set Q9SDK to the SDK root first' >&2; exit 2; }; rm -f "$(Q9SDK)/Q9/68k/CMDS_XQCC/qcpp"

[QQQ]
all: q9QCC

q9QCC: /dd/CMDS_QCC/qcpp

/dd/CMDS_QCC/qcpp: src/qcpp.c
	qcc --largedata --stack 512K -o "/dd/CMDS_QCC/qcpp" src/qcpp.c

clean:
	rm -f /dd/CMDS_QCC/qcpp

[QMQ]
MWCC_STATUS = requires a verified ISO-to-K&R converter on Q9

mwcc-status:
	echo 'MWCC build not enabled: iso2kr currently depends on clang-format and is not verified on Q9'
