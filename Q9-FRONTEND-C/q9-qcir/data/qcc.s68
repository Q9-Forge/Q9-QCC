	bne	L36
	cmpi.b	#$65,2(a0)	; 'e'
	bne	L36
	cmpi.b	#$66,3(a0)	; 'f'
	bne	L36
	cmpi.b	#$6D,4(a0)	; 'm'
	bne	L36
	cmpi.b	#$6F,5(a0)	; 'o'
	bne	L36
	cmpi.b	#$64,6(a0)	; 'd'
	bne	L36
	cmpi.b	#$75,7(a0)	; 'u'
	bne	L36
	cmpi.b	#$6C,8(a0)	; 'l'
	bne	L36
	lea	9(a0),a0
	bsr	ws
	cmpi.b	#$45,(a0)	; 'E'
	bne	L36
	cmpi.b	#$4E,1(a0)	; 'N'
	bne	L36
	cmpi.b	#$54,2(a0)	; 'T'
	bne	L36
	cmpi.b	#$52,3(a0)	; 'R'
	bne	L36
	cmpi.b	#$59,4(a0)	; 'Y'
	bne	L36
	move.b	5(a0),d1
	bsr	idch
	tst.b	d0
	bne	L36	; Wortgrenze verletzt
	addq.l	#5,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L36
	bsr	p_defmodulEntryTarget
	tst.b	d0
	beq	L36
	addq.l	#4,a7
	moveq	#1,d0
	rts
L36:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
