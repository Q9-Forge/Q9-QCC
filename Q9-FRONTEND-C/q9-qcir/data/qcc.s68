;---------------------------------------------------------------------------
; Regel: fieldConstKw
p_fieldConstKw:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$63,(a0)	; 'c'
	bne	L75
	cmpi.b	#$6F,1(a0)	; 'o'
	bne	L75
	cmpi.b	#$6E,2(a0)	; 'n'
