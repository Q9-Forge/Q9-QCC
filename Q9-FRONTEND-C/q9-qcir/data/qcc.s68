	cmpi.b	#$44,1(a0)	; 'D'
	bne	L49
	cmpi.b	#$49,2(a0)	; 'I'
	bne	L49
	cmpi.b	#$54,3(a0)	; 'T'
	bne	L49
	cmpi.b	#$49,4(a0)	; 'I'
	bne	L49
	cmpi.b	#$4F,5(a0)	; 'O'
	bne	L49
	cmpi.b	#$4E,6(a0)	; 'N'
