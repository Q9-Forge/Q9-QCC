; Regel: letter (lexikalisch)
p_letter:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	move.b	(a0),d1
	cmpi.b	#$61,d1	; 'a'
	blo	L1075
	cmpi.b	#$7A,d1	; 'z'
	bhi	L1075
	addq.l	#1,a0
	bra	L1074
L1075:	move.l	(a7),a0	; naechste Alternative
	move.b	(a0),d1
	cmpi.b	#$41,d1	; 'A'
	blo	L1076
	cmpi.b	#$5A,d1	; 'Z'
	bhi	L1076
	addq.l	#1,a0
	bra	L1074
L1076:	move.l	(a7),a0	; naechste Alternative
	cmpi.b	#$5F,(a0)	; '_'
	bne	L1077
	addq.l	#1,a0
	bra	L1074
L1077:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L1073
L1074:	addq.l	#4,a7
	addq.l	#4,a7
	moveq	#1,d0
	rts
L1073:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: digit (lexikalisch)
p_digit:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	move.b	(a0),d1
	cmpi.b	#$30,d1	; '0'
	blo	L1078
	cmpi.b	#$39,d1	; '9'
	bhi	L1078
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L1078:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

