	tst.b	d0
	beq	L46
	bra	L44
L46:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L43
L44:	addq.l	#4,a7
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	bsr	p_integerSuffix
	tst.b	d0
	beq	L47
	addq.l	#4,a7
	bra	L48
L47:	move.l	(a7)+,a0	; Option uebersprungen
L48:
	addq.l	#4,a7
	moveq	#1,d0
	rts
L43:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

