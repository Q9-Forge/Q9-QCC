;---------------------------------------------------------------------------
; Automatisch erzeugt von parsec -- NICHT von Hand aendern.
; Backtracking-Parser (rekursiver Abstieg, geordnete Auswahl), 68k/Motorola.
;
; Aufruf:  a0 = ^Eingabe (NUL-terminiert)
;          bsr parse
; Rueckgabe: d0.b = 1 Erfolg (a0 hinter dem Erkannten), 0 Misserfolg
;            (bei Misserfolg ist a0 unveraendert). d1 wird zerstoert.
; Vollstaendige Erkennung: nach Erfolg pruefen, ob (a0) = 0 (Eingabeende).
; LEXER aktiv: parse ueberliest nach Erfolg auch Whitespace am Ende;
; lexikalische Regeln (TOKEN-Abschluss) matchen adjazente Zeichen.
; Startregel: program
;---------------------------------------------------------------------------

parse:	bsr	p_program
	tst.b	d0
	beq	L0
	bsr	ws	; Whitespace am Eingabeende gehoert mit dazu
L0:	rts

;---------------------------------------------------------------------------
; ws -- Whitespace/Kommentare ueberlesen (zerstoert d1)
ws:
L1:	move.b	(a0),d1
	beq	L3	; Eingabeende
	cmpi.b	#$20,d1	; ' '
	beq	L2
	cmpi.b	#$09,d1	; 0x09
	beq	L2
	cmpi.b	#$0D,d1	; 0x0D
	beq	L2
	cmpi.b	#$0A,d1	; 0x0A
	beq	L2
L9:
	cmpi.b	#$2F,(a0)	; '/'
	bne	L10
	cmpi.b	#$2F,1(a0)	; '/'
	bne	L10
	bra	L4
L4:	move.b	(a0),d1	; Kommentar bis Zeilenende
	beq	L3
	cmpi.b	#$0A,d1	; LF
	beq	L1
	addq.l	#1,a0
	bra	L4
L10:
	cmpi.b	#$2F,(a0)	; '/'
	bne	L3
	cmpi.b	#$2A,1(a0)	; '*'
	bne	L3
	addq.l	#2,a0
L11:	move.b	(a0),d1	; im Blockkommentar
	beq	L3	; unterminiert: Eingabeende
	cmpi.b	#$2A,(a0)	; '*'
	bne	L12
	cmpi.b	#$2F,1(a0)	; '/'
	bne	L12
	addq.l	#2,a0
	bra	L1	; Kommentar zu Ende, weiter ueberlesen
L12:	addq.l	#1,a0
	bra	L11
L2:	addq.l	#1,a0
	bra	L1
L3:	rts

;---------------------------------------------------------------------------
; idch -- d1 Identifikator-Zeichen? d0.b = 1/0
idch:
	cmpi.b	#$30,d1	; '0'
	blo	L6
	cmpi.b	#$39,d1	; '9'
	bls	L5
L6:	cmpi.b	#$41,d1	; 'A'
	blo	L7
	cmpi.b	#$5A,d1	; 'Z'
	bls	L5
L7:	cmpi.b	#$61,d1	; 'a'
	blo	L8
	cmpi.b	#$7A,d1	; 'z'
	bls	L5
L8:	cmpi.b	#$5F,d1	; '_'
	beq	L5
	cmpi.b	#$24,d1	; '$'
	beq	L5
	moveq	#0,d0
	rts
L5:	moveq	#1,d0
	rts

;---------------------------------------------------------------------------
; Regel: program
p_program:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
L14:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	bsr	p_globalDecl
	tst.b	d0
	beq	L17
	bra	L16
L17:	move.l	(a7),a0	; naechste Alternative
	bsr	p_structDecl
	tst.b	d0
	beq	L18
	bra	L16
L18:	move.l	(a7),a0	; naechste Alternative
	bsr	p_unionDecl
	tst.b	d0
	beq	L19
	bra	L16
L19:	move.l	(a7),a0	; naechste Alternative
	bsr	p_typedefDecl
	tst.b	d0
	beq	L20
	bra	L16
L20:	move.l	(a7),a0	; naechste Alternative
	bsr	p_enumDecl
	tst.b	d0
	beq	L21
	bra	L16
L21:	move.l	(a7),a0	; naechste Alternative
	bsr	p_externDecl
	tst.b	d0
	beq	L22
	bra	L16
L22:	move.l	(a7),a0	; naechste Alternative
	bsr	p_funcdef
	tst.b	d0
	beq	L23
	bra	L16
L23:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defosDecl
	tst.b	d0
	beq	L24
	bra	L16
L24:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulEntryDecl
	tst.b	d0
	beq	L25
	bra	L16
L25:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulDecl
	tst.b	d0
	beq	L26
	bra	L16
L26:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L15
L16:	addq.l	#4,a7
	addq.l	#4,a7
	bra	L14
L15:	move.l	(a7)+,a0	; Wiederholung beendet
	addq.l	#4,a7
	moveq	#1,d0
	rts
L13:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: defmodulDecl
p_defmodulDecl:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$23,(a0)	; '#'
	bne	L27
	cmpi.b	#$64,1(a0)	; 'd'
	bne	L27
	cmpi.b	#$65,2(a0)	; 'e'
	bne	L27
	cmpi.b	#$66,3(a0)	; 'f'
	bne	L27
	cmpi.b	#$6D,4(a0)	; 'm'
	bne	L27
	cmpi.b	#$6F,5(a0)	; 'o'
	bne	L27
	cmpi.b	#$64,6(a0)	; 'd'
	bne	L27
	cmpi.b	#$75,7(a0)	; 'u'
	bne	L27
	cmpi.b	#$6C,8(a0)	; 'l'
	bne	L27
	lea	9(a0),a0
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	bsr	p_defmodulName
	tst.b	d0
	beq	L29
	bra	L28
L29:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulEdition
	tst.b	d0
	beq	L30
	bra	L28
L30:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulStack
	tst.b	d0
	beq	L31
	bra	L28
L31:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulAttr
	tst.b	d0
	beq	L32
	bra	L28
L32:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulType
	tst.b	d0
	beq	L33
	bra	L28
L33:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulNotImpl
	tst.b	d0
	beq	L34
	bra	L28
L34:	move.l	(a7),a0	; naechste Alternative
	bsr	p_defmodulUnknown
	tst.b	d0
	beq	L35
	bra	L28
L35:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L27
L28:	addq.l	#4,a7
	addq.l	#4,a7
	moveq	#1,d0
	rts
L27:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
