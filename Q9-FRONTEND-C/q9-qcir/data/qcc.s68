	bsr	p_fieldConstKw
	tst.b	d0
	beq	L69
	addq.l	#4,a7
	bra	L70
L69:	move.l	(a7)+,a0	; Option uebersprungen
L70:
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_volatileKw
	tst.b	d0
	beq	L71
	addq.l	#4,a7
	bra	L72
L71:	move.l	(a7)+,a0	; Option uebersprungen
L72:
	bsr	p_type
	tst.b	d0
	beq	L68
