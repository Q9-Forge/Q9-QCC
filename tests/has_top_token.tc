static int has_top_token(const char* s, const char* e, char a, char b) {
    const char* p;
    int round = 0, square = 0;
    char quote = 0;
    for (p = s; p < e; p++) {
        if (quote) {
            if (*p == '\\' && p + 1 < e) { p++; continue; }
            if (*p == quote) quote = 0;
            continue;
        }
        if (*p == '\'' || *p == '"') { quote = *p; continue; }
        if (*p == '(') round++;
        else if (*p == ')') round--;
        else if (*p == '[') square++;
        else if (*p == ']') square--;
        else if (!round && !square && p + 1 < e && p[0] == a && p[1] == b) return 1;
    }
    return 0;
}

int main() { return has_top_token("", "", 0, 0); }
