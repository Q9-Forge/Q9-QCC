FUNC max 2 0
LOADL 0
LOADL 1
CMPGT
JZ L0
LOADL 0
RET
JMP L1
LABEL L0
LABEL L1
LOADL 1
RET
PUSH 0
RET
ENDFUNC
FUNC sum_below 1 0
PUSH 0
STOREL 2
PUSH 0
STOREL 1
LABEL L2
LOADL 1
LOADL 0
CMPLT
JZ L3
LOADL 2
LOADL 1
ADD
STOREL 2
LOADL 1
PUSH 1
ADD
STOREL 1
JMP L2
LABEL L3
LOADL 2
RET
PUSH 0
RET
ENDFUNC
FUNC main 0 0
PUSH 3
PUSH 7
CALL max 2
PRINT
PUSH 5
CALL sum_below 1
PRINT
PUSH 0
RET
PUSH 0
RET
ENDFUNC
OK
