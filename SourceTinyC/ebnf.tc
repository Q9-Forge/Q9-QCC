extern int fputc(int c, void* fp);
extern int sprintf(char* buf, char* fmt, ...);
extern char* strcat(char* dst, char* src);
/* fgets/feof: Zeilenweises Einlesen der .ebnf-Quelldatei bzw. einer alten
   Arbeitsdatei (loadPreservedTests/getAktLine/loadWorkfileAsGrammar). char*
   fgets(char* buf, int size, void* fp) liefert buf bei Erfolg, 0 (NULL) bei
   EOF/Fehler -- exakt wie im echten C. */
extern char* fgets(char* buf, int size, void* fp);
extern int feof(void* fp);
extern void exit(int code);

/* Original-Konstanten (siehe Source/ebnf.cpp) -- als Literale eingesetzt:
     IDENT_LEN=32 (Puffer 33)   FILENAME_LEN=64   IDENTLIST_MAX=1024
     LEXTAB_LEN=1024            MAX_RULES=256      MAX_EDGES=1024
     MAX_RULE_NAMES=256         MAX_TESTS=256      TEST_INPUT_LEN=256
     WORKFILE_LINE=512          USER_CODE_LEN=1048576
     LEXER_CFG_LEN=4096         CGEN_CFG_LEN=4096  LINESTACK_MAX=1024
     CHARBUFFER_LEN=512         QUELLTEXT_BUF_SIZE=65536

   TOKEN_*-Werte (im Original #define, hier als literale Zahlen belassen --
   ein Tiny-C enum wuerde bei 0 beginnen, das Original startet bei 0x80/128,
   daher bewusst KEIN enum hier, um exakte Wertegleichheit mit eventuell
   gespeicherten/verglichenen Rohwerten zu vermeiden -- reine Vorsichtsmassnahme,
   nicht funktional zwingend):
     TOKEN_START=128(0x80) TOKEN_EQUAL=129 TOKEN_SEQ=130 TOKEN_OR=131
     TOKEN_BLOCKON=132 TOKEN_BLOCKOFF=133 TOKEN_OPTIONON=134 TOKEN_OPTIONOFF=135
     TOKEN_REPEATON=136 TOKEN_REPEATOFF=137 TOKEN_IDENT=138 TOKEN_LITERAL=139
     TOKEN_QUOT=140 TOKEN_END=143(0x8F) TOKEN_EXIT=144(0x90) TOKEN_ERROR=145
     TOKEN_RANGE=146

   EOS=0 ('\0') EOL=10 ('\n') EOF_SENTINEL=-1 (siehe Kommentar oben) */

struct TabEntry {
	char ident[33];		/* IDENT_LEN + 1 */
	char* mode;			/* "TS"/"NTS"/"RNG" -- persistente Stringliterale, keine Puffer */
	char TS[33];		/* IDENT_LEN + 1 */
	int trueAction;
	int falseAction;
	int callAddr;
	char rangeLo;
	char rangeHi;
	char ambigF;
};

struct RuleSym {
	char name[33];		/* IDENT_LEN + 1 */
	int addr;
};

struct Edge {
	char from[33];		/* IDENT_LEN + 1 */
	char to[33];
};

struct TestCase {
	char input[256];	/* TEST_INPUT_LEN */
	int expectOk;
};

