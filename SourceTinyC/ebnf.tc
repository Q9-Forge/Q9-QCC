/* Wie emitAndAnd/emitOrOr/emitQMark in codegen.tc (siehe dortiger Kommentar):
   ein Tiny-C-String-Literal kann kein escaptes Anfuehrungszeichen enthalten
   UND keine literale Ein-Zeichen-Zeichenkette "\"" darstellen (der Delimiter
   selbst kann nie Inhalt sein). Das Original haengt an mehreren Stellen genau
   EIN Anfuehrungszeichen an einen Laufzeitpuffer an (z.B. strcat_s(dst, ...,
   "\"")) -- hier stattdessen ein direkter Byte-Schreib-Helfer: haengt ASCII 34
   ('"') ans Ende von buf an (buf muss NUL-terminiert und gross genug sein). */
void appendQuoteChar(char* buf) {
	int n;
	n = strlen(buf);
	buf[n] = 34;
	buf[n + 1] = 0;
}

int isIdentChar(int ch) {
	if (isalnum(ch) != 0 || ch == 95 || ch == 36) {		/* '_'=95 '$'=36 */
		return 1;
	} else {
		return 0;
	}
}

int isFirstIdentChar(int ch) {
	if (isalpha(ch) != 0 || ch == 95 || ch == 36) {
		return 1;
	} else {
		return 0;
	}
}

int isLiteralDelimiter(int ch) {
	if (ch == 34) {		/* '"' */
		return 1;
	} else {
		return 0;
	}
}

/* Zeilenende (\n und ggf. Windows-\r) entfernen -- Arbeitsdateien koennen von
   beiden Plattformen stammen. */
void chompLine(char* line) {
	int len;
	len = strlen(line);
	while (len > 0 && (line[len - 1] == 10 || line[len - 1] == 13)) {
		len = len - 1;
		line[len] = 0;
	}
}

void appendQuelltext(char* text) {
	int len;
	len = strlen(text);
	if (quelltextLen + len < 65535) {		/* QUELLTEXT_BUF_SIZE - 1 */
		memcpy(&quelltextBuf[quelltextLen], text, len);
		quelltextLen = quelltextLen + len;
		quelltextBuf[quelltextLen] = 0;
	}
}

void clearLst() {
	lst[0] = 0;
}

/* Original: strcat_s(lst, ..., " "); strcat_s(lst, ..., str); dann ggf. mit
   Leerzeichen auf "num" Zeichen auffuellen. */
void addLst(char* str, int num) {
	int i;
	int pad;
	strcat(lst, " ");
	strcat(lst, str);
	if (num > 0) {
		pad = num - strlen(str);
		i = 0;
		while (i < pad) {
			strcat(lst, " ");
			i = i + 1;
		}
	}
}

/* Escape-Sequenzen in Literalen dekodieren: \ddd (1-3 Oktalziffern), \t \n \r,
   \\ und \" (alle anderen \x ergeben x). In-place (Original: r/w-Zeiger auf
   demselben Puffer, Ergebnis ist nie laenger als die Eingabe). */
void decodeEscapes(char* s) {
	int r;
	int w;
	int v;
	int n;
	r = 0;
	w = 0;
	while (s[r] != 0) {
		if (s[r] == 92 && s[r + 1] != 0) {		/* '\\'=92 */
			r = r + 1;
			if (s[r] >= 48 && s[r] <= 55) {		/* '0'..'7' */
				v = 0;
				n = 0;
				while (n < 3 && s[r] >= 48 && s[r] <= 55) {
					v = v * 8 + (s[r] - 48);
					r = r + 1;
					n = n + 1;
				}
				s[w] = v;
				w = w + 1;
			} else {
				if (s[r] == 116) { s[w] = 9; }			/* 't' -> \t */
				else if (s[r] == 110) { s[w] = 10; }		/* 'n' -> \n */
				else if (s[r] == 114) { s[w] = 13; }		/* 'r' -> \r */
				else { s[w] = s[r]; }				/* '\\' und '"' und alles andere */
				w = w + 1;
				r = r + 1;
			}
		} else {
			s[w] = s[r];
			w = w + 1;
			r = r + 1;
		}
	}
	s[w] = 0;
}

/* Gegenstueck fuer die Arbeitsdatei: Steuerzeichen und Backslash als \ooo
   enkodieren, damit die zeilenbasierte PARSER-TABELLE robust bleibt. */
void encodeTSField(char* in, char* out, int outMax) {
	int n;
	int i;
	int c;
	n = 0;
	i = 0;
	while (in[i] != 0 && n < outMax - 5) {
		c = in[i];
		if (c < 32 || c == 127 || c == 92) {
			n = n + sprintf(&out[n], "\\%03o", c);
		} else {
			out[n] = in[i];
			n = n + 1;
		}
		i = i + 1;
	}
	out[n] = 0;
}

/* ===========================================================================
   TEIL 3: Tabellendruck, Adressaufloesung, Linksrekursion, Stack-Maschine
=========================================================================== */

/* statString[-stat] aus dem Original (ein durch negative Statuswerte
   indiziertes char[]) wird durch eine if/else-Kette ersetzt -- weder ein
   global initialisiertes "char x[] = \"...\";" noch eine char*-Variable, der
   ein String-Literal zugewiesen wird, ist in dieser Tiny-C-Version bisher
   erprobt (String-Literale werden bislang nur DIREKT als Funktionsargument
   verwendet). Aus demselben Grund werden head0/head1/value0 (das Original
   haelt sie als const char* vor) als Literal an jeder Aufrufstelle wiederholt
   statt zwischengespeichert. STAT_TRUE=-1 STAT_FALSE=-2 STAT_ERROR=-3
   STAT_NEXT=-4 STAT_NONE=-5 (aus ebnf.cpp, hier als Literalzahlen belassen). */
void printLexTab() {
	char trueStr[8];
	char falseStr[8];
	char addrStr[8];
	char identDisp[35];		/* IDENT_LEN + 3 */
	char tsDisp[35];
	int i;
	int stat;

	printf("+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
	printf("| Nr  | Rule                            | Mode| NTS/TS                          | Addr | T  | F  |\n");
	fprintf(fpLst, "+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
	fprintf(fpLst, "| Nr  | Rule                            | Mode| NTS/TS                          | Addr | T  | F  |\n");
	i = 0;
	while (i < aktTabIndex) {
		if (strlen(lexTab[i].ident) != 0) {
			printf("+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
			fprintf(fpLst, "+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
		}
		stat = lexTab[i].trueAction;
		if (stat < 0) {
			if (stat == -1) { trueStr[0] = 84; trueStr[1] = 0; }
			else if (stat == -2) { trueStr[0] = 70; trueStr[1] = 0; }
			else if (stat == -3) { trueStr[0] = 69; trueStr[1] = 0; }
			else if (stat == -4) { trueStr[0] = 78; trueStr[1] = 0; }
			else { trueStr[0] = 45; trueStr[1] = 0; }
		} else {
			sprintf(trueStr, "%d", stat);
		}
		stat = lexTab[i].falseAction;
		if (stat < 0) {
			if (stat == -1) { falseStr[0] = 84; falseStr[1] = 0; }
			else if (stat == -2) { falseStr[0] = 70; falseStr[1] = 0; }
			else if (stat == -3) { falseStr[0] = 69; falseStr[1] = 0; }
			else if (stat == -4) { falseStr[0] = 78; falseStr[1] = 0; }
			else { falseStr[0] = 45; falseStr[1] = 0; }
		} else {
			sprintf(falseStr, "%d", stat);
		}
		if (strcmp(lexTab[i].mode, "NTS") == 0) {
			if (lexTab[i].callAddr >= 0) {
				sprintf(addrStr, "%d", lexTab[i].callAddr);
			} else {
				/* "???" als String-Literal triggert den bekannten "?"-Bug (siehe
				   emitQMark in codegen.tc) -- daher direkte Byte-Zuweisung. */
				addrStr[0] = 63; addrStr[1] = 63; addrStr[2] = 63; addrStr[3] = 0;
			}
		} else {
			sprintf(addrStr, "-");
		}
		if (strlen(lexTab[i].ident) != 0) {
			sprintf(identDisp, "<%s>", lexTab[i].ident);
		} else {
			identDisp[0] = 0;
		}
		if (strcmp(lexTab[i].mode, "NTS") == 0) {
			sprintf(tsDisp, "<%s>", lexTab[i].TS);
		} else {
			tcCopyBounded(tsDisp, lexTab[i].TS, 32);
		}
		printf("| %-4d| %-32s| %-4s| %-32s| %-5s| %-3s| %-3s|\n", i, identDisp, lexTab[i].mode, tsDisp, addrStr, trueStr, falseStr);
		fprintf(fpLst, "| %-4d| %-32s| %-4s| %-32s| %-5s| %-3s| %-3s|\n", i, identDisp, lexTab[i].mode, tsDisp, addrStr, trueStr, falseStr);
		i = i + 1;
	}
	printf("+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
	fprintf(fpLst, "+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
}

void resolveCallAddresses() {
	int i;
	int j;
	int found;

	ruleSymbolCnt = 0;
	i = 0;
	while (i < aktTabIndex) {
		if (strlen(lexTab[i].ident) != 0 && ruleSymbolCnt < 256) {
			tcCopyBounded(ruleSymbols[ruleSymbolCnt].name, lexTab[i].ident, 32);
			ruleSymbols[ruleSymbolCnt].addr = i;
			ruleSymbolCnt = ruleSymbolCnt + 1;
		}
		i = i + 1;
	}

	i = 0;
	while (i < aktTabIndex) {
		if (strcmp(lexTab[i].mode, "NTS") == 0) {
			found = -1;
			j = 0;
			while (j < ruleSymbolCnt) {
				if (strcmp(ruleSymbols[j].name, lexTab[i].TS) == 0) {
					found = ruleSymbols[j].addr;
					break;
				}
				j = j + 1;
			}
			lexTab[i].callAddr = found;
			if (found < 0) {
				printf("FEHLER: Zeile %d referenziert undefinierte Regel '%s'\n", i, lexTab[i].TS);
				errorCnt = errorCnt + 1;
			}
		} else {
			lexTab[i].callAddr = -1;
		}
		i = i + 1;
	}
}

void addRuleNameIfNew(char* name) {
	int i;
	i = 0;
	while (i < ruleNameListCnt) {
		if (strcmp(&ruleNameListFlat[i * 33], name) == 0) { return; }
		i = i + 1;
	}
	if (ruleNameListCnt < 256) {		/* MAX_RULE_NAMES */
		tcCopyBounded(&ruleNameListFlat[ruleNameListCnt * 33], name, 32);
		ruleNameListCnt = ruleNameListCnt + 1;
	}
}

void addFirstEdge(char* from, char* to) {
	if (firstEdgeCnt < 1024) {		/* MAX_EDGES */
		tcCopyBounded(firstEdges[firstEdgeCnt].from, from, 32);
		tcCopyBounded(firstEdges[firstEdgeCnt].to, to, 32);
		firstEdgeCnt = firstEdgeCnt + 1;
	}
}

int findRuleNameIndex(char* name) {
	int i;
	i = 0;
	while (i < ruleNameListCnt) {
		if (strcmp(&ruleNameListFlat[i * 33], name) == 0) { return i; }
		i = i + 1;
	}
	return -1;
}

void printCyclePath(int targetIdx) {
	int i;
	int startPos;
	startPos = 0;
	i = 0;
	while (i < dfsPathLen) {
		if (strcmp(&dfsPathFlat[i * 33], &ruleNameListFlat[targetIdx * 33]) == 0) {
			startPos = i;
			break;
		}
		i = i + 1;
	}
	printf("FEHLER: LINKSREKURSION erkannt: ");
	i = startPos;
	while (i < dfsPathLen) {
		printf("%s -> ", &dfsPathFlat[i * 33]);
		i = i + 1;
	}
	printf("%s\n", &ruleNameListFlat[targetIdx * 33]);
	leftRecursionFound = 1;
}

void dfsVisit(int idx) {
	int i;
	int targetIdx;

	dfsColor[idx] = 1;
	tcCopyBounded(&dfsPathFlat[dfsPathLen * 33], &ruleNameListFlat[idx * 33], 32);
	dfsPathLen = dfsPathLen + 1;

	i = 0;
	while (i < firstEdgeCnt) {
		if (strcmp(firstEdges[i].from, &ruleNameListFlat[idx * 33]) == 0) {
			targetIdx = findRuleNameIndex(firstEdges[i].to);
			if (targetIdx >= 0) {
				if (dfsColor[targetIdx] == 1) {
					printCyclePath(targetIdx);
					errorCnt = errorCnt + 1;
				} else if (dfsColor[targetIdx] == 0) {
					dfsVisit(targetIdx);
				}
			}
		}
		i = i + 1;
	}

	dfsPathLen = dfsPathLen - 1;
	dfsColor[idx] = 2;
}

void checkLeftRecursion() {
	int i;
	i = 0;
	while (i < ruleNameListCnt) {
		dfsColor[i] = 0;
		i = i + 1;
	}
	i = 0;
	while (i < ruleNameListCnt) {
		if (dfsColor[i] == 0) {
			dfsPathLen = 0;
			dfsVisit(i);
		}
		i = i + 1;
	}
}

void extractLiteralText(char* quoted, char* out, int outMax) {
	int len;
	int n;
	len = strlen(quoted);
	n = len - 2;		/* ohne die beiden umschliessenden Anfuehrungszeichen */
	if (n < 0) { n = 0; }
	if (n > outMax - 1) { n = outMax - 1; }
	tcCopyBounded(out, &quoted[1], n);
}

/* Original-Signatur: int execFrom(int startRow, int* pos) -- schreibt die
   neue Position ueber den Out-Parameter zurueck. Hier: "pos" per Wert,
   Ergebnis ueber das globale execPosResult (siehe Kommentar bei dessen
   Deklaration in TEIL 1). "while (true)" statt "while (1)": ein bloser
   Integer-Literal als Bedingung ist nicht erprobt (die Sprache unterscheidet
   strikt int/bool), "true"/"false" sind dagegen echte Schluesselwoerter der
   Tiny-C-Grammatik. */
int execFrom(int startRow, int pos) {
	int row;
	int curPos;
	int matched;
	int next;
	char lit[33];
	int litLen;
	int subPos;

	row = startRow;
	curPos = pos;

	while (true) {
		matched = 0;

		if (strcmp(lexTab[row].mode, "TS") == 0) {
			extractLiteralText(lexTab[row].TS, lit, 33);
			litLen = strlen(lit);
			if (curPos + litLen <= inputLen && strncmp(&inputBuf[curPos], lit, litLen) == 0) {
				matched = 1;
				curPos = curPos + litLen;
			}
		} else if (strcmp(lexTab[row].mode, "RNG") == 0) {
			if (curPos < inputLen && inputBuf[curPos] >= lexTab[row].rangeLo && inputBuf[curPos] <= lexTab[row].rangeHi) {
				matched = 1;
				curPos = curPos + 1;
			}
		} else if (strcmp(lexTab[row].mode, "NTS") == 0) {
			if (lexTab[row].callAddr < 0) {
				printf("LAUFZEITFEHLER: Aufruf einer undefinierten Regel in Zeile %d\n", row);
				return 0;
			}
			subPos = curPos;
			if (execFrom(lexTab[row].callAddr, subPos) != 0) {
				matched = 1;
				curPos = execPosResult;
			} else {
				matched = 0;
			}
		} else {
			printf("LAUFZEITFEHLER: unbekannter Modus '%s' in Zeile %d\n", lexTab[row].mode, row);
			return 0;
		}

		if (matched != 0) { next = lexTab[row].trueAction; } else { next = lexTab[row].falseAction; }

		if (next == -1) {		/* STAT_TRUE */
			execPosResult = curPos;
			return 1;
		}
		if (next == -2 || next == -3) {		/* STAT_FALSE / STAT_ERROR */
			return 0;
		}
		if (next < 0) {
			printf("LAUFZEITFEHLER: unerwarteter Status %d in Zeile %d\n", next, row);
			return 0;
		}
		row = next;
	}
}

/* ===========================================================================
   TEIL 4: Arbeitsdatei (NUTZER-CODE/LEXER/CODEGEN-Rohbloecke, TS-Symboltabelle)
=========================================================================== */

void appendUserCodeLine(char* line) {
	int n;
	n = strlen(line);
	if (userCodeLen + n + 2 >= 1048576) {		/* USER_CODE_LEN */
		userCodeTruncated = 1;
		return;
	}
	memcpy(&userCodeBuf[userCodeLen], line, n);
	userCodeLen = userCodeLen + n;
	userCodeBuf[userCodeLen] = 10;
	userCodeLen = userCodeLen + 1;
	userCodeBuf[userCodeLen] = 0;
}

void appendLexerCfgLine(char* line) {
	int n;
	n = strlen(line);
	if (lexerCfgLen + n + 2 >= 4096) {		/* LEXER_CFG_LEN */
		printf("WARNUNG: [LEXER]-Block groesser als %d Bytes -- Rest ignoriert.\n", 4095);
		return;
	}
	memcpy(&lexerCfgBuf[lexerCfgLen], line, n);
	lexerCfgLen = lexerCfgLen + n;
	lexerCfgBuf[lexerCfgLen] = 10;
	lexerCfgLen = lexerCfgLen + 1;
	lexerCfgBuf[lexerCfgLen] = 0;
}

void appendCgenCfgLine(char* line) {
	int n;
	n = strlen(line);
	if (cgenCfgLen + n + 2 >= 4096) {		/* CGEN_CFG_LEN */
		printf("WARNUNG: [CODEGEN]-Block groesser als %d Bytes -- Rest ignoriert.\n", 4095);
		return;
	}
	memcpy(&cgenCfgBuf[cgenCfgLen], line, n);
	cgenCfgLen = cgenCfgLen + n;
	cgenCfgBuf[cgenCfgLen] = 10;
	cgenCfgLen = cgenCfgLen + 1;
	cgenCfgBuf[cgenCfgLen] = 0;
}

/* Original-Signatur: int tsSymbolIndexOf(char tsList[][IDENT_LEN+1], int tsCnt,
   const char* sym) -- 2D-Array-Parameter geht nicht (Quirk 4), daher flaches
   Array + fest verdrahtete Breite 33 (IDENT_LEN+1), analog ruleNameListFlat. */
int tsSymbolIndexOf(char* tsListFlat, int tsCnt, char* sym) {
	int i;
	i = 0;
	while (i < tsCnt) {
		if (strcmp(&tsListFlat[i * 33], sym) == 0) { return i; }
		i = i + 1;
	}
	return -1;
}

/* Schreibt die komplette Arbeitsdatei. fp muss bereits per "w" geoeffnet sein
   (WICHTIG: erst NACH loadPreservedTests() oeffnen, sonst ist der alte
   TESTS-Block schon weg -- siehe Source/ebnf.cpp:1007-1130).

   Tiny-C-Anpassungen gegenueber dem Original:
   (1) tsList/tsMode: siehe Kommentar bei tsListFlat/tsModeFlat in TEIL 1.
   (2) Jede Stelle, an der das Original ein Anfuehrungszeichen oder eine
       LITERALE Backslash-Buchstabenfolge (als TEXT, nicht als Escape --
       z.B. "\ooo" oder "\t\r\n" in einer Beispielkonfiguration) ausgibt,
       ist umgebaut: ein Anfuehrungszeichen kann nie Teil eines Tiny-C-
       String-Literals sein (Quirk 2, siehe TEIL-1-Kommentar oben) --
       Workaround fputc(34, fp). Eine literale Backslash-Buchstabenfolge ist
       NOCH trickreicher: Tiny-C's eigener String-Literal-Dekoder
       (tcDecodeStringLit, Data/tinyc.lextab) verschluckt JEDEN Backslash
       zusammen mit dem Folgezeichen (wird zu einem Escape-Byte, oder --
       falls das Folgezeichen kein t/n/r/0 ist -- einfach zum blossen
       Folgezeichen OHNE den Backslash). Ein literaler Backslash entkommt
       dem nur, wenn er das LETZTE Zeichen direkt vor dem schliessenden
       Anfuehrungszeichen ist (dann greift die Sonderbehandlung nicht, da
       kein Folgezeichen mehr im selben Literal existiert). Deshalb hier:
       Backslash und Folgebuchstabe in ZWEI GETRENNTEN Aufrufen ausgeben
       (fputc(92, fp), dann ein EIGENES fprintf/fputc fuer den Buchstaben),
       damit beide nie im selben Literal aufeinandertreffen. Die ZWEI echten
       Tab-Zeichen im NUTZER-CODE-Beispieltext unten (einfaches "\t", nicht
       doppelt escaped wie im ebnf.cpp-Original) sind dagegen ECHTE Tabs
       (Einrueckung eines Assembler-Beispiels) -- die brauchen genau die
       normale Escape-Dekodierung, bleiben also direkte "\t"-Literale.
   (3) Ternaere Ausdruecke als fprintf-Argument sind bewusst vermieden:
       eine int-Bedingung braucht ohnehin "!= 0" (Quirk 3), und eine
       char*-Variable, der wechselweise ein Feld ODER ein String-Literal
       zugewiesen wird, ist laut TEIL-3-Kommentar oben unerprobt --
       stattdessen komplette if/else-Zweige mit dupliziertem fprintf-Aufruf
       (String-Literale bleiben so immer direkte Funktionsargumente, der
       einzige bereits erprobte Fall). */
void writeWorkfile(void* fp) {
	int i;
	int tsCnt;
	char enc[72];		/* 2*IDENT_LEN+8 = 2*32+8 */
	int rngLo;
	int rngHi;

	tsCnt = 0;

	fprintf(fp, "#================================================================================\n");
	fprintf(fp, "# EBNF-ARBEITSDATEI -- automatisch erzeugt von ebnf\n");
	fprintf(fp, "# Die Bloecke [TESTS] und [NUTZER-CODE] sind zum Editieren gedacht und bleiben\n");
	fprintf(fp, "# beim Neu-Erzeugen erhalten. NUTZER-CODE ist vorbereitet, wird aber noch nicht\n");
	fprintf(fp, "# in C/68k eingebunden (Format/Architektur: docs/ARCHITEKTUR.md).\n");
	fprintf(fp, "# Existiert <basis>.ebnf, ist IMMER die .ebnf die Wahrheit; ohne .ebnf\n");
	fprintf(fp, "# kann diese Datei direkt als Grammatik geladen werden (PARSER-TABELLE-Block).\n");
	fprintf(fp, "#================================================================================\n\n");

	/* Block 1: EBNF-QUELLTEXT (waehrend des Parsens von rule() mitgeschrieben) */
	fprintf(fp, "[EBNF-QUELLTEXT]\n");
	fprintf(fp, "%s", quelltextBuf);
	if (quelltextLen > 0 && quelltextBuf[quelltextLen - 1] != 10) {		/* EOL */
		fprintf(fp, "\n");
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 2: TS-SYMBOLTABELLE (distinkte Terminale, Reihenfolge = erstes Vorkommen) */
	i = 0;
	while (i < aktTabIndex) {
		if ((strcmp(lexTab[i].mode, "TS") == 0 || strcmp(lexTab[i].mode, "RNG") == 0)
			&& tsSymbolIndexOf(tsListFlat, tsCnt, lexTab[i].TS) < 0 && tsCnt < 1024) {
			tcCopyBounded(&tsListFlat[tsCnt * 33], lexTab[i].TS, 32);
			tcCopyBounded(&tsModeFlat[tsCnt * 4], lexTab[i].mode, 3);
			tsCnt = tsCnt + 1;
		}
		i = i + 1;
	}
	fprintf(fp, "[TS-SYMBOLTABELLE]\n");
	fprintf(fp, "# nr  typ  symbol\n");
	i = 0;
	while (i < tsCnt) {
		encodeTSField(&tsListFlat[i * 33], enc, 72);
		fprintf(fp, "%-4d %-4s %s\n", i, &tsModeFlat[i * 4], enc);
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 3: NTS-SYMBOLTABELLE (= ruleSymbols: Regelname + Startzeile) */
	fprintf(fp, "[NTS-SYMBOLTABELLE]\n");
	fprintf(fp, "# nr  startzeile  name\n");
	i = 0;
	while (i < ruleSymbolCnt) {
		fprintf(fp, "%-4d %-11d %s\n", i, ruleSymbols[i].addr, ruleSymbols[i].name);
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 4: PARSER-TABELLE (Integer-Werte 1:1 wie intern, symbol = Rest der Zeile) */
	fprintf(fp, "[PARSER-TABELLE]\n");
	fprintf(fp, "# zeile true false addr rngLo rngHi regel modus symbol\n");
	fprintf(fp, "# (symbol: Steuerzeichen/Backslash als ");
	fputc(92, fp);
	fprintf(fp, "ooo enkodiert -- Zeilenformat!)\n");
	i = 0;
	while (i < aktTabIndex) {
		encodeTSField(lexTab[i].TS, enc, 72);
		if (strcmp(lexTab[i].mode, "RNG") == 0) {
			rngLo = (int) lexTab[i].rangeLo;
			rngHi = (int) lexTab[i].rangeHi;
		} else {
			rngLo = 0;
			rngHi = 0;
		}
		/* Auf ZWEI fprintf-Aufrufe aufgeteilt: der CALLEXT-Mechanismus fuer
		   variadische extern-Aufrufe erlaubt max. 8 Stack-Argumente (siehe
		   Kommentar oben) -- neun Werte in einem Aufruf (i/true/false/addr/
		   rngLo/rngHi/ident/mode/enc) ueberschreiten das. */
		fprintf(fp, "%-5d %-5d %-5d %-5d %-5d %-5d ",
			i, lexTab[i].trueAction, lexTab[i].falseAction, lexTab[i].callAddr, rngLo, rngHi);
		if (strlen(lexTab[i].ident) != 0) {
			fprintf(fp, "%-16s %-4s %s\n", lexTab[i].ident, lexTab[i].mode, enc);
		} else {
			fprintf(fp, "%-16s %-4s %s\n", "-", lexTab[i].mode, enc);
		}
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 5: TESTS (aus der alten Arbeitsdatei gerettet, unveraendert zurueckschreiben) */
	fprintf(fp, "[TESTS]\n");
	fprintf(fp, "# TEST ");
	fputc(34, fp);
	fprintf(fp, "<eingabe>");
	fputc(34, fp);
	fprintf(fp, " OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt\n");
	i = 0;
	while (i < testCaseCnt) {
		fprintf(fp, "TEST ");
		fputc(34, fp);
		fprintf(fp, "%s", testCases[i].input);
		fputc(34, fp);
		if (testCases[i].expectOk != 0) {
			fprintf(fp, " OK\n");
		} else {
			fprintf(fp, " FAIL\n");
		}
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n");

	/* Block 6: LEXER-Konfiguration (roh erhalten; siehe codegen.tc lexParseConfig) */
	fprintf(fp, "\n[LEXER]\n");
	if (lexerCfgLen == 0) {
		fprintf(fp, "# Optional: aktiviert Whitespace-/Kommentar-Behandlung im ERZEUGTEN Parser.\n");
		fprintf(fp, "# WHITESPACE = ");
		fputc(34, fp);
		fprintf(fp, " ");
		fputc(92, fp); fprintf(fp, "t");
		fputc(92, fp); fprintf(fp, "r");
		fputc(92, fp); fprintf(fp, "n");
		fputc(34, fp);
		fprintf(fp, "\n");
		fprintf(fp, "# TOKEN ident            (Regel wird lexikalisch: Zeichen muessen adjazent sein)\n");
		fprintf(fp, "# COMMENT LINE = ");
		fputc(34, fp); fprintf(fp, "//"); fputc(34, fp);
		fprintf(fp, "\n");
		fprintf(fp, "# COMMENT BLOCK = ");
		fputc(34, fp); fprintf(fp, "(*"); fputc(34, fp);
		fprintf(fp, " ");
		fputc(34, fp); fprintf(fp, "*)"); fputc(34, fp);
		fprintf(fp, "          (NESTED vor '=' erlaubt Schachtelung)\n");
	} else {
		fprintf(fp, "%s", lexerCfgBuf);
	}
	fprintf(fp, "[ENDE]\n");

	/* Block 6b: CODEGEN-Optionen (roh erhalten, geparst von cgenParseConfig()) */
	fprintf(fp, "\n[CODEGEN]\n");
	if (cgenCfgLen == 0) {
		fprintf(fp, "# Optional: Ausgabe-Optionen der Codegenerierung.\n");
		fprintf(fp, "# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)\n");
		fprintf(fp, "# M68K PSECT = name      (psect-Name, Default: <basisname>_p)\n");
	} else {
		fprintf(fp, "%s", cgenCfgBuf);
	}
	fprintf(fp, "[ENDE]\n");

	/* Block 7: NUTZER-CODE. Bleibt absichtlich roh (siehe Original-Kommentar). */
	fprintf(fp, "\n[NUTZER-CODE]\n");
	if (userCodeLen == 0) {
		fprintf(fp, "# Semantische Aktionen (siehe docs/ARCHITEKTUR.md, Abschnitt 9). Beispiel:\n");
		fprintf(fp, "# ACTION AFTER <regel> CALL <name>\n");
		fprintf(fp, "# ROUTINE C <name>\n");
		fprintf(fp, "# void <name>(const char* start, const char* end) { /* ... */ }\n");
		fprintf(fp, "# END\n");
		fprintf(fp, "# ROUTINE M68K <name>\n");
		fprintf(fp, "# <name>:\t; a0 = Ende des erkannten Textes, MUSS erhalten bleiben\n");
		fprintf(fp, "#\trts\n");
		fprintf(fp, "# END\n");
	} else {
		fprintf(fp, "%s", userCodeBuf);
		if (userCodeTruncated != 0) {
			fprintf(fp, "# WARNUNG: Eingabe war groesser als %d Bytes.\n", 1048575);		/* USER_CODE_LEN - 1 */
		}
	}
	fprintf(fp, "[ENDE]\n");
}

/* Fall B: Kanten fuer die Linksrekursions-Pruefung aus der GELADENEN Tabelle
   rekonstruieren (Source/ebnf.cpp:1132-1156) -- Gegenstueck zur normalen
   Ermittlung waehrend des Parsens (ueber das firstPos-Flag). Idee: ein
   Fehlschlag konsumiert nie Eingabe -- alles, was vom Regelstart aus NUR ueber
   falseAction-Kanten erreichbar ist, liegt an "erster Position" der Regel.
   Jede NTS-Zeile auf diesem Weg ergibt eine Kante Regel->Zielregel. Original
   nutzt C++s "for"/"continue" -- hier wie im Rest der Datei per while
   umgesetzt (kein continue: der Trailing-Increment "r = r + 1" muesste sonst
   VOR jedem continue wiederholt werden -- die if-umschlossene Form vermeidet
   dieses Fussangel-Risiko vollstaendig). */
void rebuildFirstEdgesFromTable() {
	int r;
	int row;
	int i;

	firstEdgeCnt = 0;
	ruleNameListCnt = 0;
	r = 0;
	while (r < aktTabIndex) {
		if (strlen(lexTab[r].ident) != 0) {
			addRuleNameIfNew(lexTab[r].ident);
			i = 0;
			while (i < aktTabIndex) {
				rebuildVisited[i] = 0;
				i = i + 1;
			}
			row = r;
			while (row >= 0 && row < aktTabIndex && rebuildVisited[row] == 0) {
				rebuildVisited[row] = 1;
				if (strcmp(lexTab[row].mode, "NTS") == 0) {
					addFirstEdge(lexTab[r].ident, lexTab[row].TS);
				}
				row = lexTab[row].falseAction;
			}
		}
		r = r + 1;
	}
}

/* Handparser-Helfer fuer loadWorkfileAsGrammar() (statt sscanf): das Original
   liest die PARSER-TABELLE-Zeile mit EINEM grossen sscanf("%d %d %d %d %d %d
   %32s %7s %n", ...) -- neun Ausgabeparameter (sechs int*, zwei char*, ein
   int* fuer die Consumed-Position via %n) in EINEM Aufruf. Das geht hier aus
   ZWEI Gruenden nicht 1:1: (1) CALLEXT erlaubt max. 8 Stack-Argumente (siehe
   writeWorkfile-Kommentar), neun ueberschreiten das. (2) int*-Ausgabeparameter
   mit "*p = wert"-Schreibzugriff sind in dieser Tiny-C-Version generell
   unerprobt (siehe execPosResult-Kommentar, execFrom) -- sscanf wuerde genau
   das brauchen. Stattdessen ein simpler Handparser mit der globalen
   Parse-Position wfParsePos (TEIL 1), passend zum Zeilenformat aus
   writeWorkfile ("%-5d ... %-16s %-4s %s\n" -- sechs space-gepolsterte
   Ganzzahlen, ein "%-Ns"-Feld ist beim Zurueckparsen einfach "Text bis zum
   naechsten Leerzeichen", der Rest der Zeile bleibt unangetastet). */
void wfSkipSpaces(char* line) {
	while (line[wfParsePos] == 32) { wfParsePos = wfParsePos + 1; }		/* ' ' */
}

int wfParseInt(char* line) {
	int neg;
	int v;
	wfSkipSpaces(line);
	neg = 0;
	if (line[wfParsePos] == 45) { neg = 1; wfParsePos = wfParsePos + 1; }		/* '-' */
	v = 0;
	while (line[wfParsePos] >= 48 && line[wfParsePos] <= 57) {		/* '0'..'9' */
		v = v * 10 + (line[wfParsePos] - 48);
		wfParsePos = wfParsePos + 1;
	}
	if (neg != 0) { v = 0 - v; }
	return v;
}

void wfParseToken(char* line, char* out, int outMax) {
	int n;
	wfSkipSpaces(line);
	n = 0;
	while (line[wfParsePos] != 0 && line[wfParsePos] != 32 && n < outMax - 1) {
		out[n] = line[wfParsePos];
		n = n + 1;
		wfParsePos = wfParsePos + 1;
	}
	out[n] = 0;
}

/* Fall B: PARSER-TABELLE- und EBNF-QUELLTEXT-Block direkt aus der Arbeitsdatei
   laden (keine .ebnf vorhanden), Source/ebnf.cpp:1162-1231. Liefert 1 bei
   Erfolg, 0 wenn die Datei keine Arbeitsdatei im neuen Format ist (kein
   [PARSER-TABELLE]-Block gefunden) oder nicht lesbar war. blk als einfacher
   int statt des anonymen lokalen enums im Original (0=NONE 1=QUELLTEXT
   2=PARSERTAB 3=SONST) -- anonyme lokale enums sind in dieser Tiny-C-Version
   bisher nirgends erprobt, ein einfacher int mit Kommentar ist das etablierte
   Muster (siehe STAT_TRUE/STAT_FALSE/... in printLexTab). */
int loadWorkfileAsGrammar(char* path) {
	void* fp;
	char line[512];		/* WORKFILE_LINE */
	int blk;
	int rowsLoaded;
	int nr;
	int tA;
	int fA;
	int addr;
	int lo;
	int hi;
	char identBuf[33];
	char modeBuf[8];

	blk = 0;
	rowsLoaded = 0;

	fp = fopen(path, "r");
	if (fp == 0) { return 0; }

	aktTabIndex = 0;
	quelltextLen = 0;
	quelltextBuf[0] = 0;

	while (fgets(line, 512, fp) != 0) {
		chompLine(line);
		if (line[0] == 91) {		/* '[' */
			if (strncmp(line, "[EBNF-QUELLTEXT]", 16) == 0) { blk = 1; }
			else if (strncmp(line, "[PARSER-TABELLE]", 16) == 0) { blk = 2; }
			else { blk = 3; }
			continue;
		}
		if (blk == 1) {
			appendQuelltext(line);
			appendQuelltext("\n");
		} else if (blk == 2) {
			if (line[0] != 35 && line[0] != 0 && aktTabIndex < 1024) {		/* '#' / EOS / LEXTAB_LEN */
				wfParsePos = 0;
				nr = wfParseInt(line);
				tA = wfParseInt(line);
				fA = wfParseInt(line);
				addr = wfParseInt(line);
				lo = wfParseInt(line);
				hi = wfParseInt(line);
				wfParseToken(line, identBuf, 33);
				wfParseToken(line, modeBuf, 8);
				wfSkipSpaces(line);

				if (strcmp(modeBuf, "TS") == 0 || strcmp(modeBuf, "NTS") == 0 || strcmp(modeBuf, "RNG") == 0) {
					if (strcmp(identBuf, "-") == 0) {
						/* "lexTab[aktTabIndex].ident[0] = 0;" (arr[i].field[j] als
						   Zuweisungsziel) wird vom Frontend abgelehnt -- stattdessen
						   ueber das bereits erprobte tcCopyBounded einen leeren
						   Puffer schreiben (identisch zum "-"-Fall anderswo im Code). */
						tcCopyBounded(lexTab[aktTabIndex].ident, "", 32);
					} else {
						tcCopyBounded(lexTab[aktTabIndex].ident, identBuf, 32);
					}
					if (strcmp(modeBuf, "TS") == 0) { lexTab[aktTabIndex].mode = "TS"; }
					else if (strcmp(modeBuf, "NTS") == 0) { lexTab[aktTabIndex].mode = "NTS"; }
					else { lexTab[aktTabIndex].mode = "RNG"; }
					lexTab[aktTabIndex].trueAction = tA;
					lexTab[aktTabIndex].falseAction = fA;
					lexTab[aktTabIndex].callAddr = addr;
					lexTab[aktTabIndex].rangeLo = (char) lo;
					lexTab[aktTabIndex].rangeHi = (char) hi;
					lexTab[aktTabIndex].ambigF = 0;
					tcCopyBounded(lexTab[aktTabIndex].TS, &line[wfParsePos], 32);
					decodeEscapes(lexTab[aktTabIndex].TS);
					aktTabIndex = aktTabIndex + 1;
					rowsLoaded = rowsLoaded + 1;
				} else {
					printf("FEHLER: Arbeitsdatei Zeile %d: unbekannter Modus '%s'\n", nr, modeBuf);
					errorCnt = errorCnt + 1;
				}
			}
		}
	}
	fclose(fp);

	if (rowsLoaded == 0) {
		/* "?" als reiner Text in einem String-Literal triggert den bekannten
		   "conditional-frame mismatch"-Bug (Quirk 15) -- daher ohne Fragezeichen
		   umformuliert. */
		printf("FEHLER: '%s' enthaelt keinen [PARSER-TABELLE]-Block (vermutlich eine alte CSV-Datei)\n", path);
		return 0;
	}
	return 1;
}

/* Alle TEST-Zeilen durch die Stack-Maschine jagen und mit dem erwarteten
   Ergebnis vergleichen (Source/ebnf.cpp:1233-1268). Liefert die Anzahl der
   MISMATCHes (0 = alles gruen). Original ruft execFrom(0, &pos) mit
   int*-Ausgabeparameter -- unser bereits portiertes execFrom (TEIL 3) nimmt
   "pos" per Wert und liefert die neue Position ueber das globale
   execPosResult (siehe dortiger Kommentar), daher hier execFrom(0, 0) plus
   anschliessendem execPosResult-Read statt eines lokalen "pos". Ternaere
   OK/FAIL-Textwahl als Funktionsargument bewusst vermieden (siehe
   writeWorkfile-Kommentar) -- komplette if/else-Zweige stattdessen.
   Anfuehrungszeichen um den Testeingabe-Text: Builtin putchar(34) (PRINTC)
   statt eines String-Literal-Workarounds, da das Ziel hier STDOUT ist
   (printf), nicht ein FILE*-Strom wie bei writeWorkfile (dort fputc(34, fp)). */
int runTests() {
	int i;
	int mismatches;
	int ok;
	int fullOk;
	int passCount;

	mismatches = 0;

	if (testCaseCnt == 0) {
		return 0;
	}
	printf("\n=== TESTS (%d Testfaelle) ===\n", testCaseCnt);
	if (leftRecursionFound != 0 || errorCnt > 0) {
		if (leftRecursionFound != 0) {
			printf("uebersprungen: Grammatik ist linksrekursiv\n");
		} else {
			printf("uebersprungen: Grammatik ist fehlerhaft\n");
		}
		return 0;
	}
	i = 0;
	while (i < testCaseCnt) {
		inputBuf = testCases[i].input;
		inputLen = strlen(inputBuf);
		ok = execFrom(0, 0);
		if (ok != 0 && execPosResult == inputLen) {
			fullOk = 1;
		} else {
			fullOk = 0;
		}
		if (fullOk == testCases[i].expectOk) {
			printf("PASS      TEST ");
			putchar(34);
			printf("%s", testCases[i].input);
			putchar(34);
			if (testCases[i].expectOk != 0) {
				printf(" OK\n");
			} else {
				printf(" FAIL\n");
			}
		} else {
			printf("MISMATCH  TEST ");
			putchar(34);
			printf("%s", testCases[i].input);
			putchar(34);
			printf(" erwartet ");
			if (testCases[i].expectOk != 0) { printf("OK"); } else { printf("FAIL"); }
			printf(", erhalten ");
			if (fullOk != 0) { printf("OK"); } else { printf("FAIL"); }
			if (ok != 0 && fullOk == 0) {
				printf(" (nur %d von %d Zeichen erkannt)", execPosResult, inputLen);
			}
			printf("\n");
			mismatches = mismatches + 1;
		}
		i = i + 1;
	}
	passCount = testCaseCnt - mismatches;
	if (mismatches != 0) {
		printf("=== %d/%d PASS, MISMATCHES! ===\n", passCount, testCaseCnt);
	} else {
		printf("=== %d/%d PASS ===\n", passCount, testCaseCnt);
	}
	return mismatches;
}

/* TESTS/NUTZER-CODE/LEXER/CODEGEN-Bloecke aus einer ALTEN Arbeitsdatei retten,
   BEVOR sie durch writeWorkfile ueberschrieben wird (Source/ebnf.cpp:920-993).
   Keine escapten Anfuehrungszeichen im Code selbst noetig -- nur die
   GELESENEN Daten (Zeilen aus einer bestehenden Datei) enthalten '"', das
   ist Laufzeittext, kein Tiny-C-String-Literal-Problem. Zwei Anpassungen:
   (1) char-Literal '"' -> ASCII-Code 34 (Quirk 1). (2)
   "testCases[testCaseCnt].input[n] = 0;" (arr[i].field[j] als Zuweisungsziel)
   wird wie bei loadWorkfileAsGrammar abgelehnt -- Umweg ueber einen lokalen
   Puffer tmpInput, NUL-Terminierung dort (normale Array-Indizierung, kein
   struct-Array-Feld), danach per tcCopyBounded in testCases[...].input
   kopiert. Bool-Ausdruecke (strncmp(...)==0, strstr(...)==0) werden NICHT
   direkt einer int-Variable/einem int-Feld zugewiesen (dieselbe strikte
   int/bool-Trennung wie bei Quirk 3/10) -- komplette if/else-Zweige. */
void loadPreservedTests(char* path) {
	void* fp;
	char line[512];		/* WORKFILE_LINE */
	int inTests;
	int inUserCode;
	int inLexer;
	int inCgen;
	char* firstQuote;
	char* lastQuote;
	int n;
	char tmpInput[256];		/* TEST_INPUT_LEN */

	inTests = 0;
	inUserCode = 0;
	inLexer = 0;
	inCgen = 0;

	testCaseCnt = 0;
	userCodeLen = 0;
	userCodeTruncated = 0;
	userCodeBuf[0] = 0;
	lexerCfgLen = 0;
	lexerCfgBuf[0] = 0;
	cgenCfgLen = 0;
	cgenCfgBuf[0] = 0;

	fp = fopen(path, "r");
	if (fp == 0) { return; }		/* keine alte Arbeitsdatei vorhanden -- nichts zu retten */

	while (fgets(line, 512, fp) != 0) {
		chompLine(line);
		if (inUserCode != 0) {
			if (strcmp(line, "[ENDE]") == 0) {
				inUserCode = 0;
			} else {
				appendUserCodeLine(line);
			}
			continue;
		}
		if (inLexer != 0) {
			if (strcmp(line, "[ENDE]") == 0) {
				inLexer = 0;
			} else {
				appendLexerCfgLine(line);
			}
			continue;
		}
		if (inCgen != 0) {
			if (strcmp(line, "[ENDE]") == 0) {
				inCgen = 0;
			} else {
				appendCgenCfgLine(line);
			}
			continue;
		}
		if (line[0] == 91) {		/* '[' */
			if (strncmp(line, "[TESTS]", 7) == 0) { inTests = 1; } else { inTests = 0; }
			if (strncmp(line, "[NUTZER-CODE]", 13) == 0) { inUserCode = 1; } else { inUserCode = 0; }
			if (strncmp(line, "[LEXER]", 7) == 0) { inLexer = 1; } else { inLexer = 0; }
			if (strncmp(line, "[CODEGEN]", 9) == 0) { inCgen = 1; } else { inCgen = 0; }
			continue;
		}
		if (inTests != 0 && strncmp(line, "TEST", 4) == 0) {
			firstQuote = strchr(line, 34);		/* '"' */
			lastQuote = strrchr(line, 34);
			if (firstQuote != 0 && lastQuote != 0 && lastQuote > firstQuote && testCaseCnt < 256) {
				n = lastQuote - firstQuote - 1;
				if (n > 255) { n = 255; }		/* TEST_INPUT_LEN - 1 */
				memcpy(tmpInput, firstQuote + 1, n);
				tmpInput[n] = 0;
				tcCopyBounded(testCases[testCaseCnt].input, tmpInput, 255);
				if (strstr(lastQuote + 1, "FAIL") == 0) {
					testCases[testCaseCnt].expectOk = 1;
				} else {
					testCases[testCaseCnt].expectOk = 0;
				}
				testCaseCnt = testCaseCnt + 1;
			}
		}
	}
	fclose(fp);
	if (userCodeTruncated != 0) {
		printf("WARNUNG: [NUTZER-CODE] ist groesser als %d Bytes und wurde gekuerzt.\n", 1048575);		/* USER_CODE_LEN - 1 */
	}
}

/* ===========================================================================
   TEIL 5: Rekursive-Abstiegs-Parsergruppe (Source/ebnf.cpp:920-1774, 1279-1330)
   -- literal/ident/block/repeat/option/factor/term/expression/rule rufen sich
   gegenseitig; die bare Prototypen dafuer stehen bereits oben in TEIL 2 (siehe
   Kommentar dort). Reihenfolge unten: alles, was NOCH KEINE Vorwaertsdeklaration
   hat (push/pop/restart/errorMsg/test/addIdentList/patchLocalTrue/
   patchLocalFalse), MUSS vor seiner ersten Verwendung stehen -- die neun
   bereits vorwaertsdeklarierten Funktionen selbst koennen sich weiterhin in
   beliebiger Reihenfolge gegenseitig aufrufen.

   TOKEN_*-Werte als Literalzahlen (siehe TEIL-1-Kommentar): IDENT=138
   LITERAL=139 BLOCKON=132 BLOCKOFF=133 OPTIONON=134 OPTIONOFF=135 REPEATON=136
   REPEATOFF=137 SEQ=130 OR=131 EQUAL=129 END=143 RANGE=146.
   STAT_TRUE=-1 STAT_FALSE=-2 STAT_ERROR=-3 (wie bereits in execFrom/TEIL 3). */

/* Im Original nur ein auskommentierter Rumpf (totes Feature, identList/
   identListCnt werden nirgends sonst benutzt) -- hier bewusst als echtes
   No-op portiert statt der ungenutzten Globalen. */
void addIdentList() {
}

void push(int line) {
	if (lineStackIndex < 1024) {		/* LINESTACK_MAX */
		lineStack[lineStackIndex] = line;
		lineStackIndex = lineStackIndex + 1;
	} else {
		printf("LEX_ERROR >>> Stack Overflow");
	}
}

int pop() {
	if (lineStackIndex > 0) {
		lineStackIndex = lineStackIndex - 1;
		return lineStack[lineStackIndex];
	} else {
		printf("LEX_ERROR >>> Stack underflow");
		return -1;
	}
}

int restart() {
	int i;
	i = 0;
	while (restartToken[i] != 0) {
		if (aktToken == restartToken[i]) {
			return 1;
		}
		i = i + 1;
	}
	return 0;
}

void errorMsg(char* msg) {
	printf("<< %s erwartet. >>", msg);
	errorCnt = errorCnt + 1;
	while (restart() == 0) {
		lexikalischeAnalyse();
	}
}

void test(int checkTS, char* msg) {
	if (aktToken != checkTS) {
		errorMsg(msg);
	} else {
		lexikalischeAnalyse();
	}
}

/* Nachbearbeitung fuer block()/repeat()/option(): siehe ausfuehrlicher
   Original-Kommentar in Source/ebnf.cpp bei patchLocalTrue/patchLocalFalse. */
void patchLocalTrue(int fromRow, int toRowExclusive, int target) {
	int i;
	i = fromRow;
	while (i < toRowExclusive) {
		if (lexTab[i].trueAction == -1 || lexTab[i].trueAction >= toRowExclusive) {		/* STAT_TRUE */
			lexTab[i].trueAction = target;
		}
		i = i + 1;
	}
}

void patchLocalFalse(int fromRow, int toRowExclusive, int target) {
	int i;
	i = fromRow;
	while (i < toRowExclusive) {
		if (lexTab[i].falseAction == -2) {		/* STAT_FALSE */
			if (target >= 0 && lexTab[i].ambigF != 0 && ambigFalseWarned == 0) {
				/* Auf zwei printf-Aufrufe aufgeteilt: eine einzelne Tiny-C-
				   String-Literal-Konstante ist auf 256 Bytes begrenzt
				   (tcDecodeStringLit), der komplette Text ueberschreitet das. */
				printf("WARNUNG: Regel '%s': Pflicht-Faktor nach ueberspringbarer Gruppe ([..]/{..})\n         vor einer Alternative/umschliessenden Gruppe: konsumiert die Gruppe\n", currentDefRule);
				printf("         Eingabe und der Faktor schlaegt fehl, wird die Position NICHT\n         zurueckgesetzt (moeglicher Fehlakzept). Grammatik ggf. umformen.\n");
				ambigFalseWarned = 1;
			}
			lexTab[i].falseAction = target;
		}
		i = i + 1;
	}
}

void block() {
	int blockStart;
	blockStart = aktTabIndex;

	addLst("(", 0);
	lexikalischeAnalyse();
	expression();
	test(133, "BLOCKOFF Symbol )");		/* TOKEN_BLOCKOFF */
	addLst(")", 0);
	firstPos = 0;

	patchLocalTrue(blockStart, aktTabIndex, aktTabIndex);
	lastFactorWasComplex = 1;
	lastFactorSkippable = 0;
}

void repeat() {
	int repStart;
	int savedFirstPos;
	repStart = aktTabIndex;
	savedFirstPos = firstPos;

	addLst("{", 0);
	lexikalischeAnalyse();
	expression();
	test(137, "REPEATOFF Symbol }");		/* TOKEN_REPEATOFF */
	addLst("}", 0);
	firstPos = savedFirstPos;

	patchLocalTrue(repStart, aktTabIndex, repStart);
	patchLocalFalse(repStart, aktTabIndex, aktTabIndex);
	lastFactorWasComplex = 1;
	lastFactorSkippable = 1;
	astWrapRep();
}

void option() {
	int optStart;
	int savedFirstPos;
	optStart = aktTabIndex;
	savedFirstPos = firstPos;

	addLst("[", 0);
	lexikalischeAnalyse();
	expression();
	test(135, "OPTIONOFF Symbol ]");		/* TOKEN_OPTIONOFF */
	addLst("]", 0);
	firstPos = savedFirstPos;

	patchLocalTrue(optStart, aktTabIndex, aktTabIndex);
	patchLocalFalse(optStart, aktTabIndex, aktTabIndex);
	lastFactorWasComplex = 1;
	lastFactorSkippable = 1;
	astWrapOpt();
}

void ident() {
	char bracketedName[35];		/* IDENT_LEN + 3 */

	if (firstPos != 0) {
		addFirstEdge(currentDefRule, aktName);
	}
	firstPos = 0;
	lastFactorWasComplex = 0;
	lastFactorSkippable = 0;
	astPushNTS(aktName);
	sprintf(bracketedName, "<%s>", aktName);		/* Listing zeigt NTS immer als <name> */
	addLst(bracketedName, 0);
	put();
	lexikalischeAnalyse();
}

/* Anfuehrungszeichen um Roh-/Dekodierwert im Listing (lst) UND im TS-Feld
   koennen nicht als String-Literal geschrieben werden (Quirk 2) -- ueber
   appendQuoteChar (bereits vorhanden) byteweise angehaengt. Das TS-Feld selbst
   wird zusaetzlich NICHT direkt beschrieben (strcpy_s(lexTab[...].TS, ..., "\"")
   im Original waere hier wieder das arr[i].field[j]-Zuweisungsziel-Problem,
   siehe loadWorkfileAsGrammar) -- stattdessen in einem lokalen Puffer tsBuf
   aufgebaut und per tcCopyBounded uebernommen (gleiches Muster durchgehend
   fuer .ident weiter unten). */
void literal() {
	char loChar[33];		/* IDENT_LEN + 1 */
	char loRaw[33];
	char hiChar[33];
	char hiRaw[33];
	char tsBuf[35];

	firstPos = 0;
	lastFactorWasComplex = 0;
	lastFactorSkippable = 0;
	tcCopyBounded(loRaw, aktString, 32);		/* Original-Schreibweise fuers Listing */
	tcCopyBounded(loChar, aktString, 32);
	decodeEscapes(loChar);				/* dekodiert fuer Tabelle + AST */
	lexikalischeAnalyse();		/* ein Token vorausschauen: folgt ein '~' Bereichs-Operator? */

	if (aktToken == 146) {		/* TOKEN_RANGE */
		lexikalischeAnalyse();		/* '~' konsumieren */
		if (aktToken != 139) {		/* TOKEN_LITERAL */
			errorMsg("LITERAL nach '~' (Zeichenbereich) erwartet");
			return;
		}
		tcCopyBounded(hiRaw, aktString, 32);
		tcCopyBounded(hiChar, aktString, 32);
		decodeEscapes(hiChar);

		astPushRNG(loChar[0], hiChar[0]);
		strcat(lst, " ");
		appendQuoteChar(lst);
		strcat(lst, loRaw);
		appendQuoteChar(lst);
		strcat(lst, "~");
		appendQuoteChar(lst);
		strcat(lst, hiRaw);
		appendQuoteChar(lst);

		if (errorCnt == 0) {
			if (strlen(aktRule) != 0) {
				tcCopyBounded(lexTab[aktTabIndex].ident, aktRule, 32);
				aktRule[0] = 0;
			} else {
				tcCopyBounded(lexTab[aktTabIndex].ident, "", 32);
			}
			lexTab[aktTabIndex].mode = "RNG";
			lexTab[aktTabIndex].rangeLo = loChar[0];
			lexTab[aktTabIndex].rangeHi = hiChar[0];
			tsBuf[0] = 0;
			appendQuoteChar(tsBuf);
			strcat(tsBuf, loChar);
			appendQuoteChar(tsBuf);
			strcat(tsBuf, "~");
			appendQuoteChar(tsBuf);
			strcat(tsBuf, hiChar);
			appendQuoteChar(tsBuf);
			tcCopyBounded(lexTab[aktTabIndex].TS, tsBuf, 32);
		}
		lexikalischeAnalyse();		/* weiter zum Token nach dem zweiten Literal */
	} else {
		astPushTS(loChar);
		strcat(lst, " ");
		appendQuoteChar(lst);
		strcat(lst, loRaw);
		appendQuoteChar(lst);

		if (errorCnt == 0) {
			if (strlen(aktRule) != 0) {
				tcCopyBounded(lexTab[aktTabIndex].ident, aktRule, 32);
				aktRule[0] = 0;
			} else {
				tcCopyBounded(lexTab[aktTabIndex].ident, "", 32);
			}
			lexTab[aktTabIndex].mode = "TS";
			tsBuf[0] = 0;
			appendQuoteChar(tsBuf);
			strcat(tsBuf, loChar);
			appendQuoteChar(tsBuf);
			tcCopyBounded(lexTab[aktTabIndex].TS, tsBuf, 32);
		}
		/* aktToken zeigt bereits auf das naechste Token (s.o. vorausgeschaut) --
		   hier KEIN weiteres lexikalischeAnalyse() mehr aufrufen! */
	}
}

void factor() {
	switch (aktToken) {
	case 138:		/* TOKEN_IDENT */
		ident();
		aktTabIndex = aktTabIndex + 1;
		break;
	case 132:		/* TOKEN_BLOCKON */
		block();
		break;
	case 136:		/* TOKEN_REPEATON */
		repeat();
		break;
	case 134:		/* TOKEN_OPTIONON */
		option();
		break;
	case 139:		/* TOKEN_LITERAL */
		literal();
		aktTabIndex = aktTabIndex + 1;
		break;
	default:
		errorMsg("IDENT or BLOCK or REPEAT or OPTION or LITERAL");
	}
}

void term() {
	int last;
	int firstFactorComplex;
	int committed;
	int hadSkippable;
	int factorStart;
	int wasAmbig;
	int i;
	int astM;

	last = 0;
	committed = 0;
	hadSkippable = 0;
	astM = astMark();		/* AST: alle Faktoren dieser Sequenz sammeln */

	if (aktToken == 143) {		/* TOKEN_END */
		return;
	}

	push(aktTabIndex);
	factor();
	firstFactorComplex = lastFactorWasComplex;		/* NUR direkt nach dem ERSTEN Faktor auswerten */
	if (lastFactorSkippable != 0) { hadSkippable = 1; } else { committed = 1; }

	while (aktToken == 138 || aktToken == 139 || aktToken == 132 || aktToken == 136 || aktToken == 134 || aktToken == 130) {
		if (committed == 0 && hadSkippable != 0) { wasAmbig = 1; } else { wasAmbig = 0; }
		lexTab[aktTabIndex].trueAction = aktTabIndex + 1;
		if (committed != 0) { lexTab[aktTabIndex].falseAction = -3; } else { lexTab[aktTabIndex].falseAction = -2; }		/* STAT_ERROR / STAT_FALSE */

		if (aktToken == 130) {		/* TOKEN_SEQ */
			lexikalischeAnalyse();
		}
		if (aktToken == 138 || aktToken == 139 || aktToken == 132 || aktToken == 136 || aktToken == 134) {
			factorStart = aktTabIndex;
			factor();
			if (committed != 0) {
				patchLocalFalse(factorStart, aktTabIndex, -3);		/* STAT_ERROR */
			} else if (wasAmbig != 0) {
				i = factorStart;
				while (i < aktTabIndex) {
					if (lexTab[i].falseAction == -2) {		/* STAT_FALSE */
						lexTab[i].ambigF = 1;
					}
					i = i + 1;
				}
			}
			if (lastFactorSkippable != 0) { hadSkippable = 1; } else { committed = 1; }
		}
	}
	if (lineStackIndex > 0) {
		last = pop();
		if (firstFactorComplex == 0) {
			lexTab[last].trueAction = last + 1;
			lexTab[last].falseAction = -2;		/* STAT_FALSE */
		}
	}
	astGroupSeq(astM);
}

void expression() {
	int entryFirstPos;
	int altStart;
	int astM;
	int poppedLine;

	entryFirstPos = firstPos;		/* jede Alternative beginnt an derselben "ersten Position" */
	altStart = aktTabIndex;		/* Startzeile DER AKTUELLEN Alternative */
	astM = astMark();			/* AST: alle Alternativen dieser Auswahl sammeln */

	push(aktTabIndex);
	term();

	while (aktToken == 131) {		/* TOKEN_OR */
		patchLocalTrue(altStart, aktTabIndex, -1);		/* STAT_TRUE */
		patchLocalFalse(altStart, aktTabIndex, aktTabIndex);

		if (expressionCount == 0) {
			addLst("\n", 34);
		}
		addLst("|", 0);
		lexikalischeAnalyse();
		expressionCount = expressionCount + 1;
		firstPos = entryFirstPos;
		altStart = aktTabIndex;
		term();
		expressionCount = expressionCount - 1;
	}
	if (lineStackIndex > 0) {
		poppedLine = pop();
	}
	astGroupAlt(astM);
}

void rule() {
	char bracketedName[35];		/* IDENT_LEN + 3 */
	int ruleStart;
	int i;

	ruleStart = aktTabIndex;

	clearLst();
	test(138, "IDENT ident ");		/* TOKEN_IDENT */
	addIdentList();
	sprintf(bracketedName, "<%s>", aktName);		/* Listing zeigt NTS immer als <name> */
	addLst(bracketedName, 32);
	tcCopyBounded(aktRule, aktName, 32);
	tcCopyBounded(currentDefRule, aktName, 32);
	addRuleNameIfNew(currentDefRule);
	firstPos = 1;
	ambigFalseWarned = 0;
	test(129, "EQUAL Symbol =");		/* TOKEN_EQUAL */
	addLst("=", 0);
	expression();
	if (aktToken == 143) {		/* TOKEN_END */
		put();
		test(143, "END Symbol .");		/* TOKEN_END */

		/* UEBER DIE GANZE REGEL scannen, nicht nur die letzte Zeile: ein {..}/[..]/(..)
		   als LETZTES Konstrukt der Regel patcht seine eigene falseAction/trueAction
		   (Schleifen-/Gruppen-Ende) auf "aktTabIndex zum Zeitpunkt des Patches" --
		   steht danach nichts mehr in DIESER Regel, zeigt das faelschlich auf die
		   naechste Regel (Zeilennummern sind fortlaufend ueber alle Regeln hinweg). */
		i = ruleStart;
		while (i < aktTabIndex) {
			if (lexTab[i].trueAction >= aktTabIndex) {
				lexTab[i].trueAction = -1;		/* STAT_TRUE */
			}
			if (lexTab[i].falseAction >= aktTabIndex) {
				lexTab[i].falseAction = -1;		/* STAT_TRUE */
			}
			i = i + 1;
		}

		addLst(".", 0);
		printf("%s\n\n", lst);
		fprintf(fpLst, "%s\n\n", lst);
		appendQuelltext(lst);
		appendQuelltext("\n\n");
	}
	astFinishRule(currentDefRule);
}

/* ===========================================================================
   TEIL 6: Lexer (Source/ebnf.cpp:1810-2147, 1906-1970) -- lexikalischeAnalyse/
   getAktChar sind bereits seit Projektbeginn bare-vorwaertsdeklariert
   (TEIL 2); getNext/comment/getAktLine/put/semantischeAnylyse teils ebenfalls
   (put/semantischeAnylyse ja, getNext/comment NEIN -- daher strikte
   Reihenfolge unten: comment() vor getAktLine() (ruft es auf), getNext() vor
   getAktChar() (ruft es auf).

   initLexer(): das C++-Original initialisiert flagStartLineComment/
   startLineCommentString/... etc. per GLOBALEM Initialisierer bei
   Programmstart (automatisch, VOR main()). Tiny-C globale Variablen haben
   dafuer keine Entsprechung (GLOBAL <name> [init] deckt nur einfache
   Zahlenwerte ab, keine String-Pointer) -- deshalb hier eine explizite
   Init-Funktion, die von ebnfSyntax()/main() (naechster, letzter Schritt)
   EINMAL zu Programmbeginn aufgerufen werden MUSS, bevor irgendeine
   Lexer-Funktion benutzt wird. */
void initLexer() {
	flagEOF = 0;
	flagStartLineComment = 1;
	startLineCommentString = "#";
	flagRestLineComment = 1;
	restLineCommendString = "//";
	flagBlockComment = 1;
	flagBlockCommentActive = 0;
	startBlockCommandString = "/*";
	endBlockCommandString = "*/";
	lineCnt = 0;
	charLen = 0;
}

/* Rohes Zeiger-Dereferenzieren (*index lesen UND *index = wert schreiben,
   nicht nur p[i]) wird hier zum ERSTEN Mal im Port gebraucht -- eigens per
   Standalone-Test gegen TinyVM verifiziert (Lesen+Schreiben ueber einen
   Pointer auf ein globales char-Array, Ergebnis exakt wie erwartet), bevor
   es hier grossflaechig eingesetzt wird. strcpy (ohne "_s"/Laengenlimit,
   siehe strcat/sprintf-Praezedenzfaelle) neu extern deklariert (TEIL 1). */
char* comment() {
	char* index;
	char* indexEnd;
	int len;

	if (flagBlockCommentActive != 0) {
		if (flagBlockComment != 0) {
			index = strstr(sourceBuffer, endBlockCommandString);
			if (index != 0) {
				strcpy(sourceBuffer, index + strlen(endBlockCommandString));
				charLen = strlen(sourceBuffer);
				flagBlockCommentActive = 0;
			} else {
				sourceBuffer[0] = 0;
				charLen = 0;
			}
		}
	} else {
		if (flagBlockComment != 0 && strlen(startBlockCommandString) > 0 && strlen(endBlockCommandString) > 0) {
			index = strstr(sourceBuffer, startBlockCommandString);
			if (index != 0) {
				indexEnd = strstr(sourceBuffer, endBlockCommandString);
				if (indexEnd != 0) {
					len = strlen(endBlockCommandString);
					indexEnd = indexEnd + len;
					strcpy(index, indexEnd);
					charLen = strlen(sourceBuffer);
				} else {
					*index = 0;
					charLen = strlen(sourceBuffer);
					flagBlockCommentActive = 1;
				}
			}
		}
	}

	/* Kommentar bis Zeilenende NUR wenn das Kommentarzeichen das ERSTE
	   Nicht-Leerzeichen der Zeile ist (siehe Original-Kommentar). */
	if (flagStartLineComment != 0 && strlen(startLineCommentString) > 0) {
		index = sourceBuffer;
		while (*index == 32 || *index == 9) {		/* ' ' '\t' */
			index = index + 1;
		}
		if (strncmp(index, startLineCommentString, strlen(startLineCommentString)) == 0) {
			sourceBuffer[0] = 0;
			charLen = 0;
		}
	}

	if (flagRestLineComment != 0 && strlen(restLineCommendString) > 0) {
		index = strstr(sourceBuffer, restLineCommendString);
		if (index != 0) {
			*index = 0;
			charLen = strlen(sourceBuffer);
		}
	}
	return sourceBuffer;
}

char* getAktLine() {
	while (charLen == 0 && feof(fpIn) == 0) {
		lineCnt = lineCnt + 1;
		readPtr = fgets(sourceBuffer, 512, fpIn);		/* CHARBUFFER_LEN */
		if (readPtr != 0) {
			charLen = strlen(sourceBuffer);
			comment();
		} else {
			charLen = 0;
			break;
		}
	}
	if (charLen == 0 && feof(fpIn) != 0) {
		printf("EOF\n");
		flagEOF = 1;
		sourceBuffer[0] = 0;
		readPtr = sourceBuffer;
	} else if (charLen == 0 && feof(fpIn) == 0) {
		printf("LINE %-3d %s Scanner read Error, \n", lineCnt, sourceBuffer);
		sourceBuffer[0] = 10;		/* EOL */
		readPtr = sourceBuffer;
	} else if (charLen > 0) {
		readPtr = sourceBuffer;
	}
	return readPtr;
}

int getNext() {
	if (charLen > 0) {
		lastChar = aktChar;
		aktChar = *sourcePtr;
		sourcePtr = sourcePtr + 1;
		nextChar = *sourcePtr;
		charLen = charLen - 1;
		return aktChar;
	} else {
		if (flagEOF != 0) {
			lastChar = aktChar;
			aktChar = -1;		/* EOF */
			nextChar = -1;
			return aktChar;
		} else {
			sourcePtr = getAktLine();
			lastChar = aktChar;
			aktChar = *sourcePtr;
			sourcePtr = sourcePtr + 1;
			nextChar = *sourcePtr;
			charLen = charLen - 1;
			return aktChar;
		}
	}
}

int getAktChar() {
	if (flagEOF != 0 || aktChar == -1) {		/* EOF */
		return -1;
	}
	aktChar = getNext();
	if (isspace(aktChar) != 0) {
		while (isspace(nextChar) != 0) {
			aktChar = getNext();
		}
		aktChar = 32;		/* ' ' */
	}
	if (aktChar < 32 || aktChar > 127) {
		aktChar = 63;		/* '?' */
	}
	return aktChar;
}

void semantischeAnylyse() {
	char tsBuf[35];
	switch (aktToken) {
	case 138:		/* TOKEN_IDENT */
		if (strlen(aktRule) != 0) {
			tcCopyBounded(lexTab[aktTabIndex].ident, aktRule, 32);
			aktRule[0] = 0;
		} else {
			tcCopyBounded(lexTab[aktTabIndex].ident, "", 32);
		}
		lexTab[aktTabIndex].mode = "NTS";
		tcCopyBounded(lexTab[aktTabIndex].TS, aktName, 32);
		break;
	case 139:		/* TOKEN_LITERAL */
		if (strlen(aktRule) != 0) {
			tcCopyBounded(lexTab[aktTabIndex].ident, aktRule, 32);
			aktRule[0] = 0;
		} else {
			tcCopyBounded(lexTab[aktTabIndex].ident, "", 32);
		}
		lexTab[aktTabIndex].mode = "TS";
		tsBuf[0] = 0;
		appendQuoteChar(tsBuf);
		strcat(tsBuf, aktString);
		appendQuoteChar(tsBuf);
		tcCopyBounded(lexTab[aktTabIndex].TS, tsBuf, 32);
		break;
	case 128: case 129: case 130: case 131:
	case 132: case 133: case 134: case 135:
	case 136: case 137: case 140: case 143:
		/* TOKEN_START/EQUAL/SEQ/OR/BLOCKON/BLOCKOFF/OPTIONON/OPTIONOFF/
		   REPEATON/REPEATOFF/QUOT/END */
		break;
	case 144:		/* TOKEN_EXIT */
		resolveCallAddresses();
		checkLeftRecursion();
		printLexTab();
		tableReady = 1;
		break;
	case 145:		/* TOKEN_ERROR */
		break;
	default:
		break;
	}
}

void put() {
	if (errorCnt == 0) {
		semantischeAnylyse();
	}
}

void lexikalischeAnalyse() {
	int index;
	index = 0;

	/* ignore spaces */
	while (isspace(aktChar) != 0 && aktChar != -1) {		/* EOF */
		getAktChar();
	}
	if (aktChar == -1) {		/* EOF */
		lastToken = aktToken;
		aktToken = 144;		/* TOKEN_EXIT */
		return;
	}
	if (isFirstIdentChar(aktChar) != 0) {
		aktName[index] = aktChar;
		index = index + 1;
		getAktChar();
		tcCopyBounded(lastName, aktName, 32);
		while (isIdentChar(aktChar) != 0) {
			if (index < 32) {		/* IDENT_LEN */
				aktName[index] = aktChar;
				index = index + 1;
			}
			getAktChar();
		}
		aktName[index] = 0;
		lastToken = aktToken;
		aktToken = 138;		/* TOKEN_IDENT */
	} else if (aktChar == 60) {		/* '<' -- alternative NTS-Schreibweise <name> */
		getAktChar();
		while (isIdentChar(aktChar) != 0) {
			if (index < 32) {		/* IDENT_LEN */
				aktName[index] = aktChar;
				index = index + 1;
			}
			getAktChar();
		}
		aktName[index] = 0;
		if (aktChar == 62) {		/* '>' */
			getAktChar();
		} else {
			printf("LEX_ERROR: '>' nach <%s erwartet\n", aktName);
		}
		lastToken = aktToken;
		aktToken = 138;		/* TOKEN_IDENT */
	} else if (isLiteralDelimiter(aktChar) != 0) {
		getAktChar();
		tcCopyBounded(lastString, aktString, 32);
		while (aktChar != 34 || lastChar == 92) {		/* solange NICHT ('"' UND lastChar != '\') */
			if (index < 32) {		/* IDENT_LEN */
				aktString[index] = aktChar;
				index = index + 1;
			}
			getAktChar();
		}
		aktString[index] = 0;
		getAktChar();
		lastToken = aktToken;
		aktToken = 139;		/* TOKEN_LITERAL */
	} else {
		if (flagEOF != 0) {
			lastToken = aktToken;
			aktToken = 144;		/* TOKEN_EXIT */
		} else {
			lastToken = aktToken;
			if (aktChar == 61) { aktToken = 129; }			/* '=' TOKEN_EQUAL */
			else if (aktChar == 44) { aktToken = 130; }		/* ',' TOKEN_SEQ */
			else if (aktChar == 124) { aktToken = 131; }		/* '|' TOKEN_OR */
			else if (aktChar == 34) { aktToken = 140; }		/* '"' TOKEN_QUOT */
			else if (aktChar == 40) { aktToken = 132; }		/* '(' TOKEN_BLOCKON */
			else if (aktChar == 41) { aktToken = 133; }		/* ')' TOKEN_BLOCKOFF */
			else if (aktChar == 91) { aktToken = 134; }		/* '[' TOKEN_OPTIONON */
			else if (aktChar == 93) { aktToken = 135; }		/* ']' TOKEN_OPTIONOFF */
			else if (aktChar == 123) { aktToken = 136; }		/* '{' TOKEN_REPEATON */
			else if (aktChar == 125) { aktToken = 137; }		/* '}' TOKEN_REPEATOFF */
			else if (aktChar == 59) { aktToken = 143; }		/* ';' TOKEN_END */
			else if (aktChar == 46) { aktToken = 143; }		/* '.' TOKEN_END */
			else if (aktChar == 126) { aktToken = 146; }		/* '~' TOKEN_RANGE (bewusst nicht "-") */
			else if (aktChar == -1) { aktToken = 144; }		/* EOF TOKEN_EXIT */
			else {
				aktToken = 145;		/* TOKEN_ERROR */
				printf("LEX_ERROR: flasches Zeichen <%c>\n", aktChar);
			}
		}
		getAktChar();
	}
}

/* ===========================================================================
   TEIL 7: Programmstart (Source/ebnf.cpp:170-334, 1357-1369) -- LETZTER
   Abschnitt des ebnf.cpp-Vollports. exitProgram/ebnfSyntax haben bereits
   bare Prototypen (TEIL 2); ebnfMain ist neu und wird von main() gerufen
   (unten). Danach sollte ein voller l68-Link von ebnf.tc gegen codegen.tc
   ohne unresolved Symbole durchlaufen -- siehe [[tinyc-vollport-status]]. */

void exitProgram(int exitCode) {
	/* fflush(stdout) im Original bewusst weggelassen: exit() flusht/schliesst
	   laut C-Standard ohnehin alle offenen Streams automatisch beim Beenden,
	   und ein stdout-FILE*-Handle ist ueber die Microware-ABI nicht ohne
	   Weiteres als einfacher Tiny-C-Wert zu bekommen (keine simple
	   "stdout"-Externvariable, siehe clib.l-_iob-Layout). */
	if (fpIn != 0) { fclose(fpIn); }
	if (fpOut != 0) { fclose(fpOut); }
	if (fpLst != 0) { fclose(fpLst); }
	exit(exitCode);
}

void ebnfSyntax() {
	restartToken[0] = 143;		/* TOKEN_END */
	restartToken[1] = 144;		/* TOKEN_EXIT */
	restartToken[2] = 0;		/* EOS */

	getAktChar();
	lexikalischeAnalyse();
	while (aktToken != 144) {		/* TOKEN_EXIT */
		rule();
	}
	put();
}

/* Ersatz fuer das Original-main(argc, argv): Tiny-C main() kann KEINE
   Kommandozeilenargumente empfangen -- tc_start ruft main() ohne jedes
   Argument auf (siehe emitCall()/tc_start in Source/tinyc_backend_c.cpp,
   kein argc/argv-Mechanismus irgendwo in Grammatik oder Backend). Die
   komplette Original-Logik lebt deshalb hier in einer eigenen, mit dem
   Basisnamen PARAMETRISIERTEN Funktion -- main() selbst wird weiter unten
   zu einem duennen, klar markierten Platzhalter-Wrapper.

   Bewusst entfallen (kein argv[0]/argc mehr vorhanden): die "usage:
   %s <inputfile> ..."-Meldungen (inkl. des argc<2-Frueh-Checks, der bei
   einem Funktionsparameter nie zutreffen kann) UND der optionale dritte
   CLI-Parameter <teststring> (manueller Testlauf gegen EINEN Eingabestring,
   Original-Zeilen 288-315) -- runTests() (der TESTS-Block der Arbeitsdatei)
   deckt den eigentlichen Testmechanismus bereits ab. */
void ebnfMain(char* baseArg) {
	char inputFileName[70];		/* FILENAME_LEN + 6 */
	char outputFileName[72];		/* FILENAME_LEN + 8 */
	char listFileName[72];
	char cgenCName[72];
	char cgen68kName[72];
	char cgenOS9Name[72];
	char* base;
	char* slash;

	int fileRet;
	int fallB;
	int len;

	fallB = 0;

	/* 2026-07-26, live auf Q9 gefunden: initLexer() war definiert, aber NIRGENDS
	   aufgerufen -- flagStartLineComment/startLineCommentString/... etc. blieben
	   dadurch auf undefiniertem BSS-Inhalt statt den in initLexer() gesetzten
	   Werten, comment()/getNext() riefen frueh strlen() auf einem ungueltigen
	   Zeiger auf (echter PMMU-Absturz). Muss VOR jeder Lexer-Nutzung UND vor
	   jedem strlen(baseArg) direkt darunter stehen -- siehe initLexer()-
	   Kommentar oben, der genau das schon lange forderte. */
	initLexer();

	len = strlen(baseArg);
	if (len > 64) { len = 64; }		/* FILENAME_LEN */
	tcCopyBounded(inputFileName, baseArg, len);
	strcat(inputFileName, ".ebnf");
	tcCopyBounded(outputFileName, baseArg, len);
	strcat(outputFileName, ".lextab");
	tcCopyBounded(listFileName, baseArg, len);
	strcat(listFileName, ".lexlst");
	tcCopyBounded(cgenCName, baseArg, len);
	strcat(cgenCName, "_p.c");
	tcCopyBounded(cgen68kName, baseArg, len);
	strcat(cgen68kName, ".s68");

	printf("EBNF Translator on OS-9/68k\n");
	astReset();

	/* WICHTIG (Reihenfolge!): den TESTS-Block der alten Arbeitsdatei retten,
	   BEVOR sie spaeter per "w" geoeffnet und damit geleert wird. */
	loadPreservedTests(outputFileName);

	fpIn = fopen(inputFileName, "r");
	if (fpIn == 0) { fileRet = 1; } else { fileRet = 0; }
	if (fileRet != 0) {
		/* Fall B: keine .ebnf-Quelle -- die Arbeitsdatei selbst ist die
		   Grammatik-Quelle. */
		fallB = 1;
		printf("Hinweis: '%s' nicht gefunden -- lade Grammatik aus Arbeitsdatei '%s'\n", inputFileName, outputFileName);
		if (loadWorkfileAsGrammar(outputFileName) == 0) {
			printf("    error: weder '%s' noch eine Arbeitsdatei '%s' lesbar\n", inputFileName, outputFileName);
			exitProgram(-2);
		}
	}

	fpLst = fopen(listFileName, "w");
	if (fpLst == 0) { fileRet = 1; } else { fileRet = 0; }
	if (fileRet != 0) {
		printf("    error: can't open list file: %s", listFileName);
		exitProgram(-2);
	}

	if (fallB != 0) {
		/* Fall A erledigt all das innerhalb von ebnfSyntax()/semantischeAnylyse() */
		resolveCallAddresses();
		rebuildFirstEdgesFromTable();
		checkLeftRecursion();
		printf("%s", quelltextBuf);
		fprintf(fpLst, "%s", quelltextBuf);
		printLexTab();
		tableReady = 1;
	} else {
		ebnfSyntax();
	}

	/* Arbeitsdatei erst JETZT (nach loadPreservedTests) neu schreiben -- und
	   nur, wenn tatsaechlich eine vollstaendige Tabelle entstanden ist. Bei
	   Parse-Fehlern bleibt die alte Arbeitsdatei (inkl. TESTS-Block)
	   unangetastet statt wie frueher geleert. */
	if (tableReady != 0) {
		fpOut = fopen(outputFileName, "w");
		if (fpOut == 0) { fileRet = 1; } else { fileRet = 0; }
		if (fileRet != 0) {
			printf("    error: can't open output file: %s", outputFileName);
			exitProgram(-2);
		}
		writeWorkfile(fpOut);
	} else {
		printf("Hinweis: Grammatik fehlerhaft -- Arbeitsdatei '%s' bleibt unveraendert.\n", outputFileName);
	}

	/* Codegenerierung (siehe docs/ARCHITEKTUR.md): nur im Fall A (echte
	   .ebnf geparst, nur dann existiert der AST) und nur bei fehlerfreier,
	   nicht-linksrekursiver Grammatik. */
	if (fallB == 0 && tableReady != 0 && errorCnt == 0 && leftRecursionFound == 0) {
		actionsParseConfig(userCodeBuf);
		if (lexParseConfig(lexerCfgBuf) == 0 || cgenParseConfig(cgenCfgBuf) == 0) {
			printf("CODEGEN: Konfiguration fehlerhaft -- Codegenerierung uebersprungen.\n");
		} else if (genParserC(cgenCName) != 0 && genParser68k(cgen68kName) != 0) {
			printf("CODEGEN: '%s' und '%s' erzeugt.\n", cgenCName, cgen68kName);
			if (cgenWantOS9() != 0) {
				/* Basisname ohne Verzeichnis-Anteil als Default-psect-Name */
				base = baseArg;
				slash = strrchr(base, 47);		/* '/' */
				if (slash == 0) { slash = strrchr(base, 92); }		/* '\' */
				if (slash != 0) { base = slash + 1; }
				tcCopyBounded(cgenOS9Name, baseArg, len);
				strcat(cgenOS9Name, "_os9.a");
				if (genParser68kOS9(cgenOS9Name, base) != 0) {
					printf("CODEGEN: '%s' (OS-9/r68-Format) erzeugt.\n", cgenOS9Name);
				}
			}
		}
	}

	runTests();

	exitProgram(0);
}

/* Tiny-C main() hat keinen argc/argv-Mechanismus (siehe ebnfMain()-Kommentar
   oben) -- der Basisname ist deshalb hier eine feste Compile-Zeit-Konstante.
   BEKANNTE, BEWUSSTE GRENZE: fuer einen echten OS-9-Build mit variablem
   Dateinamen muesste das durch einen Syscall zum Lesen der OS-9-
   Kommandozeile (Process-Descriptor) ersetzt werden -- nicht implementiert,
   siehe [[tinyc-vollport-status]] (Memory) fuer den Kontext. */
void main() {
	ebnfMain("tinyc");
}
