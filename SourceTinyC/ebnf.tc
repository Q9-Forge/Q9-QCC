/* Wie emitAndAnd/emitOrOr/emitQMark in codegen.tc (siehe dortiger Kommentar):
   ein Tiny-C-String-Literal kann kein escaptes Anfuehrungszeichen enthalten
   UND keine literale Ein-Zeichen-Zeichenkette "\"" darstellen (der Delimiter
   selbst kann nie Inhalt sein). Das Original haengt an mehreren Stellen genau
   EIN Anfuehrungszeichen an einen Laufzeitpuffer an (z.B. strcat_s(dst, ...,
   "\"")) -- hier stattdessen ein direkter Byte-Schreib-Helfer: haengt ASCII 34
   ('"') ans Ende von buf an (buf muss NUL-terminiert und gross genug sein). */
void appendQuoteChar(char* buf) {
	int n;
	n = strlen(buf);
	buf[n] = 34;
	buf[n + 1] = 0;
}

int isIdentChar(int ch) {
	if (isalnum(ch) != 0 || ch == 95 || ch == 36) {		/* '_'=95 '$'=36 */
		return 1;
	} else {
		return 0;
	}
}

int isFirstIdentChar(int ch) {
	if (isalpha(ch) != 0 || ch == 95 || ch == 36) {
		return 1;
	} else {
		return 0;
	}
}

int isLiteralDelimiter(int ch) {
	if (ch == 34) {		/* '"' */
		return 1;
	} else {
		return 0;
	}
}

/* Zeilenende (\n und ggf. Windows-\r) entfernen -- Arbeitsdateien koennen von
   beiden Plattformen stammen. */
void chompLine(char* line) {
	int len;
	len = strlen(line);
	while (len > 0 && (line[len - 1] == 10 || line[len - 1] == 13)) {
		len = len - 1;
		line[len] = 0;
	}
}

void appendQuelltext(char* text) {
	int len;
	len = strlen(text);
	if (quelltextLen + len < 65535) {		/* QUELLTEXT_BUF_SIZE - 1 */
		memcpy(&quelltextBuf[quelltextLen], text, len);
		quelltextLen = quelltextLen + len;
		quelltextBuf[quelltextLen] = 0;
	}
}

void clearLst() {
	lst[0] = 0;
}

/* Original: strcat_s(lst, ..., " "); strcat_s(lst, ..., str); dann ggf. mit
   Leerzeichen auf "num" Zeichen auffuellen. */
void addLst(char* str, int num) {
	int i;
	int pad;
	strcat(lst, " ");
	strcat(lst, str);
	if (num > 0) {
		pad = num - strlen(str);
		i = 0;
		while (i < pad) {
			strcat(lst, " ");
			i = i + 1;
		}
	}
}

/* Escape-Sequenzen in Literalen dekodieren: \ddd (1-3 Oktalziffern), \t \n \r,
   \\ und \" (alle anderen \x ergeben x). In-place (Original: r/w-Zeiger auf
   demselben Puffer, Ergebnis ist nie laenger als die Eingabe). */
void decodeEscapes(char* s) {
	int r;
	int w;
	int v;
	int n;
	r = 0;
	w = 0;
	while (s[r] != 0) {
		if (s[r] == 92 && s[r + 1] != 0) {		/* '\\'=92 */
			r = r + 1;
			if (s[r] >= 48 && s[r] <= 55) {		/* '0'..'7' */
				v = 0;
				n = 0;
				while (n < 3 && s[r] >= 48 && s[r] <= 55) {
					v = v * 8 + (s[r] - 48);
					r = r + 1;
					n = n + 1;
				}
				s[w] = v;
				w = w + 1;
			} else {
				if (s[r] == 116) { s[w] = 9; }			/* 't' -> \t */
				else if (s[r] == 110) { s[w] = 10; }		/* 'n' -> \n */
				else if (s[r] == 114) { s[w] = 13; }		/* 'r' -> \r */
				else { s[w] = s[r]; }				/* '\\' und '"' und alles andere */
				w = w + 1;
				r = r + 1;
			}
		} else {
			s[w] = s[r];
			w = w + 1;
			r = r + 1;
		}
	}
	s[w] = 0;
}

/* Gegenstueck fuer die Arbeitsdatei: Steuerzeichen und Backslash als \ooo
   enkodieren, damit die zeilenbasierte PARSER-TABELLE robust bleibt. */
void encodeTSField(char* in, char* out, int outMax) {
	int n;
	int i;
	int c;
	n = 0;
	i = 0;
	while (in[i] != 0 && n < outMax - 5) {
		c = in[i];
		if (c < 32 || c == 127 || c == 92) {
			n = n + sprintf(&out[n], "\\%03o", c);
		} else {
			out[n] = in[i];
			n = n + 1;
		}
		i = i + 1;
	}
	out[n] = 0;
}

/* ===========================================================================
   TEIL 3: Tabellendruck, Adressaufloesung, Linksrekursion, Stack-Maschine
=========================================================================== */

/* statString[-stat] aus dem Original (ein durch negative Statuswerte
   indiziertes char[]) wird durch eine if/else-Kette ersetzt -- weder ein
   global initialisiertes "char x[] = \"...\";" noch eine char*-Variable, der
   ein String-Literal zugewiesen wird, ist in dieser Tiny-C-Version bisher
   erprobt (String-Literale werden bislang nur DIREKT als Funktionsargument
   verwendet). Aus demselben Grund werden head0/head1/value0 (das Original
   haelt sie als const char* vor) als Literal an jeder Aufrufstelle wiederholt
   statt zwischengespeichert. STAT_TRUE=-1 STAT_FALSE=-2 STAT_ERROR=-3
   STAT_NEXT=-4 STAT_NONE=-5 (aus ebnf.cpp, hier als Literalzahlen belassen). */
void printLexTab() {
	char trueStr[8];
	char falseStr[8];
	char addrStr[8];
	char identDisp[35];		/* IDENT_LEN + 3 */
	char tsDisp[35];
	int i;
	int stat;

	printf("+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
	printf("| Nr  | Rule                            | Mode| NTS/TS                          | Addr | T  | F  |\n");
	fprintf(fpLst, "+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
	fprintf(fpLst, "| Nr  | Rule                            | Mode| NTS/TS                          | Addr | T  | F  |\n");
	i = 0;
	while (i < aktTabIndex) {
		if (strlen(lexTab[i].ident) != 0) {
			printf("+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
			fprintf(fpLst, "+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
		}
		stat = lexTab[i].trueAction;
		if (stat < 0) {
			if (stat == -1) { trueStr[0] = 84; trueStr[1] = 0; }
			else if (stat == -2) { trueStr[0] = 70; trueStr[1] = 0; }
			else if (stat == -3) { trueStr[0] = 69; trueStr[1] = 0; }
			else if (stat == -4) { trueStr[0] = 78; trueStr[1] = 0; }
			else { trueStr[0] = 45; trueStr[1] = 0; }
		} else {
			sprintf(trueStr, "%d", stat);
		}
		stat = lexTab[i].falseAction;
		if (stat < 0) {
			if (stat == -1) { falseStr[0] = 84; falseStr[1] = 0; }
			else if (stat == -2) { falseStr[0] = 70; falseStr[1] = 0; }
			else if (stat == -3) { falseStr[0] = 69; falseStr[1] = 0; }
			else if (stat == -4) { falseStr[0] = 78; falseStr[1] = 0; }
			else { falseStr[0] = 45; falseStr[1] = 0; }
		} else {
			sprintf(falseStr, "%d", stat);
		}
		if (strcmp(lexTab[i].mode, "NTS") == 0) {
			if (lexTab[i].callAddr >= 0) {
				sprintf(addrStr, "%d", lexTab[i].callAddr);
			} else {
				/* "???" als String-Literal triggert den bekannten "?"-Bug (siehe
				   emitQMark in codegen.tc) -- daher direkte Byte-Zuweisung. */
				addrStr[0] = 63; addrStr[1] = 63; addrStr[2] = 63; addrStr[3] = 0;
			}
		} else {
			sprintf(addrStr, "-");
		}
		if (strlen(lexTab[i].ident) != 0) {
			sprintf(identDisp, "<%s>", lexTab[i].ident);
		} else {
			identDisp[0] = 0;
		}
		if (strcmp(lexTab[i].mode, "NTS") == 0) {
			sprintf(tsDisp, "<%s>", lexTab[i].TS);
		} else {
			tcCopyBounded(tsDisp, lexTab[i].TS, 32);
		}
		printf("| %-4d| %-32s| %-4s| %-32s| %-5s| %-3s| %-3s|\n", i, identDisp, lexTab[i].mode, tsDisp, addrStr, trueStr, falseStr);
		fprintf(fpLst, "| %-4d| %-32s| %-4s| %-32s| %-5s| %-3s| %-3s|\n", i, identDisp, lexTab[i].mode, tsDisp, addrStr, trueStr, falseStr);
		i = i + 1;
	}
	printf("+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
	fprintf(fpLst, "+-----+---------------------------------+-----+---------------------------------+------+----+----+\n");
}

void resolveCallAddresses() {
	int i;
	int j;
	int found;

	ruleSymbolCnt = 0;
	i = 0;
	while (i < aktTabIndex) {
		if (strlen(lexTab[i].ident) != 0 && ruleSymbolCnt < 256) {
			tcCopyBounded(ruleSymbols[ruleSymbolCnt].name, lexTab[i].ident, 32);
			ruleSymbols[ruleSymbolCnt].addr = i;
			ruleSymbolCnt = ruleSymbolCnt + 1;
		}
		i = i + 1;
	}

	i = 0;
	while (i < aktTabIndex) {
		if (strcmp(lexTab[i].mode, "NTS") == 0) {
			found = -1;
			j = 0;
			while (j < ruleSymbolCnt) {
				if (strcmp(ruleSymbols[j].name, lexTab[i].TS) == 0) {
					found = ruleSymbols[j].addr;
					break;
				}
				j = j + 1;
			}
			lexTab[i].callAddr = found;
			if (found < 0) {
				printf("FEHLER: Zeile %d referenziert undefinierte Regel '%s'\n", i, lexTab[i].TS);
				errorCnt = errorCnt + 1;
			}
		} else {
			lexTab[i].callAddr = -1;
		}
		i = i + 1;
	}
}

void addRuleNameIfNew(char* name) {
	int i;
	i = 0;
	while (i < ruleNameListCnt) {
		if (strcmp(&ruleNameListFlat[i * 33], name) == 0) { return; }
		i = i + 1;
	}
	if (ruleNameListCnt < 256) {		/* MAX_RULE_NAMES */
		tcCopyBounded(&ruleNameListFlat[ruleNameListCnt * 33], name, 32);
		ruleNameListCnt = ruleNameListCnt + 1;
	}
}

void addFirstEdge(char* from, char* to) {
	if (firstEdgeCnt < 1024) {		/* MAX_EDGES */
		tcCopyBounded(firstEdges[firstEdgeCnt].from, from, 32);
		tcCopyBounded(firstEdges[firstEdgeCnt].to, to, 32);
		firstEdgeCnt = firstEdgeCnt + 1;
	}
}

int findRuleNameIndex(char* name) {
	int i;
	i = 0;
	while (i < ruleNameListCnt) {
		if (strcmp(&ruleNameListFlat[i * 33], name) == 0) { return i; }
		i = i + 1;
	}
	return -1;
}

void printCyclePath(int targetIdx) {
	int i;
	int startPos;
	startPos = 0;
	i = 0;
	while (i < dfsPathLen) {
		if (strcmp(&dfsPathFlat[i * 33], &ruleNameListFlat[targetIdx * 33]) == 0) {
			startPos = i;
			break;
		}
		i = i + 1;
	}
	printf("FEHLER: LINKSREKURSION erkannt: ");
	i = startPos;
	while (i < dfsPathLen) {
		printf("%s -> ", &dfsPathFlat[i * 33]);
		i = i + 1;
	}
	printf("%s\n", &ruleNameListFlat[targetIdx * 33]);
	leftRecursionFound = 1;
}

void dfsVisit(int idx) {
	int i;
	int targetIdx;

	dfsColor[idx] = 1;
	tcCopyBounded(&dfsPathFlat[dfsPathLen * 33], &ruleNameListFlat[idx * 33], 32);
	dfsPathLen = dfsPathLen + 1;

	i = 0;
	while (i < firstEdgeCnt) {
		if (strcmp(firstEdges[i].from, &ruleNameListFlat[idx * 33]) == 0) {
			targetIdx = findRuleNameIndex(firstEdges[i].to);
			if (targetIdx >= 0) {
				if (dfsColor[targetIdx] == 1) {
					printCyclePath(targetIdx);
					errorCnt = errorCnt + 1;
				} else if (dfsColor[targetIdx] == 0) {
					dfsVisit(targetIdx);
				}
			}
		}
		i = i + 1;
	}

	dfsPathLen = dfsPathLen - 1;
	dfsColor[idx] = 2;
}

void checkLeftRecursion() {
	int i;
	i = 0;
	while (i < ruleNameListCnt) {
		dfsColor[i] = 0;
		i = i + 1;
	}
	i = 0;
	while (i < ruleNameListCnt) {
		if (dfsColor[i] == 0) {
			dfsPathLen = 0;
			dfsVisit(i);
		}
		i = i + 1;
	}
}

void extractLiteralText(char* quoted, char* out, int outMax) {
	int len;
	int n;
	len = strlen(quoted);
	n = len - 2;		/* ohne die beiden umschliessenden Anfuehrungszeichen */
	if (n < 0) { n = 0; }
	if (n > outMax - 1) { n = outMax - 1; }
	tcCopyBounded(out, &quoted[1], n);
}

/* Original-Signatur: int execFrom(int startRow, int* pos) -- schreibt die
   neue Position ueber den Out-Parameter zurueck. Hier: "pos" per Wert,
   Ergebnis ueber das globale execPosResult (siehe Kommentar bei dessen
   Deklaration in TEIL 1). "while (true)" statt "while (1)": ein bloser
   Integer-Literal als Bedingung ist nicht erprobt (die Sprache unterscheidet
   strikt int/bool), "true"/"false" sind dagegen echte Schluesselwoerter der
   Tiny-C-Grammatik. */
int execFrom(int startRow, int pos) {
	int row;
	int curPos;
	int matched;
	int next;
	char lit[33];
	int litLen;
	int subPos;

	row = startRow;
	curPos = pos;

	while (true) {
		matched = 0;

		if (strcmp(lexTab[row].mode, "TS") == 0) {
			extractLiteralText(lexTab[row].TS, lit, 33);
			litLen = strlen(lit);
			if (curPos + litLen <= inputLen && strncmp(&inputBuf[curPos], lit, litLen) == 0) {
				matched = 1;
				curPos = curPos + litLen;
			}
		} else if (strcmp(lexTab[row].mode, "RNG") == 0) {
			if (curPos < inputLen && inputBuf[curPos] >= lexTab[row].rangeLo && inputBuf[curPos] <= lexTab[row].rangeHi) {
				matched = 1;
				curPos = curPos + 1;
			}
		} else if (strcmp(lexTab[row].mode, "NTS") == 0) {
			if (lexTab[row].callAddr < 0) {
				printf("LAUFZEITFEHLER: Aufruf einer undefinierten Regel in Zeile %d\n", row);
				return 0;
			}
			subPos = curPos;
			if (execFrom(lexTab[row].callAddr, subPos) != 0) {
				matched = 1;
				curPos = execPosResult;
			} else {
				matched = 0;
			}
		} else {
			printf("LAUFZEITFEHLER: unbekannter Modus '%s' in Zeile %d\n", lexTab[row].mode, row);
			return 0;
		}

		if (matched != 0) { next = lexTab[row].trueAction; } else { next = lexTab[row].falseAction; }

		if (next == -1) {		/* STAT_TRUE */
			execPosResult = curPos;
			return 1;
		}
		if (next == -2 || next == -3) {		/* STAT_FALSE / STAT_ERROR */
			return 0;
		}
		if (next < 0) {
			printf("LAUFZEITFEHLER: unerwarteter Status %d in Zeile %d\n", next, row);
			return 0;
		}
		row = next;
	}
}

/* ===========================================================================
   TEIL 4: Arbeitsdatei (NUTZER-CODE/LEXER/CODEGEN-Rohbloecke, TS-Symboltabelle)
=========================================================================== */

void appendUserCodeLine(char* line) {
	int n;
	n = strlen(line);
	if (userCodeLen + n + 2 >= 1048576) {		/* USER_CODE_LEN */
		userCodeTruncated = 1;
		return;
	}
	memcpy(&userCodeBuf[userCodeLen], line, n);
	userCodeLen = userCodeLen + n;
	userCodeBuf[userCodeLen] = 10;
	userCodeLen = userCodeLen + 1;
	userCodeBuf[userCodeLen] = 0;
}

void appendLexerCfgLine(char* line) {
	int n;
	n = strlen(line);
	if (lexerCfgLen + n + 2 >= 4096) {		/* LEXER_CFG_LEN */
		printf("WARNUNG: [LEXER]-Block groesser als %d Bytes -- Rest ignoriert.\n", 4095);
		return;
	}
	memcpy(&lexerCfgBuf[lexerCfgLen], line, n);
	lexerCfgLen = lexerCfgLen + n;
	lexerCfgBuf[lexerCfgLen] = 10;
	lexerCfgLen = lexerCfgLen + 1;
	lexerCfgBuf[lexerCfgLen] = 0;
}

void appendCgenCfgLine(char* line) {
	int n;
	n = strlen(line);
	if (cgenCfgLen + n + 2 >= 4096) {		/* CGEN_CFG_LEN */
		printf("WARNUNG: [CODEGEN]-Block groesser als %d Bytes -- Rest ignoriert.\n", 4095);
		return;
	}
	memcpy(&cgenCfgBuf[cgenCfgLen], line, n);
	cgenCfgLen = cgenCfgLen + n;
	cgenCfgBuf[cgenCfgLen] = 10;
	cgenCfgLen = cgenCfgLen + 1;
	cgenCfgBuf[cgenCfgLen] = 0;
}

/* Original-Signatur: int tsSymbolIndexOf(char tsList[][IDENT_LEN+1], int tsCnt,
   const char* sym) -- 2D-Array-Parameter geht nicht (Quirk 4), daher flaches
   Array + fest verdrahtete Breite 33 (IDENT_LEN+1), analog ruleNameListFlat. */
int tsSymbolIndexOf(char* tsListFlat, int tsCnt, char* sym) {
	int i;
	i = 0;
	while (i < tsCnt) {
		if (strcmp(&tsListFlat[i * 33], sym) == 0) { return i; }
		i = i + 1;
	}
	return -1;
}

/* Schreibt die komplette Arbeitsdatei. fp muss bereits per "w" geoeffnet sein
   (WICHTIG: erst NACH loadPreservedTests() oeffnen, sonst ist der alte
   TESTS-Block schon weg -- siehe Source/ebnf.cpp:1007-1130).

   Tiny-C-Anpassungen gegenueber dem Original:
   (1) tsList/tsMode: siehe Kommentar bei tsListFlat/tsModeFlat in TEIL 1.
   (2) Jede Stelle, an der das Original ein Anfuehrungszeichen oder eine
       LITERALE Backslash-Buchstabenfolge (als TEXT, nicht als Escape --
       z.B. "\ooo" oder "\t\r\n" in einer Beispielkonfiguration) ausgibt,
       ist umgebaut: ein Anfuehrungszeichen kann nie Teil eines Tiny-C-
       String-Literals sein (Quirk 2, siehe TEIL-1-Kommentar oben) --
       Workaround fputc(34, fp). Eine literale Backslash-Buchstabenfolge ist
       NOCH trickreicher: Tiny-C's eigener String-Literal-Dekoder
       (tcDecodeStringLit, Data/tinyc.lextab) verschluckt JEDEN Backslash
       zusammen mit dem Folgezeichen (wird zu einem Escape-Byte, oder --
       falls das Folgezeichen kein t/n/r/0 ist -- einfach zum blossen
       Folgezeichen OHNE den Backslash). Ein literaler Backslash entkommt
       dem nur, wenn er das LETZTE Zeichen direkt vor dem schliessenden
       Anfuehrungszeichen ist (dann greift die Sonderbehandlung nicht, da
       kein Folgezeichen mehr im selben Literal existiert). Deshalb hier:
       Backslash und Folgebuchstabe in ZWEI GETRENNTEN Aufrufen ausgeben
       (fputc(92, fp), dann ein EIGENES fprintf/fputc fuer den Buchstaben),
       damit beide nie im selben Literal aufeinandertreffen. Die ZWEI echten
       Tab-Zeichen im NUTZER-CODE-Beispieltext unten (einfaches "\t", nicht
       doppelt escaped wie im ebnf.cpp-Original) sind dagegen ECHTE Tabs
       (Einrueckung eines Assembler-Beispiels) -- die brauchen genau die
       normale Escape-Dekodierung, bleiben also direkte "\t"-Literale.
   (3) Ternaere Ausdruecke als fprintf-Argument sind bewusst vermieden:
       eine int-Bedingung braucht ohnehin "!= 0" (Quirk 3), und eine
       char*-Variable, der wechselweise ein Feld ODER ein String-Literal
       zugewiesen wird, ist laut TEIL-3-Kommentar oben unerprobt --
       stattdessen komplette if/else-Zweige mit dupliziertem fprintf-Aufruf
       (String-Literale bleiben so immer direkte Funktionsargumente, der
       einzige bereits erprobte Fall). */
void writeWorkfile(void* fp) {
	int i;
	int tsCnt;
	char enc[72];		/* 2*IDENT_LEN+8 = 2*32+8 */
	int rngLo;
	int rngHi;

	tsCnt = 0;

	fprintf(fp, "#================================================================================\n");
	fprintf(fp, "# EBNF-ARBEITSDATEI -- automatisch erzeugt von ebnf\n");
	fprintf(fp, "# Die Bloecke [TESTS] und [NUTZER-CODE] sind zum Editieren gedacht und bleiben\n");
	fprintf(fp, "# beim Neu-Erzeugen erhalten. NUTZER-CODE ist vorbereitet, wird aber noch nicht\n");
	fprintf(fp, "# in C/68k eingebunden (Format/Architektur: docs/ARCHITEKTUR.md).\n");
	fprintf(fp, "# Existiert <basis>.ebnf, ist IMMER die .ebnf die Wahrheit; ohne .ebnf\n");
	fprintf(fp, "# kann diese Datei direkt als Grammatik geladen werden (PARSER-TABELLE-Block).\n");
	fprintf(fp, "#================================================================================\n\n");

	/* Block 1: EBNF-QUELLTEXT (waehrend des Parsens von rule() mitgeschrieben) */
	fprintf(fp, "[EBNF-QUELLTEXT]\n");
	fprintf(fp, "%s", quelltextBuf);
	if (quelltextLen > 0 && quelltextBuf[quelltextLen - 1] != 10) {		/* EOL */
		fprintf(fp, "\n");
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 2: TS-SYMBOLTABELLE (distinkte Terminale, Reihenfolge = erstes Vorkommen) */
	i = 0;
	while (i < aktTabIndex) {
		if ((strcmp(lexTab[i].mode, "TS") == 0 || strcmp(lexTab[i].mode, "RNG") == 0)
			&& tsSymbolIndexOf(tsListFlat, tsCnt, lexTab[i].TS) < 0 && tsCnt < 1024) {
			tcCopyBounded(&tsListFlat[tsCnt * 33], lexTab[i].TS, 32);
			tcCopyBounded(&tsModeFlat[tsCnt * 4], lexTab[i].mode, 3);
			tsCnt = tsCnt + 1;
		}
		i = i + 1;
	}
	fprintf(fp, "[TS-SYMBOLTABELLE]\n");
	fprintf(fp, "# nr  typ  symbol\n");
	i = 0;
	while (i < tsCnt) {
		encodeTSField(&tsListFlat[i * 33], enc, 72);
		fprintf(fp, "%-4d %-4s %s\n", i, &tsModeFlat[i * 4], enc);
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 3: NTS-SYMBOLTABELLE (= ruleSymbols: Regelname + Startzeile) */
	fprintf(fp, "[NTS-SYMBOLTABELLE]\n");
	fprintf(fp, "# nr  startzeile  name\n");
	i = 0;
	while (i < ruleSymbolCnt) {
		fprintf(fp, "%-4d %-11d %s\n", i, ruleSymbols[i].addr, ruleSymbols[i].name);
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 4: PARSER-TABELLE (Integer-Werte 1:1 wie intern, symbol = Rest der Zeile) */
	fprintf(fp, "[PARSER-TABELLE]\n");
	fprintf(fp, "# zeile true false addr rngLo rngHi regel modus symbol\n");
	fprintf(fp, "# (symbol: Steuerzeichen/Backslash als ");
	fputc(92, fp);
	fprintf(fp, "ooo enkodiert -- Zeilenformat!)\n");
	i = 0;
	while (i < aktTabIndex) {
		encodeTSField(lexTab[i].TS, enc, 72);
		if (strcmp(lexTab[i].mode, "RNG") == 0) {
			rngLo = (int) lexTab[i].rangeLo;
			rngHi = (int) lexTab[i].rangeHi;
		} else {
			rngLo = 0;
			rngHi = 0;
		}
		/* Auf ZWEI fprintf-Aufrufe aufgeteilt: der CALLEXT-Mechanismus fuer
		   variadische extern-Aufrufe erlaubt max. 8 Stack-Argumente (siehe
		   Kommentar oben) -- neun Werte in einem Aufruf (i/true/false/addr/
		   rngLo/rngHi/ident/mode/enc) ueberschreiten das. */
		fprintf(fp, "%-5d %-5d %-5d %-5d %-5d %-5d ",
			i, lexTab[i].trueAction, lexTab[i].falseAction, lexTab[i].callAddr, rngLo, rngHi);
		if (strlen(lexTab[i].ident) != 0) {
			fprintf(fp, "%-16s %-4s %s\n", lexTab[i].ident, lexTab[i].mode, enc);
		} else {
			fprintf(fp, "%-16s %-4s %s\n", "-", lexTab[i].mode, enc);
		}
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n\n");

	/* Block 5: TESTS (aus der alten Arbeitsdatei gerettet, unveraendert zurueckschreiben) */
	fprintf(fp, "[TESTS]\n");
	fprintf(fp, "# TEST ");
	fputc(34, fp);
	fprintf(fp, "<eingabe>");
	fputc(34, fp);
	fprintf(fp, " OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt\n");
	i = 0;
	while (i < testCaseCnt) {
		fprintf(fp, "TEST ");
		fputc(34, fp);
		fprintf(fp, "%s", testCases[i].input);
		fputc(34, fp);
		if (testCases[i].expectOk != 0) {
			fprintf(fp, " OK\n");
		} else {
			fprintf(fp, " FAIL\n");
		}
		i = i + 1;
	}
	fprintf(fp, "[ENDE]\n");

	/* Block 6: LEXER-Konfiguration (roh erhalten; siehe codegen.tc lexParseConfig) */
	fprintf(fp, "\n[LEXER]\n");
	if (lexerCfgLen == 0) {
		fprintf(fp, "# Optional: aktiviert Whitespace-/Kommentar-Behandlung im ERZEUGTEN Parser.\n");
		fprintf(fp, "# WHITESPACE = ");
		fputc(34, fp);
		fprintf(fp, " ");
		fputc(92, fp); fprintf(fp, "t");
		fputc(92, fp); fprintf(fp, "r");
		fputc(92, fp); fprintf(fp, "n");
		fputc(34, fp);
		fprintf(fp, "\n");
		fprintf(fp, "# TOKEN ident            (Regel wird lexikalisch: Zeichen muessen adjazent sein)\n");
		fprintf(fp, "# COMMENT LINE = ");
		fputc(34, fp); fprintf(fp, "//"); fputc(34, fp);
		fprintf(fp, "\n");
		fprintf(fp, "# COMMENT BLOCK = ");
		fputc(34, fp); fprintf(fp, "(*"); fputc(34, fp);
		fprintf(fp, " ");
		fputc(34, fp); fprintf(fp, "*)"); fputc(34, fp);
		fprintf(fp, "          (NESTED vor '=' erlaubt Schachtelung)\n");
	} else {
		fprintf(fp, "%s", lexerCfgBuf);
	}
	fprintf(fp, "[ENDE]\n");

	/* Block 6b: CODEGEN-Optionen (roh erhalten, geparst von cgenParseConfig()) */
	fprintf(fp, "\n[CODEGEN]\n");
	if (cgenCfgLen == 0) {
		fprintf(fp, "# Optional: Ausgabe-Optionen der Codegenerierung.\n");
		fprintf(fp, "# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)\n");
		fprintf(fp, "# M68K PSECT = name      (psect-Name, Default: <basisname>_p)\n");
	} else {
		fprintf(fp, "%s", cgenCfgBuf);
	}
	fprintf(fp, "[ENDE]\n");

	/* Block 7: NUTZER-CODE. Bleibt absichtlich roh (siehe Original-Kommentar). */
	fprintf(fp, "\n[NUTZER-CODE]\n");
	if (userCodeLen == 0) {
		fprintf(fp, "# Semantische Aktionen (siehe docs/ARCHITEKTUR.md, Abschnitt 9). Beispiel:\n");
		fprintf(fp, "# ACTION AFTER <regel> CALL <name>\n");
		fprintf(fp, "# ROUTINE C <name>\n");
		fprintf(fp, "# void <name>(const char* start, const char* end) { /* ... */ }\n");
		fprintf(fp, "# END\n");
		fprintf(fp, "# ROUTINE M68K <name>\n");
		fprintf(fp, "# <name>:\t; a0 = Ende des erkannten Textes, MUSS erhalten bleiben\n");
		fprintf(fp, "#\trts\n");
		fprintf(fp, "# END\n");
	} else {
		fprintf(fp, "%s", userCodeBuf);
		if (userCodeTruncated != 0) {
			fprintf(fp, "# WARNUNG: Eingabe war groesser als %d Bytes.\n", 1048575);		/* USER_CODE_LEN - 1 */
		}
	}
	fprintf(fp, "[ENDE]\n");
}

/* Fall B: Kanten fuer die Linksrekursions-Pruefung aus der GELADENEN Tabelle
   rekonstruieren (Source/ebnf.cpp:1132-1156) -- Gegenstueck zur normalen
   Ermittlung waehrend des Parsens (ueber das firstPos-Flag). Idee: ein
   Fehlschlag konsumiert nie Eingabe -- alles, was vom Regelstart aus NUR ueber
   falseAction-Kanten erreichbar ist, liegt an "erster Position" der Regel.
   Jede NTS-Zeile auf diesem Weg ergibt eine Kante Regel->Zielregel. Original
   nutzt C++s "for"/"continue" -- hier wie im Rest der Datei per while
   umgesetzt (kein continue: der Trailing-Increment "r = r + 1" muesste sonst
   VOR jedem continue wiederholt werden -- die if-umschlossene Form vermeidet
   dieses Fussangel-Risiko vollstaendig). */
void rebuildFirstEdgesFromTable() {
	int r;
	int row;
	int i;

	firstEdgeCnt = 0;
	ruleNameListCnt = 0;
	r = 0;
	while (r < aktTabIndex) {
		if (strlen(lexTab[r].ident) != 0) {
			addRuleNameIfNew(lexTab[r].ident);
			i = 0;
			while (i < aktTabIndex) {
				rebuildVisited[i] = 0;
				i = i + 1;
			}
			row = r;
			while (row >= 0 && row < aktTabIndex && rebuildVisited[row] == 0) {
				rebuildVisited[row] = 1;
				if (strcmp(lexTab[row].mode, "NTS") == 0) {
					addFirstEdge(lexTab[r].ident, lexTab[row].TS);
				}
				row = lexTab[row].falseAction;
			}
		}
		r = r + 1;
	}
}

/* Handparser-Helfer fuer loadWorkfileAsGrammar() (statt sscanf): das Original
   liest die PARSER-TABELLE-Zeile mit EINEM grossen sscanf("%d %d %d %d %d %d
   %32s %7s %n", ...) -- neun Ausgabeparameter (sechs int*, zwei char*, ein
   int* fuer die Consumed-Position via %n) in EINEM Aufruf. Das geht hier aus
   ZWEI Gruenden nicht 1:1: (1) CALLEXT erlaubt max. 8 Stack-Argumente (siehe
   writeWorkfile-Kommentar), neun ueberschreiten das. (2) int*-Ausgabeparameter
   mit "*p = wert"-Schreibzugriff sind in dieser Tiny-C-Version generell
   unerprobt (siehe execPosResult-Kommentar, execFrom) -- sscanf wuerde genau
   das brauchen. Stattdessen ein simpler Handparser mit der globalen
   Parse-Position wfParsePos (TEIL 1), passend zum Zeilenformat aus
   writeWorkfile ("%-5d ... %-16s %-4s %s\n" -- sechs space-gepolsterte
   Ganzzahlen, ein "%-Ns"-Feld ist beim Zurueckparsen einfach "Text bis zum
   naechsten Leerzeichen", der Rest der Zeile bleibt unangetastet). */
void wfSkipSpaces(char* line) {
	while (line[wfParsePos] == 32) { wfParsePos = wfParsePos + 1; }		/* ' ' */
}

int wfParseInt(char* line) {
	int neg;
	int v;
	wfSkipSpaces(line);
	neg = 0;
	if (line[wfParsePos] == 45) { neg = 1; wfParsePos = wfParsePos + 1; }		/* '-' */
	v = 0;
	while (line[wfParsePos] >= 48 && line[wfParsePos] <= 57) {		/* '0'..'9' */
		v = v * 10 + (line[wfParsePos] - 48);
		wfParsePos = wfParsePos + 1;
	}
	if (neg != 0) { v = 0 - v; }
	return v;
}

void wfParseToken(char* line, char* out, int outMax) {
	int n;
	wfSkipSpaces(line);
	n = 0;
	while (line[wfParsePos] != 0 && line[wfParsePos] != 32 && n < outMax - 1) {
		out[n] = line[wfParsePos];
		n = n + 1;
		wfParsePos = wfParsePos + 1;
	}
	out[n] = 0;
}

/* Fall B: PARSER-TABELLE- und EBNF-QUELLTEXT-Block direkt aus der Arbeitsdatei
   laden (keine .ebnf vorhanden), Source/ebnf.cpp:1162-1231. Liefert 1 bei
   Erfolg, 0 wenn die Datei keine Arbeitsdatei im neuen Format ist (kein
   [PARSER-TABELLE]-Block gefunden) oder nicht lesbar war. blk als einfacher
   int statt des anonymen lokalen enums im Original (0=NONE 1=QUELLTEXT
   2=PARSERTAB 3=SONST) -- anonyme lokale enums sind in dieser Tiny-C-Version
   bisher nirgends erprobt, ein einfacher int mit Kommentar ist das etablierte
   Muster (siehe STAT_TRUE/STAT_FALSE/... in printLexTab). */
int loadWorkfileAsGrammar(char* path) {
	void* fp;
	char line[512];		/* WORKFILE_LINE */
	int blk;
	int rowsLoaded;
	int nr;
	int tA;
	int fA;
	int addr;
	int lo;
	int hi;
	char identBuf[33];
	char modeBuf[8];

	blk = 0;
	rowsLoaded = 0;

	fp = fopen(path, "r");
	if (fp == 0) { return 0; }

	aktTabIndex = 0;
	quelltextLen = 0;
	quelltextBuf[0] = 0;

	while (fgets(line, 512, fp) != 0) {
		chompLine(line);
		if (line[0] == 91) {		/* '[' */
			if (strncmp(line, "[EBNF-QUELLTEXT]", 16) == 0) { blk = 1; }
			else if (strncmp(line, "[PARSER-TABELLE]", 16) == 0) { blk = 2; }
			else { blk = 3; }
			continue;
		}
		if (blk == 1) {
			appendQuelltext(line);
			appendQuelltext("\n");
		} else if (blk == 2) {
			if (line[0] != 35 && line[0] != 0 && aktTabIndex < 1024) {		/* '#' / EOS / LEXTAB_LEN */
				wfParsePos = 0;
				nr = wfParseInt(line);
				tA = wfParseInt(line);
				fA = wfParseInt(line);
				addr = wfParseInt(line);
				lo = wfParseInt(line);
				hi = wfParseInt(line);
				wfParseToken(line, identBuf, 33);
				wfParseToken(line, modeBuf, 8);
				wfSkipSpaces(line);

				if (strcmp(modeBuf, "TS") == 0 || strcmp(modeBuf, "NTS") == 0 || strcmp(modeBuf, "RNG") == 0) {
					if (strcmp(identBuf, "-") == 0) {
						/* "lexTab[aktTabIndex].ident[0] = 0;" (arr[i].field[j] als
						   Zuweisungsziel) wird vom Frontend abgelehnt -- stattdessen
						   ueber das bereits erprobte tcCopyBounded einen leeren
						   Puffer schreiben (identisch zum "-"-Fall anderswo im Code). */
						tcCopyBounded(lexTab[aktTabIndex].ident, "", 32);
					} else {
						tcCopyBounded(lexTab[aktTabIndex].ident, identBuf, 32);
					}
					if (strcmp(modeBuf, "TS") == 0) { lexTab[aktTabIndex].mode = "TS"; }
					else if (strcmp(modeBuf, "NTS") == 0) { lexTab[aktTabIndex].mode = "NTS"; }
					else { lexTab[aktTabIndex].mode = "RNG"; }
					lexTab[aktTabIndex].trueAction = tA;
					lexTab[aktTabIndex].falseAction = fA;
					lexTab[aktTabIndex].callAddr = addr;
					lexTab[aktTabIndex].rangeLo = (char) lo;
					lexTab[aktTabIndex].rangeHi = (char) hi;
					lexTab[aktTabIndex].ambigF = 0;
					tcCopyBounded(lexTab[aktTabIndex].TS, &line[wfParsePos], 32);
					decodeEscapes(lexTab[aktTabIndex].TS);
					aktTabIndex = aktTabIndex + 1;
					rowsLoaded = rowsLoaded + 1;
				} else {
					printf("FEHLER: Arbeitsdatei Zeile %d: unbekannter Modus '%s'\n", nr, modeBuf);
					errorCnt = errorCnt + 1;
				}
			}
		}
	}
	fclose(fp);

	if (rowsLoaded == 0) {
		/* "?" als reiner Text in einem String-Literal triggert den bekannten
		   "conditional-frame mismatch"-Bug (Quirk 15) -- daher ohne Fragezeichen
		   umformuliert. */
		printf("FEHLER: '%s' enthaelt keinen [PARSER-TABELLE]-Block (vermutlich eine alte CSV-Datei)\n", path);
		return 0;
	}
	return 1;
}
