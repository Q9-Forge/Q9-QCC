[ENDE]

[TESTS]
# TEST "<eingabe>" OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt
[ENDE]

[LEXER]
WHITESPACE = " \t\r\n"
TOKEN ident
TOKEN number
TOKEN stringLit
TOKEN charLit
COMMENT LINE = "//"
COMMENT BLOCK = "/*" "*/"
[ENDE]

[CODEGEN]
# Optional: Ausgabe-Optionen der Codegenerierung.
# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)
# M68K PSECT = name      (psect-Name, Default: <basisname>_p)
[ENDE]

[NUTZER-CODE]
# QCC Frontend (Meilenstein 1): Aktionen emittieren Stack-IR nach stdout.
# Siehe docs/ARCHITEKTUR.md Kapitel 10. Nur ROUTINE C (IR-Emission), analog calcexpr.
ACTION AFTER defName CALL tc_defname
ACTION AFTER constKw CALL tc_const
ACTION AFTER staticKw CALL tc_static
ACTION AFTER staticLocalName CALL tc_staticlocalname
ACTION AFTER staticRuntimeInit CALL tc_staticruntimeinit
ACTION AFTER staticVarDecl CALL tc_staticlocal
ACTION AFTER externName CALL tc_externname
ACTION AFTER externParam CALL tc_externparam
ACTION AFTER ellipsisTok CALL tc_externvariadic
ACTION AFTER externDecl CALL tc_externdeclend
ACTION AFTER paramDecl CALL tc_param
ACTION AFTER funcHead CALL tc_funcbegin
ACTION AFTER funcBodyOpen CALL tc_funcbodybegin
ACTION AFTER protoEnd CALL tc_funcdeclend
ACTION AFTER funcdef CALL tc_funcend
ACTION AFTER localName CALL tc_local
ACTION AFTER localDecl CALL tc_localdecl
ACTION AFTER type CALL tc_type
ACTION AFTER pointerDecl CALL tc_pointerdecl
ACTION AFTER plainGlobalDecl CALL tc_globalend
ACTION AFTER externGlobalDecl CALL tc_externglobaldecl
ACTION AFTER varInit CALL tc_varinit
ACTION AFTER number CALL tc_number
ACTION AFTER boolLit CALL tc_number
ACTION AFTER stringLit CALL tc_string
ACTION AFTER arrayStringInit CALL tc_arrayinitstring
ACTION AFTER indexOpen CALL tc_callname
ACTION AFTER index CALL tc_arg
ACTION AFTER postfixIndex CALL tc_postfixindex
ACTION AFTER varRef CALL tc_varref
ACTION AFTER addressRef CALL tc_addressref
ACTION AFTER derefRef CALL tc_derefref
ACTION AFTER negFactor CALL tc_neg
ACTION AFTER addop CALL tc_addop
ACTION AFTER term CALL tc_term
ACTION AFTER mulop CALL tc_mulop
ACTION AFTER factor CALL tc_factor
ACTION AFTER relop CALL tc_relop
ACTION AFTER comparison CALL tc_expr
ACTION AFTER andop CALL tc_logicandop
ACTION AFTER andExpr CALL tc_logicandend
ACTION AFTER orop CALL tc_logicorop
ACTION AFTER orExpr CALL tc_logicorend
ACTION AFTER bitandop CALL tc_bitandop
ACTION AFTER bitAndExpr CALL tc_bitandend
ACTION AFTER bitxorop CALL tc_bitxorop
ACTION AFTER bitXorExpr CALL tc_bitxorend
ACTION AFTER bitorop CALL tc_bitorop
ACTION AFTER bitOrExpr CALL tc_bitorend
ACTION AFTER shiftop CALL tc_shiftop
ACTION AFTER shiftRhs CALL tc_shiftrhs
ACTION AFTER qmark CALL tc_ternarybegin
ACTION AFTER colon CALL tc_ternarymiddle
ACTION AFTER conditionalExpr CALL tc_ternaryend
ACTION AFTER assignop CALL tc_assignop
ACTION AFTER directTarget CALL tc_target
ACTION AFTER indirectTarget CALL tc_indirecttarget
ACTION AFTER assignStmt CALL tc_assign
ACTION AFTER funcName CALL tc_callname
ACTION AFTER arg CALL tc_arg
ACTION AFTER call CALL tc_call
ACTION AFTER callStmt CALL tc_callstmt
ACTION AFTER retVal CALL tc_retval
ACTION AFTER returnStmt CALL tc_return
ACTION AFTER ifKw CALL tc_ifbegin
ACTION AFTER ifCond CALL tc_ifcond
ACTION AFTER thenPart CALL tc_thenend
ACTION AFTER ifStmt CALL tc_ifend
ACTION AFTER whileKw CALL tc_whilebegin
ACTION AFTER whileCond CALL tc_whilecond
ACTION AFTER whileStmt CALL tc_whileend
ACTION AFTER forKw CALL tc_forbegin
ACTION AFTER forInit CALL tc_assign
ACTION AFTER forSep1 CALL tc_forsep1
ACTION AFTER forCond CALL tc_forcond
ACTION AFTER forSep2 CALL tc_forsep2
ACTION AFTER forStep CALL tc_forstep
ACTION AFTER forClose CALL tc_forclose
ACTION AFTER forStmt CALL tc_forend
ACTION AFTER doKw CALL tc_dobegin
ACTION AFTER doWhileTok CALL tc_dowhiletok
ACTION AFTER doCond CALL tc_docond
ACTION AFTER doStmt CALL tc_doend
ACTION AFTER breakStmt CALL tc_break
ACTION AFTER continueStmt CALL tc_continue
ACTION AFTER gotoStmt CALL tc_goto
ACTION AFTER labelStmt CALL tc_label
ACTION AFTER fnPtrOpen CALL tc_fnptrbegin
ACTION AFTER fnPtrTypedef CALL tc_fnptrtypedef
ACTION AFTER indCallOpen CALL tc_indcallbegin
ACTION AFTER voidCastStmt CALL tc_voidcast
ACTION AFTER charLit CALL tc_charlit
ACTION AFTER indirectCall CALL tc_indcall
ACTION AFTER structName CALL tc_structbegin
ACTION AFTER anonStructOpen CALL tc_anonstructbegin
ACTION AFTER structDeclarator CALL tc_structfield
ACTION AFTER structDecl CALL tc_structend
ACTION AFTER typedefDecl CALL tc_typedefend
ACTION AFTER enumDecl CALL tc_enumdecl
