[ENDE]

[TESTS]
# TEST "<eingabe>" OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt
[ENDE]

[LEXER]
WHITESPACE = " \t\r\n"
TOKEN ident
TOKEN number
TOKEN stringLit
COMMENT LINE = "//"
COMMENT BLOCK = "/*" "*/"
[ENDE]

[CODEGEN]
# Optional: Ausgabe-Optionen der Codegenerierung.
# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)
# M68K PSECT = name      (psect-Name, Default: <basisname>_p)
[ENDE]

[NUTZER-CODE]
# QCC Frontend (Meilenstein 1): Aktionen emittieren Stack-IR nach stdout.
# Siehe docs/ARCHITEKTUR.md Kapitel 10. Nur ROUTINE C (IR-Emission), analog calcexpr.
ACTION AFTER defName CALL tc_defname
ACTION AFTER constKw CALL tc_const
ACTION AFTER staticKw CALL tc_static
ACTION AFTER staticLocalName CALL tc_staticlocalname
ACTION AFTER staticRuntimeInit CALL tc_staticruntimeinit
ACTION AFTER staticVarDecl CALL tc_staticlocal
ACTION AFTER externName CALL tc_externname
