[ENDE]

[TESTS]
# TEST "<eingabe>" OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt
[ENDE]

[LEXER]
WHITESPACE = " \t\r\n"
TOKEN ident
TOKEN number
TOKEN stringLit
TOKEN charLit
COMMENT LINE = "//"
COMMENT BLOCK = "/*" "*/"
[ENDE]

[CODEGEN]
# Optional: Ausgabe-Optionen der Codegenerierung.
# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)
# M68K PSECT = name      (psect-Name, Default: <basisname>_p)
[ENDE]

[NUTZER-CODE]
# QCC Frontend (Meilenstein 1): Aktionen emittieren Stack-IR nach stdout.
# Siehe docs/ARCHITEKTUR.md Kapitel 10. Nur ROUTINE C (IR-Emission), analog calcexpr.
ACTION AFTER defName CALL tc_defname
ACTION AFTER constKw CALL tc_const
ACTION AFTER staticKw CALL tc_static
ACTION AFTER staticLocalName CALL tc_staticlocalname
ACTION AFTER staticRuntimeInit CALL tc_staticruntimeinit
ACTION AFTER staticVarDecl CALL tc_staticlocal
ACTION AFTER externName CALL tc_externname
ACTION AFTER externParam CALL tc_externparam
ACTION AFTER ellipsisTok CALL tc_externvariadic
ACTION AFTER externDecl CALL tc_externdeclend
ACTION AFTER paramDecl CALL tc_param
ACTION AFTER funcHead CALL tc_funcbegin
ACTION AFTER funcBodyOpen CALL tc_funcbodybegin
ACTION AFTER protoEnd CALL tc_funcdeclend
ACTION AFTER funcdef CALL tc_funcend
ACTION AFTER localName CALL tc_local
ACTION AFTER localDecl CALL tc_localdecl
ACTION AFTER type CALL tc_type
ACTION AFTER pointerDecl CALL tc_pointerdecl
ACTION AFTER plainGlobalDecl CALL tc_globalend
ACTION AFTER externGlobalDecl CALL tc_externglobaldecl
ACTION AFTER varInit CALL tc_varinit
ACTION AFTER number CALL tc_number
ACTION AFTER boolLit CALL tc_number
ACTION AFTER stringLit CALL tc_string
ACTION AFTER arrayStringInit CALL tc_arrayinitstring
ACTION AFTER indexOpen CALL tc_callname
ACTION AFTER index CALL tc_arg
ACTION AFTER postfixIndex CALL tc_postfixindex
ACTION AFTER varRef CALL tc_varref
ACTION AFTER addressRef CALL tc_addressref
ACTION AFTER derefRef CALL tc_derefref
