ACTION AFTER andExpr CALL tc_logicandend
ACTION AFTER orop CALL tc_logicorop
ACTION AFTER orExpr CALL tc_logicorend
ACTION AFTER bitandop CALL tc_bitandop
ACTION AFTER bitAndExpr CALL tc_bitandend
ACTION AFTER bitxorop CALL tc_bitxorop
ACTION AFTER bitXorExpr CALL tc_bitxorend
ACTION AFTER bitorop CALL tc_bitorop
ACTION AFTER bitOrExpr CALL tc_bitorend
ACTION AFTER shiftop CALL tc_shiftop
ACTION AFTER shiftRhs CALL tc_shiftrhs
ACTION AFTER qmark CALL tc_ternarybegin
ACTION AFTER colon CALL tc_ternarymiddle
ACTION AFTER conditionalExpr CALL tc_ternaryend
ACTION AFTER assignop CALL tc_assignop
ACTION AFTER directTarget CALL tc_target
ACTION AFTER indirectTarget CALL tc_indirecttarget
ACTION AFTER assignStmt CALL tc_assign
ACTION AFTER funcName CALL tc_callname
ACTION AFTER arg CALL tc_arg
ACTION AFTER call CALL tc_call
ACTION AFTER callStmt CALL tc_callstmt
ACTION AFTER retVal CALL tc_retval
ACTION AFTER returnStmt CALL tc_return
ACTION AFTER ifKw CALL tc_ifbegin
ACTION AFTER ifCond CALL tc_ifcond
ACTION AFTER thenPart CALL tc_thenend
ACTION AFTER ifStmt CALL tc_ifend
ACTION AFTER whileKw CALL tc_whilebegin
ACTION AFTER whileCond CALL tc_whilecond
ACTION AFTER whileStmt CALL tc_whileend
ACTION AFTER forKw CALL tc_forbegin
ACTION AFTER forInit CALL tc_assign
ACTION AFTER forSep1 CALL tc_forsep1
ACTION AFTER forCond CALL tc_forcond
ACTION AFTER forSep2 CALL tc_forsep2
