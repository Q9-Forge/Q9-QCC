ACTION AFTER forClose CALL tc_forclose
ACTION AFTER forStmt CALL tc_forend
ACTION AFTER doKw CALL tc_dobegin
ACTION AFTER doWhileTok CALL tc_dowhiletok
ACTION AFTER doCond CALL tc_docond
ACTION AFTER doStmt CALL tc_doend
ACTION AFTER breakStmt CALL tc_break
ACTION AFTER continueStmt CALL tc_continue
ACTION AFTER gotoStmt CALL tc_goto
ACTION AFTER labelStmt CALL tc_label
ACTION AFTER fnPtrOpen CALL tc_fnptrbegin
ACTION AFTER fnPtrTypedef CALL tc_fnptrtypedef
ACTION AFTER indCallOpen CALL tc_indcallbegin
