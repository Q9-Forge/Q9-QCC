program   = { globalDecl | structDecl | typedefDecl | enumDecl | externDecl } { funcdef } .

/* Deklaration einer NICHT in Tiny-C definierten Funktion (z.B. einer echten
   OS-9/Microware-clib-Funktion wie strcmp/printf/malloc) -- kein Rumpf, nur
   Signatur. Parameter brauchen keinen Namen (nur Typen fuer die Aufrufpruefung).
   "..." markiert eine variadische Funktion (wie printf) -- siehe tc_call/
   CALLEXT in docs/FORTSCHRITT.md fuer die Aufrufkonvention (Microware-ABI:
   1./2. Argument in d0/d1, Rest auf dem Stack; bei variadisch ALLES auf dem
   Stack). Erfordert mindestens einen benannten Parameter vor "...", wie in
   echtem ISO C. */
externDecl      = "extern" type pointerDecl externName "(" externParamList ")" ";" .
externName      = ident .
externParamList = [ externParam { "," externParam } [ "," ellipsisTok ] ] .
/* optionaler Parametername wird NUR geparst und verworfen (rein dokumentarisch,
   wie in echten C-Prototypen "int strcmp(const char *a, const char *b);") --
   fuer die Aufrufpruefung zaehlen nur die Typen. "const" ebenso rein
   dokumentarisch: eine extern-Deklaration hat keinen Tiny-C-Rumpf, in dem eine
   Schreibpruefung greifen koennte. */
externParam     = [ constKw ] type pointerDecl [ ident ] .
ellipsisTok     = "..." .

enumDecl  = "enum" ident "{" ident { "," ident } "}" ";" .

structDecl  = "struct" structName "{" structField { structField } "}" ";" .
structName  = ident .
structField = type fieldName [ arraySize ] ";" .
fieldName   = ident .

typedefDecl = "typedef" typedefType typedefTargetName ";" .
typedefType = anonStructType | type pointerDecl .
anonStructType = "struct" anonStructOpen structField { structField } "}" .
anonStructOpen = "{" .
typedefTargetName = ident .

/* zweite Dimension NUR bei globalDecl/localDecl (nicht bei structField/paramArray --
   siehe Kommentar bei localDecl weiter unten fuer den Umfang dieser Version). */
globalDecl = [ staticKw ] [ constKw ] type pointerDecl globalName [ arraySize [ arraySize2 ] ] [ "=" globalInit ] ";" .
constKw   = "const" .
staticKw  = "static" .
/* globalStringInit (2026-07-24): String-Literal als Array-Initialisierer
   (char msg[6] = "hallo";). Duplizierte, AKTIONSLOSE Kopie von stringLit
   OHNE eigene ACTION -- ein direkter Verweis auf stringLit wuerde dessen
   ACTION (tc_string: anonyme GARRAY-Konstante + Typ-Stack-Push) unwiderruflich
   mitausloesen, was fuer den globalen Kontext (tc_globalend liest die GANZE
   Deklaration ohnehin als Rohtext, wie bei Zahlen/Bools) nur unbenutzten Muell
   erzeugen wuerde. tc_globalend erkennt/dekodiert das Literal selbst per
   Rohtext-Scan (siehe dort), genau wie bei globalNumber/globalBool. */
globalInit = globalValue | initList | globalStringInit .
globalStringInit = "\042" { character } "\042" .
arraySize  = "[" globalNumber "]" .
arraySize2 = "[" globalNumber "]" .
globalValue = globalNumber | globalNeg | globalBool .
globalBool  = "true" | "false" .
globalNeg   = "-" globalNumber .
globalNumber = digit { digit } .

funcdef   = funcHead block .
funcHead  = [ staticKw ] type pointerDecl defName "(" paramList ")" .
paramList = [ param { "," param } ] .
param     = [ constKw ] type pointerDecl paramDecl .
paramDecl = paramName [ paramArray ] .
paramArray = "[" "]" .

block     = "{" { statement } "}" .

statement = ifStmt
          | whileStmt
          | forStmt
          | doStmt
          | switchStmt
          | breakStmt
          | continueStmt
          | returnStmt
          | block
          | callStmt
          | incDecStmt
          | assignStmt
          | staticVarDecl
          | varDecl .

/* "static" lokale Variablen erlauben NUR einen konstanten Initialisierer (globalValue,
   dieselbe seiteneffektfreie Regel wie bei globalen Variablen -- kein Durchlauf durch
   die normale expr-Grammatik, also auch keine Laufzeit-Emission dafuer). Ein NICHT-
   konstanter Ausdruck wuerde bei JEDEM Funktionsaufruf neu berechnet und gespeichert
   und die static-Variable faelschlich zuruecksetzen, statt sie nur einmalig zu
   initialisieren -- entspricht damit genau der Einschraenkung, die echtes C fuer
   static-Lokale ohnehin vorschreibt. */
staticVarDecl   = staticKw [ constKw ] type pointerDecl staticLocalName [ "=" globalValue ] ";" .
staticLocalName = ident .

switchStmt   = switchKw "(" switchCond ")" "{" { caseGroup } [ defaultGroup ] switchClose .
switchKw     = "switch" .
switchCond   = expr .
switchClose  = "}" .
caseGroup    = caseLabelRun caseBody .
caseLabelRun = caseLabel { caseLabel } .
caseLabel    = "case" caseValue ":" .
caseValue    = ident | caseNeg | caseNumber .
caseNeg      = "-" caseNumber .
caseNumber   = digit { digit } .
caseBody     = { statement } .
defaultGroup = defaultLabel caseBody .
defaultLabel = "default" ":" .

varDecl   = [ constKw ] type pointerDecl localDecl [ "=" varInit ] ";" .
/* zweidimensionale Arrays (2026-07-24): NUR bei lokalen/globalen Variablen, bewusst
   NICHT bei struct-Feldern (structField behaelt [ arraySize ] einstufig -- ein
   zweidimensionales struct-Feld ist damit ein sauberer Parse-Fehler statt eines
   still falsch geschnittenen Feldes, siehe tc_structfield) und NICHT bei Parametern
   (paramArray bleibt "[" "]"). Layout: Groesse = dim1*dim2 (zeilenweise/"row-major"
   wie in echtem C), dim2 wird fuers Indizieren gebraucht (siehe tc_localdecl/
   tc_globalend/tc_varref/tc_target) -- KEIN Initialisierer in dieser Version
   (waere ein eigener Aufwand analog zu initList, siehe docs/FORTSCHRITT.md). */
localDecl = localName [ arraySize [ arraySize2 ] ] .
/* arrayStringInit (2026-07-24, String-Literale als Array-Initialisierer,
   char msg[6] = "hallo";): MUSS vor expr probiert werden, sonst wuerde expr
   (via factor/stringLit) das Literal zuerst konsumieren. Referenziert
   stringLit bewusst DIREKT (anders als globalStringInit) -- dessen ACTION
   tc_string (anonyme GARRAY-Konstante + char*-Adresse auf den Stack) wird
   fuer den SKALAREN Fall (char* p = "..";) ohnehin gebraucht; tc_arrayinitstring
   verwirft die Adresse per DROP nur, wenn das Ziel tatsaechlich ein Array ist. */
varInit   = arrayStringInit | expr | initList .
arrayStringInit = stringLit .
initList  = "{" [ initValue { "," initValue } ] "}" .
initValue = initNumber | initNeg | initBool .
initBool  = "true" | "false" .
initNeg   = "-" initNumber .
initNumber = digit { digit } .
assignStmt = target assignop expr ";" .
assignop   = "=" | "+=" | "-=" | "*=" | "/=" | "%="
           | "<<=" | ">>=" | "&=" | "^=" | "|=" .
callStmt  = call ";" .
returnStmt = "return" [ retVal ] ";" .
retVal    = expr .

ifStmt    = ifKw "(" ifCond ")" thenPart [ elseKw elsePart ] .
ifKw      = "if" .
elseKw    = "else" .
ifCond    = expr .
thenPart  = statement .
elsePart  = statement .

whileStmt = whileKw "(" whileCond ")" whileBody .
whileKw   = "while" .
whileCond = expr .
whileBody = statement .

forStmt   = forKw "(" [ forInit ] forSep1 [ forCond ] forSep2 [ forStep ] forClose forBody .
forKw     = "for" .
forSep1   = ";" .
forSep2   = ";" .
forClose  = ")" .
forInit   = target assignop expr .
forCond   = expr .
forStep   = target assignop expr | postIncDec | preIncDec .
forBody   = statement .

doStmt    = doKw doBody doWhileTok "(" doCond ")" doClose .
doKw      = "do" .
doWhileTok = "while" .
doCond    = expr .
doClose   = ";" .
doBody    = statement .

breakStmt    = "break" ";" .
continueStmt = "continue" ";" .

expr       = conditionalExpr .
conditionalExpr = orExpr [ qmark conditionalTrue colon conditionalFalse ] .
qmark      = "?" .
conditionalTrue = expr .
colon      = ":" .
conditionalFalse = conditionalExpr .
orExpr     = andExpr [ orop orExpr ] .
orop       = "||" .
andExpr    = bitOrExpr [ andop andExpr ] .
andop      = "&&" .
bitOrExpr  = bitXorExpr [ bitorop bitOrExpr ] .
bitorop    = "|" .
bitXorExpr = bitAndExpr [ bitxorop bitXorExpr ] .
bitxorop   = "^" .
bitAndExpr = comparison [ bitandop bitAndExpr ] .
bitandop   = "&" .
comparison = shiftExpr [ relop shiftExpr ] .
shiftExpr  = addExpr { shiftop shiftRhs } .
shiftRhs   = addExpr .
shiftop    = "<<" | ">>" .
relop     = "<=" | ">=" | "==" | "!=" | "<" | ">" .
addExpr   = term { addop term } .
addop     = "+" | "-" .
term      = factor { mulop factor } .
mulop     = "*" | "/" | "%" .
factor    = sizeofExpr
          | castExpr
          | preIncDec
          | postIncDec
          | "(" expr ")"
          | call
          | boolLit
          | addressRef
          | derefRef
          | varRef
          | number
          | stringLit
          | negFactor .

/* String-Literal (2026-07-24): erzeugt zur Uebersetzungszeit einen anonymen globalen
   char-Array-Konstant (GARRAY/GINIT, siehe tc_string) und liefert dessen Adresse als
   Wert vom Typ char* -- exakt dieselben IR-Opcodes wie ein initialisiertes globales
   char-Array, kein neuer Opcode und keine Backend-Aenderung noetig (analog 2D-Arrays).
   Vorbild fuer die Grammatik: Data/oberon07.ebnf ("\042" ist der Oktal-Escape des
   EBNF-Tools fuer ein woertliches Anfuehrungszeichen, siehe Source/ebnf.cpp). character
   deckt den druckbaren ASCII-Bereich OHNE das Anfuehrungszeichen selbst ab (0x20-0x21,
   0x23-0x7E) -- Escapesequenzen wie \n werden ueber das ebenfalls im Bereich enthaltene
   "\" erkannt und in tc_string dekodiert, nicht in der Grammatik. Bewusst NICHT
   Teil dieser Version: String-Literale als Array-Initialisierer (char msg[6] = "hallo";)
   und String-Verkettung/-Vergleich als eigene Operatoren. */
stringLit = "\042" { character } "\042" .
character = " "~"!" | "#"~"~" .
negFactor = ( "-" | "!" | "~" ) factor .
addressRef = "&" ident [ index ] .

sizeofExpr = "sizeof" "(" sizeofArg ")" .
sizeofArg  = sizeofType | sizeofVarName .
sizeofType = "unsigned" unsignedInt | "int" | "char" | "bool" | "struct" structTypeRef .
sizeofVarName = ident .

castExpr   = "(" castType ")" castOperand .
castType   = "unsigned" unsignedInt | "int" | "char" | "bool" .
castOperand = factor .

preIncDec  = incdecOp ident .
postIncDec = ident incdecOp .
incdecOp   = "++" | "--" .
incDecStmt = preIncDec ";" | postIncDec ";" .
derefRef  = "*" factor .
call      = funcName "(" argList ")" .
argList   = [ arg { "," arg } ] .
arg       = expr .

target    = directTarget | indirectTarget .
/* zweiter index-Verweis auf dieselbe Regel deckt genau "arr[i][j]" ab (zwei
   AUFEINANDERFOLGENDE, nicht verschachtelte Klammerpaare) -- kein Grammatik-/
   Aktions-Zusatz noetig, ACTION AFTER index feuert einfach zweimal in Folge
   (die tcIndexDepth-Buchfuehrung ist bereits stapelbasiert, siehe tc_callname/
   tc_arg). Die eigentliche Zusammenfuehrung zu einem flachen Index passiert in
   tc_target/tc_varref (per Rohtext-Zaehlung der Top-Level-"["-Vorkommen). */
directTarget = ident [ index [ index ] | member ] .
indirectTarget = "*" factor .
varRef    = ident [ index [ index ] | member ] .
index     = indexOpen expr "]" .
indexOpen = "[" .
member    = "." fieldName .
defName   = ident .
paramName = ident .
localName = ident .
globalName = ident .
funcName  = ident .
type      = "unsigned" unsignedInt | "int" | "char" | "bool" | "struct" structTypeRef | "enum" enumTypeRef | "void" | typedefRef .
structTypeRef = ident .
enumTypeRef = ident .
typedefRef = ident .
pointerDecl = { pointerStar } .
pointerStar = "*" .
unsignedInt = "int" .
boolLit   = "true" | "false" .

ident     = letter { letter | digit } .
number    = digit { digit } .
letter    = "a"~"z" | "A"~"Z" | "_" .
digit     = "0"~"9" .
