program   = { globalDecl | structDecl | typedefDecl | enumDecl } { funcdef } .

enumDecl  = "enum" ident "{" ident { "," ident } "}" ";" .

structDecl  = "struct" structName "{" structField { structField } "}" ";" .
structName  = ident .
structField = type fieldName ";" .
fieldName   = ident .

typedefDecl = "typedef" type pointerDecl typedefTargetName ";" .
typedefTargetName = ident .

globalDecl = type pointerDecl globalName [ arraySize ] [ "=" globalInit ] ";" .
globalInit = globalValue | initList .
arraySize  = "[" globalNumber "]" .
globalValue = globalNumber | globalNeg | globalBool .
globalBool  = "true" | "false" .
globalNeg   = "-" globalNumber .
globalNumber = digit { digit } .

funcdef   = funcHead block .
funcHead  = type pointerDecl defName "(" paramList ")" .
paramList = [ param { "," param } ] .
param     = type pointerDecl paramDecl .
paramDecl = paramName [ paramArray ] .
paramArray = "[" "]" .

block     = "{" { statement } "}" .

statement = ifStmt
          | whileStmt
          | forStmt
          | doStmt
          | breakStmt
          | continueStmt
          | returnStmt
          | block
          | callStmt
          | assignStmt
          | varDecl .

varDecl   = type pointerDecl localDecl [ "=" varInit ] ";" .
localDecl = localName [ arraySize ] .
varInit   = expr | initList .
initList  = "{" [ initValue { "," initValue } ] "}" .
initValue = initNumber | initNeg | initBool .
initBool  = "true" | "false" .
initNeg   = "-" initNumber .
initNumber = digit { digit } .
assignStmt = target assignop expr ";" .
assignop   = "=" | "+=" | "-=" | "*=" | "/=" | "%="
           | "<<=" | ">>=" | "&=" | "^=" | "|=" .
callStmt  = call ";" .
returnStmt = "return" [ retVal ] ";" .
retVal    = expr .

ifStmt    = ifKw "(" ifCond ")" thenPart [ elseKw elsePart ] .
ifKw      = "if" .
elseKw    = "else" .
ifCond    = expr .
thenPart  = statement .
elsePart  = statement .

whileStmt = whileKw "(" whileCond ")" whileBody .
whileKw   = "while" .
whileCond = expr .
whileBody = statement .

forStmt   = forKw "(" [ forInit ] forSep1 [ forCond ] forSep2 [ forStep ] forClose forBody .
forKw     = "for" .
forSep1   = ";" .
forSep2   = ";" .
forClose  = ")" .
forInit   = target assignop expr .
forCond   = expr .
forStep   = target assignop expr .
forBody   = statement .

doStmt    = doKw doBody doWhileTok "(" doCond ")" doClose .
doKw      = "do" .
doWhileTok = "while" .
doCond    = expr .
doClose   = ";" .
doBody    = statement .

breakStmt    = "break" ";" .
continueStmt = "continue" ";" .

expr       = conditionalExpr .
conditionalExpr = orExpr [ qmark conditionalTrue colon conditionalFalse ] .
qmark      = "?" .
conditionalTrue = expr .
colon      = ":" .
conditionalFalse = conditionalExpr .
orExpr     = andExpr [ orop orExpr ] .
orop       = "||" .
andExpr    = bitOrExpr [ andop andExpr ] .
andop      = "&&" .
bitOrExpr  = bitXorExpr [ bitorop bitOrExpr ] .
bitorop    = "|" .
bitXorExpr = bitAndExpr [ bitxorop bitXorExpr ] .
bitxorop   = "^" .
bitAndExpr = comparison [ bitandop bitAndExpr ] .
bitandop   = "&" .
comparison = shiftExpr [ relop shiftExpr ] .
shiftExpr  = addExpr { shiftop shiftRhs } .
shiftRhs   = addExpr .
shiftop    = "<<" | ">>" .
relop     = "<=" | ">=" | "==" | "!=" | "<" | ">" .
addExpr   = term { addop term } .
addop     = "+" | "-" .
term      = factor { mulop factor } .
mulop     = "*" | "/" | "%" .
factor    = "(" expr ")"
          | call
          | boolLit
          | addressRef
          | derefRef
          | varRef
          | number
          | negFactor .
negFactor = ( "-" | "!" | "~" ) factor .
addressRef = "&" ident [ index ] .
derefRef  = "*" factor .
call      = funcName "(" argList ")" .
argList   = [ arg { "," arg } ] .
arg       = expr .

target    = directTarget | indirectTarget .
directTarget = ident [ index | member ] .
indirectTarget = "*" factor .
varRef    = ident [ index | member ] .
index     = indexOpen expr "]" .
indexOpen = "[" .
member    = "." fieldName .
defName   = ident .
paramName = ident .
localName = ident .
globalName = ident .
funcName  = ident .
type      = "unsigned" unsignedInt | "int" | "char" | "bool" | "struct" structTypeRef | typedefRef .
structTypeRef = ident .
typedefRef = ident .
pointerDecl = { pointerStar } .
pointerStar = "*" .
unsignedInt = "int" .
boolLit   = "true" | "false" .

ident     = letter { letter | digit } .
number    = digit { digit } .
letter    = "a"~"z" | "A"~"Z" | "_" .
digit     = "0"~"9" .
