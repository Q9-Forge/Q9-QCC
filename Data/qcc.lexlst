 <program>                        = { <globalDecl> 
                                  | <structDecl> 
                                  | <typedefDecl> 
                                  | <enumDecl> 
                                  | <externDecl> } { <funcdef> } .

 <externDecl>                     = "extern" <type> <pointerDecl> <externName> "(" <externParamList> ")" ";" .

 <externName>                     = <ident> .

 <externParamList>                = [ <externParam> { "," <externParam> } [ "," <ellipsisTok> ] ] .

 <externParam>                    = [ <constKw> ] <type> <pointerDecl> [ <ident> ] .

 <ellipsisTok>                    = "..." .

 <enumDecl>                       = "enum" <ident> "{" <ident> { "," <ident> } "}" ";" .

 <structDecl>                     = "struct" <structName> "{" <structField> { <structField> } "}" ";" .

 <structName>                     = <ident> .

 <structField>                    = <type> <pointerDecl> <fieldName> [ <arraySize> ] ";" .

 <fieldName>                      = <ident> .

 <typedefDecl>                    = "typedef" <typedefType> <typedefTargetName> ";" 
                                  | <fnPtrTypedef> .

 <fnPtrTypedef>                   = "typedef" <type> <pointerDecl> <fnPtrOpen> "*" <fnPtrName> ")" "(" <externParamList> ")" ";" .

 <fnPtrOpen>                      = "(" .

 <fnPtrName>                      = <ident> .

 <typedefType>                    = <anonStructType> 
                                  | <type> <pointerDecl> .

 <anonStructType>                 = "struct" <anonStructOpen> <structField> { <structField> } "}" .

 <anonStructOpen>                 = "{" .

 <typedefTargetName>              = <ident> .

 <globalDecl>                     = <externGlobalDecl> 
                                  | <plainGlobalDecl> .

 <externGlobalDecl>               = "extern" <type> <pointerDecl> <globalName> ";" .

 <plainGlobalDecl>                = [ <staticKw> ] [ <constKw> ] <type> <pointerDecl> <globalName> [ <arraySize> { <arraySizeN> } ] [ "=" <globalInit> ] ";" .

 <constKw>                        = "const" .

 <staticKw>                       = "static" .

 <globalInit>                     = <globalValue> 
                                  | <initList> 
                                  | <globalStringInit> .

 <globalStringInit>               = "\042" { <character> } "\042" .

 <arraySize>                      = "[" <globalNumber> "]" .

 <arraySizeN>                     = "[" <globalNumber> "]" .

 <globalValue>                    = <globalNumber> 
                                  | <globalNeg> 
                                  | <globalBool> .

 <globalBool>                     = "true" 
                                  | "false" .

 <globalNeg>                      = "-" <globalNumber> .

 <globalNumber>                   = <digit> { <digit> } .

 <funcdef>                        = <funcHead> ( <funcBody> 
                                  | <protoEnd> ) .

 <funcBody>                       = <funcBodyOpen> { <statement> } "}" .

 <funcBodyOpen>                   = "{" .

 <protoEnd>                       = ";" .

 <funcHead>                       = [ <staticKw> ] [ <retConstKw> ] <type> <pointerDecl> <defName> <funcParams> .

 <retConstKw>                     = "const" .

 <funcParams>                     = <voidParams> 
                                  | <normalParams> .

 <voidParams>                     = "(" "void" ")" .

 <normalParams>                   = "(" <paramList> ")" .

 <paramList>                      = [ <param> { "," <param> } ] .

 <param>                          = [ <constKw> ] <type> <pointerDecl> <paramDecl> .

 <paramDecl>                      = <paramName> [ <paramArray> ] .

 <paramArray>                     = "[" "]" .

 <block>                          = "{" { <statement> } "}" .

 <statement>                      = <labelStmt> 
                                  | <unlabeledStmt> .

 <unlabeledStmt>                  = <ifStmt> 
                                  | <whileStmt> 
                                  | <forStmt> 
                                  | <doStmt> 
                                  | <switchStmt> 
                                  | <breakStmt> 
                                  | <continueStmt> 
                                  | <gotoStmt> 
                                  | <returnStmt> 
                                  | <block> 
                                  | <emptyStmt> 
                                  | <voidCastStmt> 
                                  | <callStmt> 
                                  | <incDecStmt> 
                                  | <assignStmt> 
                                  | <staticVarDecl> 
                                  | <varDecl> .

 <staticVarDecl>                  = <staticKw> [ <constKw> ] <type> <pointerDecl> <staticLocalName> [ "=" <staticInit> ] ";" .

 <staticLocalName>                = <ident> .

 <staticInit>                     = <globalValue> 
                                  | <staticRuntimeInit> .

 <staticRuntimeInit>              = <expr> .

 <switchStmt>                     = <switchKw> "(" <switchCond> ")" "{" { <caseGroup> } [ <defaultGroup> ] <switchClose> .

 <switchKw>                       = "switch" .

 <switchCond>                     = <expr> .

 <switchClose>                    = "}" .

 <caseGroup>                      = <caseLabelRun> <caseBody> .

 <caseLabelRun>                   = <caseLabel> { <caseLabel> } .

 <caseLabel>                      = "case" <caseValue> ":" .

 <caseValue>                      = <ident> 
                                  | <caseNeg> 
                                  | <caseNumber> .

 <caseNeg>                        = "-" <caseNumber> .

 <caseNumber>                     = <digit> { <digit> } .

 <caseBody>                       = { <unlabeledStmt> } .

 <defaultGroup>                   = <defaultLabel> <caseBody> .

 <defaultLabel>                   = "default" ":" .

 <varDecl>                        = [ <constKw> ] <type> <pointerDecl> <varDeclarator> { "," <varDeclarator> } ";" .

 <varDeclarator>                  = <localDecl> [ "=" <varInit> ] .

 <localDecl>                      = <localName> [ <arraySize> { <arraySizeN> } ] .

 <varInit>                        = <arrayStringInit> 
                                  | <expr> 
                                  | <initList> .

 <arrayStringInit>                = <stringLit> .

 <initList>                       = "{" [ <initValue> { "," <initValue> } ] "}" .

 <initValue>                      = <initNumber> 
                                  | <initNeg> 
                                  | <initBool> .

 <initBool>                       = "true" 
                                  | "false" .

 <initNeg>                        = "-" <initNumber> .

 <initNumber>                     = <digit> { <digit> } .

 <assignStmt>                     = <target> <assignop> <expr> ";" .

 <assignop>                       = "=" 
                                  | "+=" 
                                  | "-=" 
                                  | "*=" 
                                  | "/=" 
                                  | "%=" 
                                  | "<<=" 
                                  | ">>=" 
                                  | "&=" 
                                  | "^=" 
                                  | "|=" .

 <callStmt>                       = <call> ";" 
                                  | <indirectCall> ";" .

 <emptyStmt>                      = ";" .

 <voidCastStmt>                   = <voidCastOpen> <expr> ";" .

 <voidCastOpen>                   = "(" "void" ")" .

 <returnStmt>                     = "return" [ <retVal> ] ";" .

 <retVal>                         = <expr> .

 <ifStmt>                         = <ifKw> "(" <ifCond> ")" <thenPart> [ <elseKw> <elsePart> ] .

 <ifKw>                           = "if" .

 <elseKw>                         = "else" .

 <ifCond>                         = <expr> .

 <thenPart>                       = <statement> .

 <elsePart>                       = <statement> .

 <whileStmt>                      = <whileKw> "(" <whileCond> ")" <whileBody> .

 <whileKw>                        = "while" .

 <whileCond>                      = <expr> .

 <whileBody>                      = <statement> .

 <forStmt>                        = <forKw> "(" [ <forInit> ] <forSep1> [ <forCond> ] <forSep2> [ <forStep> ] <forClose> <forBody> .

 <forKw>                          = "for" .

 <forSep1>                        = ";" .

 <forSep2>                        = ";" .

 <forClose>                       = ")" .

 <forInit>                        = <target> <assignop> <expr> .

 <forCond>                        = <expr> .

 <forStep>                        = <target> <assignop> <expr> 
                                  | <postIncDec> 
                                  | <preIncDec> .

 <forBody>                        = <statement> .

 <doStmt>                         = <doKw> <doBody> <doWhileTok> "(" <doCond> ")" <doClose> .

 <doKw>                           = "do" .

 <doWhileTok>                     = "while" .

 <doCond>                         = <expr> .

 <doClose>                        = ";" .

 <doBody>                         = <statement> .

 <breakStmt>                      = "break" ";" .

 <continueStmt>                   = "continue" ";" .

 <gotoStmt>                       = "goto" <ident> ";" .

 <labelStmt>                      = <ident> ":" .

 <expr>                           = <conditionalExpr> .

 <conditionalExpr>                = <orExpr> [ <qmark> <conditionalTrue> <colon> <conditionalFalse> ] .

 <qmark>                          = "?" .

 <conditionalTrue>                = <expr> .

 <colon>                          = ":" .

 <conditionalFalse>               = <conditionalExpr> .

 <orExpr>                         = <andExpr> [ <orop> <orExpr> ] .

 <orop>                           = "||" .

 <andExpr>                        = <bitOrExpr> [ <andop> <andExpr> ] .

 <andop>                          = "&&" .

 <bitOrExpr>                      = <bitXorExpr> [ <bitorop> <bitOrExpr> ] .

 <bitorop>                        = "|" .

 <bitXorExpr>                     = <bitAndExpr> [ <bitxorop> <bitXorExpr> ] .

 <bitxorop>                       = "^" .

 <bitAndExpr>                     = <comparison> [ <bitandop> <bitAndExpr> ] .

 <bitandop>                       = "&" .

 <comparison>                     = <shiftExpr> [ <relop> <shiftExpr> ] .

 <shiftExpr>                      = <addExpr> { <shiftop> <shiftRhs> } .

 <shiftRhs>                       = <addExpr> .

 <shiftop>                        = "<<" 
                                  | ">>" .

 <relop>                          = "<=" 
                                  | ">=" 
                                  | "==" 
                                  | "!=" 
                                  | "<" 
                                  | ">" .

 <addExpr>                        = <term> { <addop> <term> } .

 <addop>                          = "+" 
                                  | "-" .

 <term>                           = <factor> { <mulop> <factor> } .

 <mulop>                          = "*" 
                                  | "/" 
                                  | "%" .

 <factor>                         = <sizeofExpr> 
                                  | <castExpr> 
                                  | <preIncDec> 
                                  | <postIncDec> 
                                  | "(" <expr> ")" 
                                  | <call> [ <postfixIndex> ] 
                                  | <indirectCall> 
                                  | <boolLit> 
                                  | <addressRef> 
                                  | <derefRef> 
                                  | <varRef> 
                                  | <charLit> 
                                  | <number> 
                                  | <stringLit> [ <postfixIndex> ] 
                                  | <negFactor> .

 <postfixIndex>                   = <index> .

 <stringLit>                      = "\042" { <character> } "\042" .

 <charLit>                        = "\047" <charLitBody> "\047" .

 <charLitBody>                    = <charLitEscape> 
                                  | <charLitPlain> .

 <charLitEscape>                  = "\134" <charLitEscChar> .

 <charLitEscChar>                 = "n" 
                                  | "t" 
                                  | "r" 
                                  | "0" 
                                  | "\134" .

 <charLitPlain>                   = " "~"&" 
                                  | "("~"[" 
                                  | "]"~"~" .

 <character>                      = <strEscape> 
                                  | " "~"!" 
                                  | "#"~"~" .

 <strEscape>                      = "\134" <strEscChar> .

 <strEscChar>                     = " "~"~" .

 <negFactor>                      = ( "-" 
                                  | "!" 
                                  | "~" ) <factor> .

 <addressRef>                     = "&" <ident> [ <index> ] .

 <sizeofExpr>                     = "sizeof" "(" <sizeofArg> ")" .

 <sizeofArg>                      = <sizeofType> 
                                  | <sizeofVarName> .

 <sizeofType>                     = "unsigned" <unsignedInt> 
                                  | "int" 
                                  | "char" 
                                  | "bool" 
                                  | "struct" <structTypeRef> .

 <sizeofVarName>                  = <ident> .

 <castExpr>                       = "(" <castType> ")" <castOperand> .

 <castType>                       = "unsigned" <unsignedInt> 
                                  | "int" 
                                  | "char" 
                                  | "bool" .

 <castOperand>                    = <factor> .

 <preIncDec>                      = <incdecOp> <ident> .

 <postIncDec>                     = <ident> <incdecOp> .

 <incdecOp>                       = "++" 
                                  | "--" .

 <incDecStmt>                     = <preIncDec> ";" 
                                  | <postIncDec> ";" .

 <derefRef>                       = "*" <factor> .

 <call>                           = <funcName> "(" <argList> ")" .

 <indirectCall>                   = <varRef> <indCallOpen> <argList> ")" .

 <indCallOpen>                    = "(" .

 <argList>                        = [ <arg> { "," <arg> } ] .

 <arg>                            = <expr> .

 <target>                         = <directTarget> 
                                  | <indirectTarget> .

 <directTarget>                   = <ident> [ <index> { <index> } ] [ <member> [ <index> ] ] .

 <indirectTarget>                 = "*" <factor> .

 <varRef>                         = <ident> [ <index> { <index> } ] [ <member> [ <index> ] ] .

 <index>                          = <indexOpen> <expr> "]" .

 <indexOpen>                      = "[" .

 <member>                         = "." <fieldName> .

 <defName>                        = <ident> .

 <paramName>                      = <ident> .

 <localName>                      = <ident> .

 <globalName>                     = <ident> .

 <funcName>                       = <ident> .

 <type>                           = "unsigned" <unsignedInt> 
                                  | "int" 
                                  | "long" 
                                  | "char" 
                                  | "bool" 
                                  | "struct" <structTypeRef> 
                                  | "enum" <enumTypeRef> 
                                  | "void" 
                                  | <typedefRef> .

 <structTypeRef>                  = <ident> .

 <enumTypeRef>                    = <ident> .

 <typedefRef>                     = <ident> .

 <pointerDecl>                    = { <pointerStar> } .

 <pointerStar>                    = "*" .

 <unsignedInt>                    = "int" 
                                  | "char" 
                                  | "long" .

 <boolLit>                        = "true" 
                                  | "false" .

 <ident>                          = <letter> { <letter> 
                                  | <digit> } .

 <number>                         = <digit> { <digit> } .

 <letter>                         = "a"~"z" 
                                  | "A"~"Z" 
                                  | "_" .

 <digit>                          = "0"~"9" .

