#================================================================================
# EBNF-ARBEITSDATEI -- automatisch erzeugt von ebnf
# Die Bloecke [TESTS] und [NUTZER-CODE] sind zum Editieren gedacht und bleiben
# beim Neu-Erzeugen erhalten. NUTZER-CODE ist vorbereitet, wird aber noch nicht
# in C/68k eingebunden (Format/Architektur: docs/ARCHITEKTUR.md).
# Existiert <basis>.ebnf, ist IMMER die .ebnf die Wahrheit; ohne .ebnf
# kann diese Datei direkt als Grammatik geladen werden (PARSER-TABELLE-Block).
#================================================================================

[EBNF-QUELLTEXT]
 <program>                        = { <funcdef> } .

 <funcdef>                        = <funcHead> <block> .

 <funcHead>                       = "int" <defName> "(" <paramList> ")" .

 <paramList>                      = [ <param> { "," <param> } ] .

 <param>                          = "int" <paramName> .

 <block>                          = "{" { <statement> } "}" .

 <statement>                      = <varDecl> 
                                  | <ifStmt> 
                                  | <whileStmt> 
                                  | <returnStmt> 
                                  | <block> 
                                  | <callStmt> 
                                  | <assignStmt> .

 <varDecl>                        = "int" <localName> [ "=" <varInit> ] ";" .

 <varInit>                        = <expr> .

 <assignStmt>                     = <target> "=" <expr> ";" .

 <callStmt>                       = <call> ";" .

 <returnStmt>                     = "return" [ <retVal> ] ";" .

 <retVal>                         = <expr> .

 <ifStmt>                         = <ifKw> "(" <ifCond> ")" <thenPart> [ <elseKw> <elsePart> ] .

 <ifKw>                           = "if" .

 <elseKw>                         = "else" .

 <ifCond>                         = <expr> .

 <thenPart>                       = <statement> .

 <elsePart>                       = <statement> .

 <whileStmt>                      = <whileKw> "(" <whileCond> ")" <whileBody> .

 <whileKw>                        = "while" .

 <whileCond>                      = <expr> .

 <whileBody>                      = <statement> .

 <expr>                           = <addExpr> [ <relop> <addExpr> ] .

 <relop>                          = "<=" 
                                  | ">=" 
                                  | "==" 
                                  | "!=" 
                                  | "<" 
                                  | ">" .

 <addExpr>                        = <term> { <addop> <term> } .

 <addop>                          = "+" 
                                  | "-" .

 <term>                           = <factor> { <mulop> <factor> } .

 <mulop>                          = "*" 
                                  | "/" .

 <factor>                         = "(" <expr> ")" 
                                  | <call> 
                                  | <varRef> 
                                  | <number> 
                                  | <negFactor> .

 <negFactor>                      = "-" <factor> .

 <call>                           = <funcName> "(" <argList> ")" .

 <argList>                        = [ <arg> { "," <arg> } ] .

 <arg>                            = <expr> .

 <target>                         = <ident> .

 <varRef>                         = <ident> .

 <defName>                        = <ident> .

 <paramName>                      = <ident> .

 <localName>                      = <ident> .

 <funcName>                       = <ident> .

 <ident>                          = <letter> { <letter> 
                                  | <digit> } .

 <number>                         = <digit> { <digit> } .

 <letter>                         = "a"~"z" 
                                  | "A"~"Z" 
                                  | "_" .

 <digit>                          = "0"~"9" .

[ENDE]

