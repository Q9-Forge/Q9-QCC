[TESTS]
# TEST "<eingabe>" OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt
[ENDE]

[LEXER]
WHITESPACE = " \t\r\n"
TOKEN ident
TOKEN number
COMMENT LINE = "//"
COMMENT BLOCK = "/*" "*/"
[ENDE]

[CODEGEN]
# Optional: Ausgabe-Optionen der Codegenerierung.
# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)
# M68K PSECT = name      (psect-Name, Default: <basisname>_p)
[ENDE]

[NUTZER-CODE]
# Tiny-C Frontend (Meilenstein 1): Aktionen emittieren Stack-IR nach stdout.
# Siehe docs/ARCHITEKTUR.md Kapitel 10. Nur ROUTINE C (IR-Emission), analog calcexpr.
ACTION AFTER defName CALL tc_defname
ACTION AFTER paramName CALL tc_param
ACTION AFTER funcHead CALL tc_funcbegin
ACTION AFTER funcdef CALL tc_funcend
ACTION AFTER localName CALL tc_local
ACTION AFTER varInit CALL tc_varinit
ACTION AFTER number CALL tc_number
ACTION AFTER varRef CALL tc_varref
ACTION AFTER negFactor CALL tc_neg
ACTION AFTER addop CALL tc_addop
ACTION AFTER term CALL tc_term
ACTION AFTER mulop CALL tc_mulop
ACTION AFTER factor CALL tc_factor
ACTION AFTER relop CALL tc_relop
ACTION AFTER expr CALL tc_expr
ACTION AFTER target CALL tc_target
ACTION AFTER assignStmt CALL tc_assign
ACTION AFTER funcName CALL tc_callname
ACTION AFTER arg CALL tc_arg
ACTION AFTER call CALL tc_call
ACTION AFTER callStmt CALL tc_callstmt
ACTION AFTER retVal CALL tc_retval
ACTION AFTER returnStmt CALL tc_return
ROUTINE C tc_defname
/* ---- Tiny-C Frontend: globaler Zustand + Helfer (ARCHITEKTUR.md Kap.10) ---- */
static char tcNames[64][32];        /* lokale Variablen der aktuellen Funktion */
static int  tcLocalCount = 0;
static char tcFuncName[32];
static char tcCallName[32];
static char tcPendingAdd = 0;       /* '+' oder '-' */
static char tcPendingMul = 0;       /* '*' oder '/' */
static char tcRel0 = 0, tcRel1 = 0; /* Relop-Zeichen; tcRel1==0 wenn einstellig */
static int  tcTargetSlot = -1;
static int  tcArgCount = 0;
static int  tcRetHasVal = 0;
static int  tcLastWasPrint = 0;
static void tcCopy(char* dst, const char* s, const char* e) {
	int n = 0; const char* q;
	for (q = s; q < e && n < 31; q++) dst[n++] = *q;
	dst[n] = 0;
}
static int tcEq(const char* a, const char* b) {
	while (*a && *b) { if (*a != *b) return 0; a++; b++; }
	return *a == *b;
}
static int tcLookup(const char* s, const char* e) {
	char name[32]; int i; tcCopy(name, s, e);
	for (i = 0; i < tcLocalCount; i++) if (tcEq(tcNames[i], name)) return i;
	return -1;
}
static long tcNum(const char* s, const char* e) {
	long v = 0; const char* q;
	for (q = s; q < e; q++) v = v * 10 + (*q - '0');
	return v;
}
void tc_defname(const char* start, const char* end) {
	tcLocalCount = 0;
	tcCopy(tcFuncName, start, end);
}
END
ROUTINE C tc_param
void tc_param(const char* start, const char* end) {
	tcCopy(tcNames[tcLocalCount], start, end);
	tcLocalCount++;
}
END
ROUTINE C tc_funcbegin
void tc_funcbegin(const char* start, const char* end) {
	(void)start; (void)end;
	printf("FUNC %s %d\n", tcFuncName, tcLocalCount);
}
END
ROUTINE C tc_funcend
void tc_funcend(const char* start, const char* end) {
	(void)start; (void)end;
	/* Fallthrough-Rueckgabe 0 absichern; ein explizites return davor ist harmlos */
	printf("PUSH 0\nRET\nENDFUNC\n");
}
END
ROUTINE C tc_local
void tc_local(const char* start, const char* end) {
	tcCopy(tcNames[tcLocalCount], start, end);
	tcLocalCount++;
}
END
ROUTINE C tc_varinit
void tc_varinit(const char* start, const char* end) {
	(void)start; (void)end;
	printf("STOREL %d\n", tcLocalCount - 1);
}
END
ROUTINE C tc_number
void tc_number(const char* start, const char* end) {
	printf("PUSH %ld\n", tcNum(start, end));
}
END
ROUTINE C tc_varref
void tc_varref(const char* start, const char* end) {
	printf("LOADL %d\n", tcLookup(start, end));
}
END
ROUTINE C tc_neg
void tc_neg(const char* start, const char* end) {
	(void)start; (void)end;
	printf("NEG\n");
}
END
ROUTINE C tc_addop
void tc_addop(const char* start, const char* end) {
	(void)end;
	tcPendingAdd = *start;
}
END
ROUTINE C tc_term
void tc_term(const char* start, const char* end) {
	(void)start; (void)end;
	if (tcPendingAdd) {
		printf("%s", tcPendingAdd == '+' ? "ADD\n" : "SUB\n");
		tcPendingAdd = 0;
	}
}
END
ROUTINE C tc_mulop
void tc_mulop(const char* start, const char* end) {
	(void)end;
	tcPendingMul = *start;
}
END
ROUTINE C tc_factor
void tc_factor(const char* start, const char* end) {
	(void)start; (void)end;
	if (tcPendingMul) {
		printf("%s", tcPendingMul == '*' ? "MUL\n" : "DIV\n");
		tcPendingMul = 0;
	}
}
END
ROUTINE C tc_relop
void tc_relop(const char* start, const char* end) {
	tcRel0 = start[0];
	tcRel1 = (end - start > 1) ? start[1] : 0;
}
END
ROUTINE C tc_expr
void tc_expr(const char* start, const char* end) {
	(void)start; (void)end;
	if (tcRel0) {
		if (tcRel1 == '=') {
			if (tcRel0 == '<') printf("CMPLE\n");
			else if (tcRel0 == '>') printf("CMPGE\n");
			else if (tcRel0 == '=') printf("CMPEQ\n");
			else if (tcRel0 == '!') printf("CMPNE\n");
		} else {
			if (tcRel0 == '<') printf("CMPLT\n");
			else if (tcRel0 == '>') printf("CMPGT\n");
		}
		tcRel0 = 0; tcRel1 = 0;
	}
}
END
ROUTINE C tc_target
void tc_target(const char* start, const char* end) {
	tcTargetSlot = tcLookup(start, end);
}
END
ROUTINE C tc_assign
void tc_assign(const char* start, const char* end) {
	(void)start; (void)end;
	printf("STOREL %d\n", tcTargetSlot);
}
END
ROUTINE C tc_callname
void tc_callname(const char* start, const char* end) {
	tcCopy(tcCallName, start, end);
	tcArgCount = 0;
}
END
ROUTINE C tc_arg
void tc_arg(const char* start, const char* end) {
	(void)start; (void)end;
	tcArgCount++;
}
END
ROUTINE C tc_call
void tc_call(const char* start, const char* end) {
	(void)start; (void)end;
	if (tcEq(tcCallName, "putint")) {
		printf("PRINT\n");
		tcLastWasPrint = 1;
	} else {
		printf("CALL %s %d\n", tcCallName, tcArgCount);
		tcLastWasPrint = 0;
	}
}
END
ROUTINE C tc_callstmt
void tc_callstmt(const char* start, const char* end) {
	(void)start; (void)end;
	if (!tcLastWasPrint) printf("DROP\n");
}
END
ROUTINE C tc_retval
void tc_retval(const char* start, const char* end) {
	(void)start; (void)end;
	tcRetHasVal = 1;
}
END
ROUTINE C tc_return
void tc_return(const char* start, const char* end) {
	(void)start; (void)end;
	if (!tcRetHasVal) printf("PUSH 0\n");
	printf("RET\n");
	tcRetHasVal = 0;
}
END
[ENDE]
