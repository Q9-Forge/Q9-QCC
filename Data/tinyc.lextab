ROUTINE C tc_structbegin
void tc_structbegin(const char* start, const char* end) {
	tcCopy(tcStructBuildName, start, end);
	tcStructBuildFieldCount = 0;
}
END
ROUTINE C tc_structfield
void tc_structfield(const char* start, const char* end) {
	/* Spanne deckt "type fieldName ;" ab -- Feldname ist das letzte Wort vor ';'. */
	const char* p = end - 1; const char* fieldEnd; const char* fieldStart;
	while (p > start && (*p == ' ' || *p == '\t' || *p == ';')) p--;
	fieldEnd = p + 1;
	while (p > start && *(p - 1) != ' ' && *(p - 1) != '\t') p--;
	fieldStart = p;
	if (tcStructBuildFieldCount == 0) tcStructBuildFieldType = tcCurrentType;
	else if (!tcSameType(tcCurrentType, tcStructBuildFieldType)) {
		fprintf(stderr, "tinyc: struct fields must share one type in this version\n"); tcSemanticErrors++;
	}
	if (tcStructBuildFieldCount < MAX_STRUCT_FIELDS) {
		tcCopy(tcStructBuildFieldNames[tcStructBuildFieldCount], fieldStart, fieldEnd);
		tcStructBuildFieldCount++;
	} else { fprintf(stderr, "tinyc: too many struct fields\n"); tcSemanticErrors++; }
}
END
ROUTINE C tc_structend
void tc_structend(const char* start, const char* end) {
	int i; (void)start; (void)end;
	if (tcStructCount >= MAX_STRUCTS) { fprintf(stderr, "tinyc: too many structs\n"); tcSemanticErrors++; return; }
	for (i = 0; i < tcStructCount; i++) if (tcEq(tcStructNames[i], tcStructBuildName)) { fprintf(stderr, "tinyc: duplicate struct\n"); tcSemanticErrors++; return; }
	if (tcStructBuildFieldCount == 0) { fprintf(stderr, "tinyc: struct needs at least one field\n"); tcSemanticErrors++; return; }
	tcCopy(tcStructNames[tcStructCount], tcStructBuildName, tcStructBuildName + strlen(tcStructBuildName));
	tcStructFieldCount[tcStructCount] = tcStructBuildFieldCount;
	tcStructFieldType[tcStructCount] = tcStructBuildFieldType;
	for (i = 0; i < tcStructBuildFieldCount; i++)
		tcCopy(tcStructFieldNames[tcStructCount][i], tcStructBuildFieldNames[i], tcStructBuildFieldNames[i] + strlen(tcStructBuildFieldNames[i]));
	tcStructCount++;
}
END
ROUTINE C tc_typedefend
void tc_typedefend(const char* start, const char* end) {
	/* Spanne deckt "typedef type pointerDecl Name ;" ab -- Name ist das letzte Wort vor ';'. */
	const char* p = end - 1; const char* nameEnd; const char* nameStart;
	while (p > start && (*p == ' ' || *p == '\t' || *p == ';')) p--;
	nameEnd = p + 1;
	while (p > start && *(p - 1) != ' ' && *(p - 1) != '\t' && *(p - 1) != '*') p--;
	nameStart = p;
	if (tcTypedefCount >= MAX_TYPEDEFS) { fprintf(stderr, "tinyc: too many typedefs\n"); tcSemanticErrors++; return; }
	if (tcLookupTypedef(nameStart, nameEnd) >= 0) { fprintf(stderr, "tinyc: duplicate typedef\n"); tcSemanticErrors++; return; }
	tcCopy(tcTypedefNames[tcTypedefCount], nameStart, nameEnd);
	tcTypedefTypes[tcTypedefCount] = tcCurrentType;
	tcTypedefCount++;
}
END
ROUTINE C tc_logicandop
void tc_logicandop(const char* start, const char* end) {
	(void)start; (void)end;
	tcLogicBegin('&');
}
END
ROUTINE C tc_logicandend
void tc_logicandend(const char* start, const char* end) {
	if (tcHasTopToken(start, end, '&', '&')) tcLogicEnd('&');
}
END
ROUTINE C tc_logicorop
void tc_logicorop(const char* start, const char* end) {
	(void)start; (void)end;
	tcLogicBegin('|');
}
END
ROUTINE C tc_logicorend
void tc_logicorend(const char* start, const char* end) {
	if (tcHasTopToken(start, end, '|', '|')) tcLogicEnd('|');
}
END
ROUTINE C tc_bitandop
void tc_bitandop(const char* start, const char* end) {
	(void)start; (void)end;
	tcBitBegin('&');
}
END
ROUTINE C tc_bitandend
void tc_bitandend(const char* start, const char* end) {
	if (tcHasTopChar(start, end, '&') && tcBitDepth > 0 && tcBitKind[tcBitDepth - 1] == '&') tcBitEnd('&');
}
END
ROUTINE C tc_bitxorop
void tc_bitxorop(const char* start, const char* end) {
	(void)start; (void)end;
	tcBitBegin('^');
}
END
ROUTINE C tc_bitxorend
void tc_bitxorend(const char* start, const char* end) {
	if (tcHasTopChar(start, end, '^') && tcBitDepth > 0 && tcBitKind[tcBitDepth - 1] == '^') tcBitEnd('^');
}
END
ROUTINE C tc_bitorop
void tc_bitorop(const char* start, const char* end) {
	(void)start; (void)end;
	tcBitBegin('|');
}
END
ROUTINE C tc_bitorend
void tc_bitorend(const char* start, const char* end) {
	if (tcHasTopChar(start, end, '|') && tcBitDepth > 0 && tcBitKind[tcBitDepth - 1] == '|') tcBitEnd('|');
}
END
ROUTINE C tc_shiftop
void tc_shiftop(const char* start, const char* end) {
	(void)end;
	tcPendingShift0 = start[0];
	tcPendingShift1 = start[1];
}
END
ROUTINE C tc_shiftrhs
void tc_shiftrhs(const char* start, const char* end) {
	(void)start; (void)end;
	if (tcPendingShift0 && tcPendingShift1) tcShiftEnd();
}
END
ROUTINE C tc_ternarybegin
void tc_ternarybegin(const char* start, const char* end) {
	(void)start; (void)end;
	tcTernaryBegin();
}
END
ROUTINE C tc_ternarymiddle
void tc_ternarymiddle(const char* start, const char* end) {
	(void)start; (void)end;
	tcTernaryMiddle();
}
END
ROUTINE C tc_ternaryend
void tc_ternaryend(const char* start, const char* end) {
	if (tcHasChar(start, end, '?')) tcTernaryEnd();
}
END
[ENDE]
