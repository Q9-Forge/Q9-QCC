ROUTINE C tc_break
void tc_break(const char* start, const char* end) {
	int frame = tcFindLoop(); (void)start; (void)end;
	if (frame < 0) { fprintf(stderr, "tinyc: break outside loop\n"); tcSemanticErrors++; return; }
	printf("JMP L%d\n", tcCtrlEnd[frame]);
}
END
