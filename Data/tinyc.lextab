	TCType condition = tcTypePop(); (void)start; (void)end;
	if (!tcIsBool(condition)) tcTypeError("if condition", tcMakeType('b', 0), condition);
	if (!tcNeedCtrl('i')) return;
	printf("JZ L%d\n", tcCtrlTop[tcCtrlDepth - 1]);
}
END
