#================================================================================
# EBNF-ARBEITSDATEI -- automatisch erzeugt von ebnf
# Die Bloecke [TESTS] und [NUTZER-CODE] sind zum Editieren gedacht und bleiben
# beim Neu-Erzeugen erhalten. NUTZER-CODE ist vorbereitet, wird aber noch nicht
# in C/68k eingebunden (Format/Architektur: docs/ARCHITEKTUR.md).
# Existiert <basis>.ebnf, ist IMMER die .ebnf die Wahrheit; ohne .ebnf
# kann diese Datei direkt als Grammatik geladen werden (PARSER-TABELLE-Block).
#================================================================================

[EBNF-QUELLTEXT]
 <program>                        = { <globalDecl> 
                                  | <structDecl> 
                                  | <typedefDecl> 
                                  | <enumDecl> } { <funcdef> } .

 <enumDecl>                       = "enum" <ident> "{" <ident> { "," <ident> } "}" ";" .

 <structDecl>                     = "struct" <structName> "{" <structField> { <structField> } "}" ";" .

 <structName>                     = <ident> .

 <structField>                    = <type> <fieldName> ";" .

 <fieldName>                      = <ident> .

 <typedefDecl>                    = "typedef" <typedefType> <typedefTargetName> ";" .

 <typedefType>                    = <anonStructType> 
                                  | <type> <pointerDecl> .

 <anonStructType>                 = "struct" <anonStructOpen> <structField> { <structField> } "}" .

 <anonStructOpen>                 = "{" .

 <typedefTargetName>              = <ident> .

 <globalDecl>                     = [ <staticKw> ] [ <constKw> ] <type> <pointerDecl> <globalName> [ <arraySize> ] [ "=" <globalInit> ] ";" .

 <constKw>                        = "const" .

 <staticKw>                       = "static" .

 <globalInit>                     = <globalValue> 
                                  | <initList> .

 <arraySize>                      = "[" <globalNumber> "]" .

 <globalValue>                    = <globalNumber> 
                                  | <globalNeg> 
                                  | <globalBool> .

 <globalBool>                     = "true" 
                                  | "false" .

 <globalNeg>                      = "-" <globalNumber> .

 <globalNumber>                   = <digit> { <digit> } .

 <funcdef>                        = <funcHead> <block> .

 <funcHead>                       = [ <staticKw> ] <type> <pointerDecl> <defName> "(" <paramList> ")" .

 <paramList>                      = [ <param> { "," <param> } ] .

 <param>                          = [ <constKw> ] <type> <pointerDecl> <paramDecl> .

 <paramDecl>                      = <paramName> [ <paramArray> ] .

 <paramArray>                     = "[" "]" .

 <block>                          = "{" { <statement> } "}" .

 <statement>                      = <ifStmt> 
                                  | <whileStmt> 
                                  | <forStmt> 
                                  | <doStmt> 
                                  | <switchStmt> 
                                  | <breakStmt> 
                                  | <continueStmt> 
                                  | <returnStmt> 
                                  | <block> 
                                  | <callStmt> 
                                  | <incDecStmt> 
                                  | <assignStmt> 
                                  | <staticVarDecl> 
                                  | <varDecl> .

 <staticVarDecl>                  = <staticKw> [ <constKw> ] <type> <pointerDecl> <staticLocalName> ";" .

 <staticLocalName>                = <ident> .

 <switchStmt>                     = <switchKw> "(" <switchCond> ")" "{" { <caseGroup> } [ <defaultGroup> ] <switchClose> .

 <switchKw>                       = "switch" .

 <switchCond>                     = <expr> .

 <switchClose>                    = "}" .

 <caseGroup>                      = <caseLabelRun> <caseBody> .

 <caseLabelRun>                   = <caseLabel> { <caseLabel> } .

 <caseLabel>                      = "case" <caseValue> ":" .

 <caseValue>                      = <ident> 
                                  | <caseNeg> 
                                  | <caseNumber> .

 <caseNeg>                        = "-" <caseNumber> .

 <caseNumber>                     = <digit> { <digit> } .

 <caseBody>                       = { <statement> } .

 <defaultGroup>                   = <defaultLabel> <caseBody> .

 <defaultLabel>                   = "default" ":" .

 <varDecl>                        = [ <constKw> ] <type> <pointerDecl> <localDecl> [ "=" <varInit> ] ";" .

 <localDecl>                      = <localName> [ <arraySize> ] .

 <varInit>                        = <expr> 
                                  | <initList> .

 <initList>                       = "{" [ <initValue> { "," <initValue> } ] "}" .

 <initValue>                      = <initNumber> 
                                  | <initNeg> 
                                  | <initBool> .

 <initBool>                       = "true" 
                                  | "false" .

 <initNeg>                        = "-" <initNumber> .

 <initNumber>                     = <digit> { <digit> } .

 <assignStmt>                     = <target> <assignop> <expr> ";" .

 <assignop>                       = "=" 
                                  | "+=" 
                                  | "-=" 
                                  | "*=" 
                                  | "/=" 
                                  | "%=" 
                                  | "<<=" 
                                  | ">>=" 
                                  | "&=" 
                                  | "^=" 
                                  | "|=" .

 <callStmt>                       = <call> ";" .

 <returnStmt>                     = "return" [ <retVal> ] ";" .

 <retVal>                         = <expr> .

 <ifStmt>                         = <ifKw> "(" <ifCond> ")" <thenPart> [ <elseKw> <elsePart> ] .

 <ifKw>                           = "if" .

 <elseKw>                         = "else" .

 <ifCond>                         = <expr> .

 <thenPart>                       = <statement> .

 <elsePart>                       = <statement> .

 <whileStmt>                      = <whileKw> "(" <whileCond> ")" <whileBody> .

 <whileKw>                        = "while" .

 <whileCond>                      = <expr> .

 <whileBody>                      = <statement> .

 <forStmt>                        = <forKw> "(" [ <forInit> ] <forSep1> [ <forCond> ] <forSep2> [ <forStep> ] <forClose> <forBody> .

 <forKw>                          = "for" .

 <forSep1>                        = ";" .

 <forSep2>                        = ";" .

 <forClose>                       = ")" .

 <forInit>                        = <target> <assignop> <expr> .

 <forCond>                        = <expr> .

 <forStep>                        = <target> <assignop> <expr> 
                                  | <postIncDec> 
                                  | <preIncDec> .

 <forBody>                        = <statement> .

 <doStmt>                         = <doKw> <doBody> <doWhileTok> "(" <doCond> ")" <doClose> .

 <doKw>                           = "do" .

 <doWhileTok>                     = "while" .

 <doCond>                         = <expr> .

 <doClose>                        = ";" .

 <doBody>                         = <statement> .

 <breakStmt>                      = "break" ";" .

 <continueStmt>                   = "continue" ";" .

 <expr>                           = <conditionalExpr> .

 <conditionalExpr>                = <orExpr> [ <qmark> <conditionalTrue> <colon> <conditionalFalse> ] .

 <qmark>                          = "?" .

 <conditionalTrue>                = <expr> .

 <colon>                          = ":" .

 <conditionalFalse>               = <conditionalExpr> .

 <orExpr>                         = <andExpr> [ <orop> <orExpr> ] .

 <orop>                           = "||" .

 <andExpr>                        = <bitOrExpr> [ <andop> <andExpr> ] .

 <andop>                          = "&&" .

 <bitOrExpr>                      = <bitXorExpr> [ <bitorop> <bitOrExpr> ] .

 <bitorop>                        = "|" .

 <bitXorExpr>                     = <bitAndExpr> [ <bitxorop> <bitXorExpr> ] .

 <bitxorop>                       = "^" .

 <bitAndExpr>                     = <comparison> [ <bitandop> <bitAndExpr> ] .

 <bitandop>                       = "&" .

 <comparison>                     = <shiftExpr> [ <relop> <shiftExpr> ] .

 <shiftExpr>                      = <addExpr> { <shiftop> <shiftRhs> } .

 <shiftRhs>                       = <addExpr> .

 <shiftop>                        = "<<" 
                                  | ">>" .

 <relop>                          = "<=" 
                                  | ">=" 
                                  | "==" 
                                  | "!=" 
                                  | "<" 
                                  | ">" .

 <addExpr>                        = <term> { <addop> <term> } .

 <addop>                          = "+" 
                                  | "-" .

 <term>                           = <factor> { <mulop> <factor> } .

 <mulop>                          = "*" 
                                  | "/" 
                                  | "%" .

 <factor>                         = <sizeofExpr> 
                                  | <castExpr> 
                                  | <preIncDec> 
                                  | <postIncDec> 
                                  | "(" <expr> ")" 
                                  | <call> 
                                  | <boolLit> 
                                  | <addressRef> 
                                  | <derefRef> 
                                  | <varRef> 
                                  | <number> 
                                  | <negFactor> .

 <negFactor>                      = ( "-" 
                                  | "!" 
                                  | "~" ) <factor> .

 <addressRef>                     = "&" <ident> [ <index> ] .

 <sizeofExpr>                     = "sizeof" "(" <sizeofArg> ")" .

 <sizeofArg>                      = <sizeofType> 
                                  | <sizeofVarName> .

 <sizeofType>                     = "unsigned" <unsignedInt> 
                                  | "int" 
                                  | "char" 
                                  | "bool" 
                                  | "struct" <structTypeRef> .

 <sizeofVarName>                  = <ident> .

 <castExpr>                       = "(" <castType> ")" <castOperand> .

 <castType>                       = "unsigned" <unsignedInt> 
                                  | "int" 
                                  | "char" 
                                  | "bool" .

 <castOperand>                    = <factor> .

 <preIncDec>                      = <incdecOp> <ident> .

 <postIncDec>                     = <ident> <incdecOp> .

 <incdecOp>                       = "++" 
                                  | "--" .

 <incDecStmt>                     = <preIncDec> ";" 
                                  | <postIncDec> ";" .

 <derefRef>                       = "*" <factor> .

 <call>                           = <funcName> "(" <argList> ")" .

 <argList>                        = [ <arg> { "," <arg> } ] .

 <arg>                            = <expr> .

 <target>                         = <directTarget> 
                                  | <indirectTarget> .

 <directTarget>                   = <ident> [ <index> 
                                  | <member> ] .

 <indirectTarget>                 = "*" <factor> .

 <varRef>                         = <ident> [ <index> 
                                  | <member> ] .

 <index>                          = <indexOpen> <expr> "]" .

 <indexOpen>                      = "[" .

 <member>                         = "." <fieldName> .

 <defName>                        = <ident> .

 <paramName>                      = <ident> .

 <localName>                      = <ident> .

 <globalName>                     = <ident> .

 <funcName>                       = <ident> .

 <type>                           = "unsigned" <unsignedInt> 
                                  | "int" 
                                  | "char" 
                                  | "bool" 
                                  | "struct" <structTypeRef> 
                                  | "enum" <enumTypeRef> 
                                  | <typedefRef> .

 <structTypeRef>                  = <ident> .

 <enumTypeRef>                    = <ident> .

 <typedefRef>                     = <ident> .

 <pointerDecl>                    = { <pointerStar> } .

 <pointerStar>                    = "*" .

 <unsignedInt>                    = "int" .

 <boolLit>                        = "true" 
                                  | "false" .

 <ident>                          = <letter> { <letter> 
                                  | <digit> } .

 <number>                         = <digit> { <digit> } .

 <letter>                         = "a"~"z" 
                                  | "A"~"Z" 
                                  | "_" .

 <digit>                          = "0"~"9" .

