	int frame = tcFindBreakTarget(); (void)start; (void)end;
	if (frame < 0) { fprintf(stderr, "tinyc: break outside loop or switch\n"); tcSemanticErrors++; return; }
	printf("JMP L%d\n", tcCtrlEnd[frame]);
}
END
