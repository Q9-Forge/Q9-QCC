454   455   -2    459   0     0     ident            NTS  letter
455   455   456   459   0     0     -                NTS  letter
456   455   -1    462   0     0     -                NTS  digit
457   458   -2    462   0     0     number           NTS  digit
458   458   -1    462   0     0     -                NTS  digit
459   -1    460   -1    97    122   letter           RNG  "a"~"z"
460   -1    461   -1    65    90    -                RNG  "A"~"Z"
461   -1    -2    -1    0     0     -                TS   "_"
462   -1    -2    -1    48    57    digit            RNG  "0"~"9"
[ENDE]

[TESTS]
# TEST "<eingabe>" OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt
[ENDE]

[LEXER]
WHITESPACE = " \t\r\n"
TOKEN ident
TOKEN number
TOKEN stringLit
COMMENT LINE = "//"
COMMENT BLOCK = "/*" "*/"
[ENDE]

[CODEGEN]
# Optional: Ausgabe-Optionen der Codegenerierung.
# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)
# M68K PSECT = name      (psect-Name, Default: <basisname>_p)
[ENDE]

[NUTZER-CODE]
# Tiny-C Frontend (Meilenstein 1): Aktionen emittieren Stack-IR nach stdout.
# Siehe docs/ARCHITEKTUR.md Kapitel 10. Nur ROUTINE C (IR-Emission), analog calcexpr.
