	tst.b	d0
	beq	L45
	bsr	p_structDeclarator
	tst.b	d0
	beq	L45
L46:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L47
	addq.l	#1,a0
