	cmpi.b	#$3D,1(a0)	; Longest-Match '='
	bne	L496
	bra	L495	; kuerzeres Operator-Token ablehnen
L496:
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L495:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: unsignedInt
p_unsignedInt:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$69,(a0)	; 'i'
	bne	L497
	cmpi.b	#$6E,1(a0)	; 'n'
	bne	L497
	cmpi.b	#$74,2(a0)	; 't'
	bne	L497
	move.b	3(a0),d1
	bsr	idch
	tst.b	d0
	bne	L497	; Wortgrenze verletzt
	addq.l	#3,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L497:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: boolLit
p_boolLit:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	bsr	ws
	cmpi.b	#$74,(a0)	; 't'
	bne	L500
	cmpi.b	#$72,1(a0)	; 'r'
	bne	L500
	cmpi.b	#$75,2(a0)	; 'u'
	bne	L500
	cmpi.b	#$65,3(a0)	; 'e'
	bne	L500
	move.b	4(a0),d1
	bsr	idch
	tst.b	d0
	bne	L500	; Wortgrenze verletzt
	addq.l	#4,a0
	bra	L499
L500:	move.l	(a7),a0	; naechste Alternative
	bsr	ws
	cmpi.b	#$66,(a0)	; 'f'
	bne	L501
	cmpi.b	#$61,1(a0)	; 'a'
	bne	L501
	cmpi.b	#$6C,2(a0)	; 'l'
	bne	L501
	cmpi.b	#$73,3(a0)	; 's'
	bne	L501
	cmpi.b	#$65,4(a0)	; 'e'
	bne	L501
	move.b	5(a0),d1
	bsr	idch
	tst.b	d0
	bne	L501	; Wortgrenze verletzt
	addq.l	#5,a0
	bra	L499
L501:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L498
L499:	addq.l	#4,a7
	addq.l	#4,a7
	moveq	#1,d0
	rts
L498:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: ident (lexikalisch)
p_ident:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	p_letter
	tst.b	d0
	beq	L502
L503:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	bsr	p_letter
	tst.b	d0
	beq	L506
	bra	L505
L506:	move.l	(a7),a0	; naechste Alternative
	bsr	p_digit
	tst.b	d0
	beq	L507
	bra	L505
L507:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L504
L505:	addq.l	#4,a7
	addq.l	#4,a7
	bra	L503
L504:	move.l	(a7)+,a0	; Wiederholung beendet
	addq.l	#4,a7
	moveq	#1,d0
	rts
L502:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: number (lexikalisch)
p_number:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	p_digit
	tst.b	d0
	beq	L508
L509:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	p_digit
	tst.b	d0
	beq	L510
	addq.l	#4,a7
	bra	L509
L510:	move.l	(a7)+,a0	; Wiederholung beendet
	addq.l	#4,a7
	moveq	#1,d0
	rts
L508:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
