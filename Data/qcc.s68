	tst.b	d0
	beq	L39
	bsr	ws
	cmpi.b	#$7B,(a0)	; '{'
	bne	L39
	addq.l	#1,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L39
L40:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L41
	addq.l	#1,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L41
	addq.l	#4,a7
	bra	L40
L41:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L39
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L39
