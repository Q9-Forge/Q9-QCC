	cmpi.b	#$7B,(a0)	; '{'
	bne	L41
	addq.l	#1,a0
	bsr	p_structField
	tst.b	d0
	beq	L41
L42:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	p_structField
	tst.b	d0
	beq	L43
	addq.l	#4,a7
	bra	L42
L43:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L41
	addq.l	#1,a0
