	rts
L37:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: ellipsisTok
p_ellipsisTok:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$2E,(a0)	; '.'
	bne	L42
	cmpi.b	#$2E,1(a0)	; '.'
	bne	L42
	cmpi.b	#$2E,2(a0)	; '.'
	bne	L42
	addq.l	#3,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L42:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

