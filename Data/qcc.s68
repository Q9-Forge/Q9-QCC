;---------------------------------------------------------------------------
; Regel: letter (lexikalisch)
p_letter:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	move.b	(a0),d1
	cmpi.b	#$61,d1	; 'a'
	blo	L513
	cmpi.b	#$7A,d1	; 'z'
	bhi	L513
	addq.l	#1,a0
	bra	L512
L513:	move.l	(a7),a0	; naechste Alternative
	move.b	(a0),d1
	cmpi.b	#$41,d1	; 'A'
	blo	L514
	cmpi.b	#$5A,d1	; 'Z'
	bhi	L514
	addq.l	#1,a0
	bra	L512
L514:	move.l	(a7),a0	; naechste Alternative
	cmpi.b	#$5F,(a0)	; '_'
	bne	L515
	addq.l	#1,a0
	bra	L512
L515:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L511
L512:	addq.l	#4,a7
	addq.l	#4,a7
	moveq	#1,d0
	rts
L511:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
