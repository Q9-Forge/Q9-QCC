	cmpi.b	#$74,1(a0)	; 't'
	bne	L46
	cmpi.b	#$72,2(a0)	; 'r'
	bne	L46
	cmpi.b	#$75,3(a0)	; 'u'
	bne	L46
	cmpi.b	#$63,4(a0)	; 'c'
	bne	L46
	cmpi.b	#$74,5(a0)	; 't'
	bne	L46
	move.b	6(a0),d1
