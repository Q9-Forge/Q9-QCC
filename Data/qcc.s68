	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_constKw
	tst.b	d0
	beq	L34
	addq.l	#4,a7
	bra	L35
L34:	move.l	(a7)+,a0	; Option uebersprungen
L35:
	bsr	p_type
	tst.b	d0
	beq	L33
	bsr	p_pointerDecl
	tst.b	d0
	beq	L33
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L36
	addq.l	#4,a7
	bra	L37
L36:	move.l	(a7)+,a0	; Option uebersprungen
L37:
	addq.l	#4,a7
	moveq	#1,d0
	rts
L33:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

