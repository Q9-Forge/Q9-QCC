	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_externParam
	tst.b	d0
	beq	L27
L29:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L30
	addq.l	#1,a0
	bsr	p_externParam
	tst.b	d0
	beq	L30
	addq.l	#4,a7
	bra	L29
L30:	move.l	(a7)+,a0	; Wiederholung beendet
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L31
	addq.l	#1,a0
	bsr	p_ellipsisTok
	tst.b	d0
	beq	L31
	addq.l	#4,a7
	bra	L32
L31:	move.l	(a7)+,a0	; Option uebersprungen
L32:
	addq.l	#4,a7
	bra	L28
L27:	move.l	(a7)+,a0	; Option uebersprungen
L28:
	addq.l	#4,a7
	moveq	#1,d0
	rts
L26:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
