	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_fieldConstKw
	tst.b	d0
	beq	L46
	addq.l	#4,a7
	bra	L47
L46:	move.l	(a7)+,a0	; Option uebersprungen
L47:
	bsr	p_type
	tst.b	d0
	beq	L45
	bsr	p_pointerDecl
	tst.b	d0
	beq	L45
	bsr	p_structDeclarator
	tst.b	d0
	beq	L45
L48:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L49
	addq.l	#1,a0
