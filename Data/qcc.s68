	addq.l	#4,a7
	bra	L48
L49:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L45
	addq.l	#1,a0
	addq.l	#4,a7
