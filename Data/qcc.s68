	beq	L37
	bsr	p_pointerDecl
	tst.b	d0
	beq	L37
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L40
	addq.l	#4,a7
	bra	L41
L40:	move.l	(a7)+,a0	; Option uebersprungen
L41:
	addq.l	#4,a7
