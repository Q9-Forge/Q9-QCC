	cmpi.b	#$74,1(a0)	; 't'
	bne	L41
	cmpi.b	#$72,2(a0)	; 'r'
	bne	L41
	cmpi.b	#$75,3(a0)	; 'u'
	bne	L41
	cmpi.b	#$63,4(a0)	; 'c'
	bne	L41
	cmpi.b	#$74,5(a0)	; 't'
	bne	L41
	move.b	6(a0),d1
	bsr	idch
	tst.b	d0
	bne	L41	; Wortgrenze verletzt
	addq.l	#6,a0
	bsr	p_structName
	tst.b	d0
	beq	L41
