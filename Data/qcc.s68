;---------------------------------------------------------------------------
; Automatisch erzeugt von parsec -- NICHT von Hand aendern.
; Backtracking-Parser (rekursiver Abstieg, geordnete Auswahl), 68k/Motorola.
;
; Aufruf:  a0 = ^Eingabe (NUL-terminiert)
;          bsr parse
; Rueckgabe: d0.b = 1 Erfolg (a0 hinter dem Erkannten), 0 Misserfolg
;            (bei Misserfolg ist a0 unveraendert). d1 wird zerstoert.
; Vollstaendige Erkennung: nach Erfolg pruefen, ob (a0) = 0 (Eingabeende).
; LEXER aktiv: parse ueberliest nach Erfolg auch Whitespace am Ende;
; lexikalische Regeln (TOKEN-Abschluss) matchen adjazente Zeichen.
; Startregel: program
;---------------------------------------------------------------------------

parse:	bsr	p_program
	tst.b	d0
	beq	L0
	bsr	ws	; Whitespace am Eingabeende gehoert mit dazu
L0:	rts

;---------------------------------------------------------------------------
; ws -- Whitespace/Kommentare ueberlesen (zerstoert d1)
ws:
L1:	move.b	(a0),d1
	beq	L3	; Eingabeende
	cmpi.b	#$20,d1	; ' '
	beq	L2
	cmpi.b	#$09,d1	; 0x09
	beq	L2
	cmpi.b	#$0D,d1	; 0x0D
	beq	L2
	cmpi.b	#$0A,d1	; 0x0A
	beq	L2
L9:
	cmpi.b	#$2F,(a0)	; '/'
	bne	L10
	cmpi.b	#$2F,1(a0)	; '/'
	bne	L10
	bra	L4
L4:	move.b	(a0),d1	; Kommentar bis Zeilenende
	beq	L3
	cmpi.b	#$0A,d1	; LF
	beq	L1
	addq.l	#1,a0
	bra	L4
L10:
	cmpi.b	#$2F,(a0)	; '/'
	bne	L3
	cmpi.b	#$2A,1(a0)	; '*'
	bne	L3
	addq.l	#2,a0
L11:	move.b	(a0),d1	; im Blockkommentar
	beq	L3	; unterminiert: Eingabeende
	cmpi.b	#$2A,(a0)	; '*'
	bne	L12
	cmpi.b	#$2F,1(a0)	; '/'
	bne	L12
	addq.l	#2,a0
	bra	L1	; Kommentar zu Ende, weiter ueberlesen
L12:	addq.l	#1,a0
	bra	L11
L2:	addq.l	#1,a0
	bra	L1
L3:	rts

;---------------------------------------------------------------------------
; idch -- d1 Identifikator-Zeichen? d0.b = 1/0
idch:
	cmpi.b	#$30,d1	; '0'
	blo	L6
	cmpi.b	#$39,d1	; '9'
	bls	L5
L6:	cmpi.b	#$41,d1	; 'A'
	blo	L7
	cmpi.b	#$5A,d1	; 'Z'
	bls	L5
L7:	cmpi.b	#$61,d1	; 'a'
	blo	L8
	cmpi.b	#$7A,d1	; 'z'
	bls	L5
L8:	cmpi.b	#$5F,d1	; '_'
	beq	L5
	cmpi.b	#$24,d1	; '$'
	beq	L5
	moveq	#0,d0
	rts
L5:	moveq	#1,d0
	rts

;---------------------------------------------------------------------------
; Regel: program
p_program:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
L14:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	move.l	a0,-(a7)	; Ruecksetzpunkt Auswahl
	bsr	p_globalDecl
	tst.b	d0
	beq	L17
	bra	L16
L17:	move.l	(a7),a0	; naechste Alternative
	bsr	p_structDecl
	tst.b	d0
	beq	L18
	bra	L16
L18:	move.l	(a7),a0	; naechste Alternative
	bsr	p_typedefDecl
	tst.b	d0
	beq	L19
	bra	L16
L19:	move.l	(a7),a0	; naechste Alternative
	bsr	p_enumDecl
	tst.b	d0
	beq	L20
	bra	L16
L20:	move.l	(a7),a0	; naechste Alternative
	bsr	p_externDecl
	tst.b	d0
	beq	L21
	bra	L16
L21:	move.l	(a7)+,a0	; Auswahl gescheitert
	bra	L15
L16:	addq.l	#4,a7
	addq.l	#4,a7
	bra	L14
L15:	move.l	(a7)+,a0	; Wiederholung beendet
L22:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	p_funcdef
	tst.b	d0
	beq	L23
	addq.l	#4,a7
	bra	L22
L23:	move.l	(a7)+,a0	; Wiederholung beendet
	addq.l	#4,a7
	moveq	#1,d0
	rts
L13:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: externDecl
p_externDecl:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$65,(a0)	; 'e'
	bne	L24
	cmpi.b	#$78,1(a0)	; 'x'
	bne	L24
	cmpi.b	#$74,2(a0)	; 't'
	bne	L24
	cmpi.b	#$65,3(a0)	; 'e'
	bne	L24
	cmpi.b	#$72,4(a0)	; 'r'
	bne	L24
	cmpi.b	#$6E,5(a0)	; 'n'
	bne	L24
	move.b	6(a0),d1
	bsr	idch
	tst.b	d0
	bne	L24	; Wortgrenze verletzt
	addq.l	#6,a0
	bsr	p_type
	tst.b	d0
	beq	L24
	bsr	p_pointerDecl
	tst.b	d0
	beq	L24
	bsr	p_externName
	tst.b	d0
	beq	L24
	bsr	ws
	cmpi.b	#$28,(a0)	; '('
	bne	L24
	addq.l	#1,a0
	bsr	p_externParamList
	tst.b	d0
	beq	L24
	bsr	ws
	cmpi.b	#$29,(a0)	; ')'
	bne	L24
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L24
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L24:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: externName
p_externName:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L25
	addq.l	#4,a7
	moveq	#1,d0
	rts
L25:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: externParamList
p_externParamList:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_externParam
	tst.b	d0
	beq	L27
L29:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L30
	addq.l	#1,a0
	bsr	p_externParam
	tst.b	d0
	beq	L30
	addq.l	#4,a7
	bra	L29
L30:	move.l	(a7)+,a0	; Wiederholung beendet
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L31
	addq.l	#1,a0
	bsr	p_ellipsisTok
	tst.b	d0
	beq	L31
	addq.l	#4,a7
	bra	L32
L31:	move.l	(a7)+,a0	; Option uebersprungen
L32:
	addq.l	#4,a7
	bra	L28
L27:	move.l	(a7)+,a0	; Option uebersprungen
L28:
	addq.l	#4,a7
	moveq	#1,d0
	rts
L26:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
; Regel: externParam
p_externParam:
