	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$2A,(a0)	; '*'
	bne	L557
	cmpi.b	#$3D,1(a0)	; Longest-Match '='
	bne	L558
	bra	L557	; kuerzeres Operator-Token ablehnen
L558:
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L557:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

