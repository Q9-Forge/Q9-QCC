	cmpi.b	#$75,3(a0)	; 'u'
	bne	L42
	cmpi.b	#$63,4(a0)	; 'c'
	bne	L42
	cmpi.b	#$74,5(a0)	; 't'
	bne	L42
	move.b	6(a0),d1
	bsr	idch
	tst.b	d0
	bne	L42	; Wortgrenze verletzt
	addq.l	#6,a0
	bsr	p_structName
	tst.b	d0
	beq	L42
	bsr	ws
	cmpi.b	#$7B,(a0)	; '{'
	bne	L42
	addq.l	#1,a0
	bsr	p_structField
	tst.b	d0
	beq	L42
L43:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	p_structField
	tst.b	d0
	beq	L44
	addq.l	#4,a7
	bra	L43
L44:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L42
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L42
	addq.l	#1,a0
	addq.l	#4,a7
