	beq	L46
	bsr	p_pointerDecl
	tst.b	d0
	beq	L46
	bsr	p_fieldName
	tst.b	d0
	beq	L46
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_arraySize
	tst.b	d0
