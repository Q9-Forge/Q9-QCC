p_structDecl:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$73,(a0)	; 's'
	bne	L41
	cmpi.b	#$74,1(a0)	; 't'
	bne	L41
	cmpi.b	#$72,2(a0)	; 'r'
	bne	L41
	cmpi.b	#$75,3(a0)	; 'u'
	bne	L41
	cmpi.b	#$63,4(a0)	; 'c'
	bne	L41
	cmpi.b	#$74,5(a0)	; 't'
	bne	L41
	move.b	6(a0),d1
	bsr	idch
	tst.b	d0
	bne	L41	; Wortgrenze verletzt
	addq.l	#6,a0
	bsr	p_structName
	tst.b	d0
	beq	L41
	bsr	ws
	cmpi.b	#$7B,(a0)	; '{'
	bne	L41
	addq.l	#1,a0
	bsr	p_structField
	tst.b	d0
	beq	L41
L42:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	p_structField
	tst.b	d0
	beq	L43
	addq.l	#4,a7
	bra	L42
L43:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L41
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L41
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L41:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
