	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_externParam
	tst.b	d0
	beq	L31
L33:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L34
	addq.l	#1,a0
	bsr	p_externParam
	tst.b	d0
	beq	L34
	addq.l	#4,a7
	bra	L33
L34:	move.l	(a7)+,a0	; Wiederholung beendet
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L35
	addq.l	#1,a0
	bsr	p_ellipsisTok
	tst.b	d0
	beq	L35
	addq.l	#4,a7
	bra	L36
L35:	move.l	(a7)+,a0	; Option uebersprungen
L36:
	addq.l	#4,a7
	bra	L32
L31:	move.l	(a7)+,a0	; Option uebersprungen
L32:
	addq.l	#4,a7
	moveq	#1,d0
	rts
L30:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
