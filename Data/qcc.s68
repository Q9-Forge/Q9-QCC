	cmpi.b	#$6D,3(a0)	; 'm'
	bne	L38
	move.b	4(a0),d1
	bsr	idch
	tst.b	d0
	bne	L38	; Wortgrenze verletzt
	addq.l	#4,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L38
	bsr	ws
	cmpi.b	#$7B,(a0)	; '{'
	bne	L38
	addq.l	#1,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L38
L39:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L40
	addq.l	#1,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L40
	addq.l	#4,a7
	bra	L39
L40:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L38
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L38
	addq.l	#1,a0
	addq.l	#4,a7
