	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	p_constKw
	tst.b	d0
	beq	L33
	addq.l	#4,a7
	bra	L34
L33:	move.l	(a7)+,a0	; Option uebersprungen
L34:
	bsr	p_type
	tst.b	d0
	beq	L32
	bsr	p_pointerDecl
	tst.b	d0
	beq	L32
	move.l	a0,-(a7)	; Ruecksetzpunkt Option
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L35
	addq.l	#4,a7
	bra	L36
L35:	move.l	(a7)+,a0	; Option uebersprungen
L36:
	addq.l	#4,a7
