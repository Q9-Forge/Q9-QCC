p_externRealParams:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$28,(a0)	; '('
	bne	L29
	addq.l	#1,a0
	bsr	p_externParamList
	tst.b	d0
	beq	L29
	bsr	ws
	cmpi.b	#$29,(a0)	; ')'
	bne	L29
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L29:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
	rts

;---------------------------------------------------------------------------
