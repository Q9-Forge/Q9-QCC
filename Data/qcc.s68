;---------------------------------------------------------------------------
; Regel: structDecl
p_structDecl:
	move.l	a0,-(a7)	; Ruecksetzpunkt Regel
	bsr	ws
	cmpi.b	#$73,(a0)	; 's'
	bne	L46
	cmpi.b	#$74,1(a0)	; 't'
	bne	L46
	cmpi.b	#$72,2(a0)	; 'r'
	bne	L46
	cmpi.b	#$75,3(a0)	; 'u'
	bne	L46
	cmpi.b	#$63,4(a0)	; 'c'
	bne	L46
	cmpi.b	#$74,5(a0)	; 't'
	bne	L46
	move.b	6(a0),d1
	bsr	idch
	tst.b	d0
	bne	L46	; Wortgrenze verletzt
	addq.l	#6,a0
	bsr	p_structName
	tst.b	d0
	beq	L46
	bsr	ws
	cmpi.b	#$7B,(a0)	; '{'
	bne	L46
	addq.l	#1,a0
	bsr	p_structField
	tst.b	d0
	beq	L46
L47:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	p_structField
	tst.b	d0
	beq	L48
	addq.l	#4,a7
	bra	L47
L48:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L46
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L46
	addq.l	#1,a0
	addq.l	#4,a7
