	bne	L43
	cmpi.b	#$6E,1(a0)	; 'n'
	bne	L43
	cmpi.b	#$75,2(a0)	; 'u'
	bne	L43
	cmpi.b	#$6D,3(a0)	; 'm'
	bne	L43
	move.b	4(a0),d1
	bsr	idch
	tst.b	d0
	bne	L43	; Wortgrenze verletzt
	addq.l	#4,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L43
	bsr	ws
	cmpi.b	#$7B,(a0)	; '{'
	bne	L43
	addq.l	#1,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L43
L44:	move.l	a0,-(a7)	; Ruecksetzpunkt Wiederholung
	bsr	ws
	cmpi.b	#$2C,(a0)	; ','
	bne	L45
	addq.l	#1,a0
	bsr	ws
	bsr	p_ident
	tst.b	d0
	beq	L45
	addq.l	#4,a7
	bra	L44
L45:	move.l	(a7)+,a0	; Wiederholung beendet
	bsr	ws
	cmpi.b	#$7D,(a0)	; '}'
	bne	L43
	addq.l	#1,a0
	bsr	ws
	cmpi.b	#$3B,(a0)	; ';'
	bne	L43
	addq.l	#1,a0
	addq.l	#4,a7
	moveq	#1,d0
	rts
L43:	move.l	(a7)+,a0	; Regel gescheitert, Position zurueck
	moveq	#0,d0
