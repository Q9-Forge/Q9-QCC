#================================================================================
# EBNF-ARBEITSDATEI -- automatisch erzeugt von parsec
# Die Bloecke [TESTS] und [NUTZER-CODE] sind zum Editieren gedacht und bleiben
# beim Neu-Erzeugen erhalten. NUTZER-CODE ist vorbereitet, wird aber noch nicht
# in C/68k eingebunden (Format/Architektur: docs/ARCHITEKTUR.md).
# Existiert <basis>.ebnf, ist IMMER die .ebnf die Wahrheit; ohne .ebnf
# kann diese Datei direkt als Grammatik geladen werden (PARSER-TABELLE-Block).
#================================================================================

[EBNF-QUELLTEXT]
 <w1>                             = <a> <b> <c> .

 <w2>                             = <a> 
                                  | <b> 
                                  | <c> .

 <w3>                             = <a> <b> <c> .

 <w4>                             = ( <a> ) <b> .

 <w5>                             = [ <a> ] <b> .

 <w6>                             = [ <a> <b> <c> ] <d> .

 <w7>                             = { <a> } <b> .

 <w8>                             = { <a> <b> <c> } <d> .

 <ebnf>                           = { <rule> } .

 <expression>                     = <term> { "|" <term> } .

 <term>                           = <empty> 
                                  | ( <factor> { [ "," "x" ] <factor> } ) .

 <factor>                         = <ident> 
                                  | <block> 
                                  | <repetition> 
                                  | <option> 
                                  | <literal> .

 <blok>                           = "(" <expression> ")" .

 <repetition>                     = "{" <expression> "}" .

 <option>                         = "[" <expression> "]" .

 <literal>                        = "\042" { <character> } "\042" .

 <empty>                          = .

[ENDE]

[TS-SYMBOLTABELLE]
# nr  typ  symbol
0    TS   "|"
1    TS   ","
2    TS   "x"
3    TS   "("
4    TS   ")"
5    TS   "{"
6    TS   "}"
7    TS   "["
8    TS   "]"
9    TS   """
[ENDE]

[NTS-SYMBOLTABELLE]
# nr  startzeile  name
0    0           w1
1    3           w2
2    6           w3
3    9           w4
4    11          w5
5    13          w6
6    17          w7
7    19          w8
8    23          ebnf
9    24          expression
10   27          term
11   32          factor
12   37          blok
13   40          repetition
14   43          option
15   46          literal
[ENDE]

[PARSER-TABELLE]
# zeile true false addr rngLo rngHi regel modus symbol
# (symbol: Steuerzeichen/Backslash als \ooo enkodiert -- Zeilenformat!)
0     1     -2    -1    0     0     w1               NTS  a
1     2     -3    -1    0     0     -                NTS  b
2     -1    -3    -1    0     0     -                NTS  c
3     -1    4     -1    0     0     w2               NTS  a
4     -1    5     -1    0     0     -                NTS  b
5     -1    -2    -1    0     0     -                NTS  c
6     7     -2    -1    0     0     w3               NTS  a
7     8     -3    -1    0     0     -                NTS  b
8     -1    -3    -1    0     0     -                NTS  c
9     10    -2    -1    0     0     w4               NTS  a
10    -1    -3    -1    0     0     -                NTS  b
11    12    12    -1    0     0     w5               NTS  a
12    -1    -2    -1    0     0     -                NTS  b
13    14    16    -1    0     0     w6               NTS  a
14    15    -3    -1    0     0     -                NTS  b
15    16    -3    -1    0     0     -                NTS  c
16    -1    -2    -1    0     0     -                NTS  d
17    17    18    -1    0     0     w7               NTS  a
18    -1    -2    -1    0     0     -                NTS  b
19    20    22    -1    0     0     w8               NTS  a
20    21    -3    -1    0     0     -                NTS  b
21    19    -3    -1    0     0     -                NTS  c
22    -1    -2    -1    0     0     -                NTS  d
23    23    -1    -1    0     0     ebnf             NTS  rule
24    25    -2    27    0     0     expression       NTS  term
25    26    -1    -1    0     0     -                TS   "|"
26    25    -3    27    0     0     -                NTS  term
27    -1    28    -1    0     0     term             NTS  empty
28    29    -2    32    0     0     -                NTS  factor
29    30    31    -1    0     0     -                TS   ","
30    31    -3    -1    0     0     -                TS   "x"
31    29    -1    32    0     0     -                NTS  factor
32    -1    33    -1    0     0     factor           NTS  ident
