38    39    -3    24    0     0     -                NTS  expression
39    -1    -3    -1    0     0     -                TS   ")"
40    41    -2    -1    0     0     repetition       TS   "{"
41    42    -3    24    0     0     -                NTS  expression
42    -1    -3    -1    0     0     -                TS   "}"
43    44    -2    -1    0     0     option           TS   "["
44    45    -3    24    0     0     -                NTS  expression
45    -1    -3    -1    0     0     -                TS   "]"
46    47    -2    -1    0     0     literal          TS   """
47    47    48    -1    0     0     -                NTS  character
48    -1    -3    -1    0     0     -                TS   """
[ENDE]

[TESTS]
# TEST "<eingabe>" OK|FAIL   -- wird bei jedem Lauf automatisch ausgefuehrt
[ENDE]

[LEXER]
# Optional: aktiviert Whitespace-/Kommentar-Behandlung im ERZEUGTEN Parser.
# WHITESPACE = " \t\r\n"
# TOKEN ident            (Regel wird lexikalisch: Zeichen muessen adjazent sein)
# COMMENT LINE = "//"
[ENDE]

[CODEGEN]
# Optional: Ausgabe-Optionen der Codegenerierung.
# M68K OS9               (zusaetzlich <basis>_os9.a im r68/psect-Format)
# M68K PSECT = name      (psect-Name, Default: <basisname>_p)
[ENDE]

[NUTZER-CODE]
# Reserviert fuer semantische Aktionen pro Regel; noch nicht generiert.
# Siehe docs/ARCHITEKTUR.md, Abschnitt 7.
[ENDE]
