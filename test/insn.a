* Befehlsprobe: jede Form, die qr68 kodieren kann, genau einmal.
* Orakel ist r68 -- test/insndiff.sh stellt beide Ausgaben Zeile fuer Zeile
* gegenueber. Neue Befehlsformen gehoeren hier hinein, BEVOR sie im
* Assembler stehen.
         opt     l
         psect   insn,0,0,1,0,0

* r68 ist ein Zwei-Pass-Assembler: steht der Wert erst weiter unten, waehlt
* es im ersten Durchlauf die lange Form und im zweiten ADDQ -- und meldet
* dann "phasing error" fuer jedes Label dahinter. Deshalb steht der Wert
* hier oben. (qr68 misst so lange, bis sich nichts mehr bewegt, und kaeme
* auch mit der Vorwaertsform zurecht -- nur pruefen laesst sich das nicht,
* weil das Orakel sie ablehnt.)
SPAETWERT equ    4
GLOBWERT: equ    5
GLOBGROSS: equ   $12345

* ---- Adressierungsarten, durchgespielt an move.l -------------------------
ziel     move.l  d1,d0
         move.l  a1,d0
         move.l  (a1),d0
         move.l  (a1)+,d0
         move.l  -(a1),d0
         move.l  4(a1),d0
         move.l  -4(a1),d0
         move.l  0(a1),d0
         move.l  4(a1,d2.l),d0
         move.l  4(a1,d2.w),d0
         move.l  -4(a1,a2.l),d0
         move.l  (a1,d2.l),d0
         move.l  $1000.w,d0
         move.l  $12345678,d0
         move.l  ziel,d0
         move.l  ziel(pc),d0
         move.l  ziel(pc,d2.l),d0
         move.l  #$12345678,d0
         move.l  d0,d1
         move.l  d0,a1
         move.l  d0,(a1)
         move.l  d0,(a1)+
         move.l  d0,-(a1)
         move.l  d0,4(a1)
         move.l  d0,4(a1,d2.l)
         move.l  d0,$1000.w
         move.l  d0,$12345678
         move.l  d0,ziel
         move.b  (a1),d0
         move.b  d0,(a1)
         move.b  #7,d0
         move.b  4(a1),4(a2)
         move.w  (a1),d0
         move.w  #$1234,d0
         move.l  a5,sp
         move.l  sp,a5
         movea.l a5,a0
         movea   4(a5),a0
         move    d0,d1
         moveq   #0,d0
         moveq   #-1,d0
         moveq   #127,d0
         moveq   #-128,d1

* ---- Adressen ------------------------------------------------------------
         lea     4(a5),a0
         lea     -4(a5),a0
         lea     (a5),a0
         lea     4(a5,d1.l),a0
         lea     ziel(pc),a3
         lea     ziel(pcr),a3
         jmp     3(pc)
         jmp     3(pcr)
         lea     8(pc),a0
         lea     SPAETWERT(pc),a2
nahpc    nop
         lea     nahpc(pcr,d1.w),a3
         lea     ziel,a3
         lea     $1000.w,a3
         pea     4(a5)
         pea     ziel(pc)

* ---- Rechnen -------------------------------------------------------------
         add.l   d0,d1
         add.l   (a0),d1
         add.l   (a0)+,d1
         add.l   d1,(a0)
         add.l   d0,a4
         add.l   a4,d0
         add.l   #1,d0
         add.l   #8,d0
         add.l   #9,d0
         add.l   #0,d0
         add.l   #-1,d0
         add.l   #4,a0
         add.l   #9,a0
         add.b   #4,d0
         add.w   #8,d0
         add.l   #4,(a0)
         sub.l   d0,d1
         sub.l   #4,d0
         sub.l   #9,d0
         sub.l   #4,a0
         sub.l   a4,d0
         and.l   d1,d0
         and.l   d1,(a0)
         and.l   #4,d0
         and.b   #$0f,d0
         or.l    (a0),d1
         or.l    #4,d0
         eor.l   d1,d0
         eor.l   d1,(a0)
         eor.l   #4,d0
         cmp.l   d1,d0
         cmp.l   (a0),d1
         cmp.l   #4,d0
         cmp.l   a1,a0
         cmp.b   #7,d0
         adda.l  #4,a0
         adda.l  a1,a0
         adda.w  d1,a0
         suba.l  a1,a0
         cmpa.l  a1,a0
         addi.l  #9,d0
         addi.b  #1,d5
         addi.l  #4,d0
         subi.l  #4,d0
         subi.w  #9,d0
         andi.l  #$ff,d0
         ori.b   #1,d0
         eori.l  #$ff,d0
         cmpi.l  #9,d0
         addq.l  #1,d0
         addq.l  #8,a0
         subq.l  #4,a0
         muls    d1,d0
         muls.w  (a0),d0
         mulu.w  d1,d0
         divs.w  d1,d0
         divu.w  d1,d0
         divu.l  d1,d0
         divu.l  #$64,d1
         divs.l  d0,d5
         mulu.l  d2,d3
         divs.l  d1,d0
         divu.l  d1,d2:d0
         divs.l  4(a5),d3:d4
         mulu.l  d1,d0
         muls.l  d1,d0
         cinva   bc
         cinva   ic
         cinva   dc
         cinva   nc
         cpusha  bc
         cpusha  ic
         cpusha  dc
         cinvl   bc,(a0)
         cpushl  dc,(a1)
         cinvp   ic,(a2)
         cpushp  bc,(a3)

* ---- ein Operand ---------------------------------------------------------
         clr.l   d0
         clr.b   (a0)
         neg.l   d0
         neg.l   (a0)
         negx.l  d0
         not.l   d0
         not.l   (a0)
         tst.l   d0
         tst.b   (a0)
         tst.w   4(a5)
         tas     (a0)
         swap    d0
         ext.w   d0
         ext.l   d0

* ---- Schieben und Rotieren ----------------------------------------------
         asl.l   #1,d0
         asr.l   #8,d0
         lsl.l   #3,d0
         lsr.w   #2,d0
         rol.b   #1,d0
         ror.b   #1,d0
         roxl.l  #2,d0
         roxr.l  #2,d0
         lsl.l   d1,d0
         asr.w   d1,d0
         lsl     (a0)
         asr     (a0)
         roxl    -(a0)

* ---- Registerlisten, Bits, Sonderregister -------------------------------
         movem.l d0-d7/a0-a6,-(sp)
         movem.l (sp)+,d0-d7/a0-a6
         movem.l a0/d6,-(sp)
         movem.l (sp)+,a0/d6
         movem.l d4/d6/d7/a4,-(sp)
         movem.l d2-d7/a3-a5,-(sp)
         movem.l (sp),d2-d7/a3-a5
         movem.l a2/a3/a4,$1000
         movem.w d0-d3,-(sp)
         movem.l d0,-(sp)
         movem   d0-d1,-(sp)
         movem.l 4(a5),d0-d3
         btst    #2,d6
         btst    d1,d6
         btst    #2,(a0)
         btst    #2,4(a5)
         bset    #3,d0
         bclr    #3,(a0)
         bchg    d1,d0
         and.w   #$fe,ccr
         and.b   #$fe,ccr
         or.w    #1,ccr
         and.w   #$fe,sr
         ori     #1,ccr
         ori     #1,cc
         andi    #1,cc
         move.w  d0,cc
         andi    #$fe,ccr
         eori    #1,ccr
         ori.w   #$700,sr
         andi.w  #$f8ff,sr
         ori     #$700,sr
         exg     d0,d1
         exg     a0,a1
         exg     d0,a1
         exg     a1,d0
         move.w  sr,d0
         move.w  d0,sr
         move.w  d0,ccr
         move.l  usp,a0
         move.l  a0,usp
         movec   d0,vbr
         movec   vbr,d0
         movec   d0,sfc
         movec   d0,dfc
         movec   d0,cacr
         movec   a0,usp
         movec   d0,msp
         movec   d0,isp
         moves.l d0,(a0)
         moves.l (a0),d0
         moves.b d1,4(a5)
         cmpm.l  (a0)+,(a5)+
         cmpm.b  (a0)+,(a1)+
         cmpm.w  (a2)+,(a3)+
         movep.w d1,(a0)
         movep.l (a0),d0
         movep.w 4(a0),d1
         movep.l d0,8(a2)

* ---- bedingtes Setzen ----------------------------------------------------
         seq     d0
         sne     d0
         scs     d0
         scc     d0
         sge     d0
         slt     d0
         sgt     d0
         sle     d0
         shi     d0
         sls     d0
         spl     d0
         smi     d0
         svc     d0
         svs     d0
         seq     (a0)

* ---- Spruenge ------------------------------------------------------------
nah      nop
         bra     ziel
         bra.s   nah
         bra.w   ziel
         bsr     ziel
         bsr.s   nah
         beq     ziel
         bne     ziel
         bcs     ziel
         bcc     ziel
         bge     ziel
         blt     ziel
         bgt     ziel
         ble     ziel
         bhi     ziel
         bls     ziel
         bpl     ziel
         bmi     ziel
         bvc     ziel
         bvs     ziel
         beq.s   nah
         dbra    d0,ziel
         dbeq    d0,ziel
         dbne    d1,ziel
         jsr     (a5)
         jsr     4(a5)
         jsr     ziel
         jsr     fremd
         jmp     (a5)
         jmp     ziel

* ---- Rahmen und Systemhaftes --------------------------------------------
         link    a5,#-8
         link    a5,#0
         unlk    a5
         rts
         rte
         rtr
         nop
         trapv
         reset
         illegal
         trap    #0
         trap    #15
         stop    #$2700

* ---- Vorwaerts- und Rueckwaertsbezuege ----------------------------------
         bra     spaet
         add.l   #SPAETWERT,d0
         move.l  #spaet,d0
         dc.l    spaet-ziel
spaet    nop

* ---- Ausrichtung ---------------------------------------------------------
         dc.b    1
mitte    nop
         dc.b    1,2,3
         dc.w    $1234
         dc.b    1
         dc.l    mitte

* ---- Verschiebbares Displacement (OS-9-C-ABI ueber a6) ------------------
         move.b  d0,puffer(a2,d5.w)
         move.b  puffer(a2,d5.w),d0
         move.l  #$7FFFFFFF,puffer(a6)
         move.l  wert(a6),d0
         move.l  fremd(a6),d0
         lea     wert(a6),a0

* ---- Mit Uebertrag und BCD: die Paarform ---------------------------------
* Das ZIEL steht in Bit 11..9, die Quelle unten; ohne Groessenbuchstaben
* ist es das Wort. abcd/sbcd tragen gar kein Groessenfeld.
         addx    d0,d1
         addx.b  d0,d1
         addx.w  d2,d3
         addx.l  d4,d5
         addx.b  -(a0),-(a1)
         addx.l  -(a2),-(a3)
         subx    d0,d1
         subx.w  d2,d3
         subx.b  -(a0),-(a1)
         abcd    d0,d1
         abcd.b  d0,d1
         abcd    -(a0),-(a1)
         sbcd    d0,d1
         sbcd    -(a0),-(a1)
         nbcd    d0
         nbcd    (a0)
         nbcd    8(a1)

* ---- Bereichspruefung ----------------------------------------------------
* Die Breite steht in Bit 8..7: Wort 3, Langwort 2. chk2/cmp2 legen ihr
* Erweiterungswort VOR die Erweiterungswoerter des Operanden.
         chk     (a0),d3
         chk.w   (a0),d0
         chk.w   #7,d1
         chk.l   (a0),d2
         chk.l   #7,d1
         chk2    (a0),d0
         chk2.b  (a0),d0
         chk2.l  (a0),a3
         chk2.w  8(a1),d3
         cmp2    (a0),d0
         cmp2.l  (a0),a4

* ---- BCD packen, vergleichen und tauschen (68020) ------------------------
* Der dritte Operand: bei pack/unpk die Korrektur als ganzes Wort, bei cas
* das Ziel. cas' Breitenfeld ist eins groesser als das uebliche.
         pack    d0,d1,#0
         pack    d2,d3,#$1234
         pack    -(a0),-(a1),#0
         unpk    d0,d1,#0
         unpk    -(a2),-(a3),#$3030
         cas     d0,d1,(a2)
         cas.b   d0,d1,(a2)
         cas.l   d2,d3,(a4)
         cas.w   d0,d1,8(a2)

* ---- Haltepunkt, Rueckkehr, Modulaufruf, langer Rahmen (68020) -----------
         bkpt    #0
         bkpt    #7
         rtd     #8
         rtd     #-4
         callm   #4,(a0)
         callm   #255,8(a1)
         rtm     d0
         rtm     a3
         link.l  a5,#4
         link.l  a2,#$12345

* ---- Bedingter Ausnahmesprung (trapcc, 68020) ----------------------------
* "trapt"/"trapf" sind die Bedingungen 0 und 1.
         trapeq
         trapne
         trapt
         trapf
         trapmi
         trapcc.w #$1234
         trapcc.l #$12345678
         trapeq.w #7
         trapeq.l #7

* ---- PMMU: Puffer leeren und pruefen (68030) -----------------------------
* pflush: Maske in Bit 8..5 (VIER Bit), Betriebsart 4 + pflushs + Adresse<<1.
* ptest nur mit "(aN)" -- alles andere ist in r68 kaputt (s. README).
         pflusha
         pflush  #0,#0
         pflush  #1,#4
         pflush  #15,#0
         pflush  d0,#8
         pflush  d7,#0
         pflush  sfc,#0
         pflush  dfc,#4
         pflushs #0,#0
         pflush  #0,#0,(a0)
         pflush  #0,#0,16(a0)
         pflushs #0,#0,(a0)
         ptestr  #1,(a0),#7
         ptestw  #1,(a0),#7
         ptestr  #0,(a1),#3,a2
         ptestr  d0,(a0),#7
         ptestr  sfc,(a0),#0
         psave   (a0)
         psave   -(a7)
         psave   8(a0)
         prestore (a0)
         prestore (a7)+
         prestore 16(a1)
         lpstop  #$2700

* ---- Schluesselwoerter in GROSSschreibung --------------------------------
* Registernamen nimmt r68 in jeder Schreibung -- Symbolnamen nicht.
         MOVE.L  D0,D1
         movec   d0,DFC
         movec   D0,SFC
         movec   d0,ITT0
         pmove   (A0),TC
         pmove   (A0),SRP
         cinva   BC
         cpushl  DC,(a1)
         move.w  D0,CCR
         movem.l D0-D3/A0,-(SP)
         bfextu  (A1,D1.L){D2:1},D7

* ---- Bitfeldbefehle (68020) ----------------------------------------------
* Das Erweiterungswort steht VOR den Erweiterungswoertern des Operanden;
* darum zaehlt der PC-Abstand ab dem Wort dahinter. "{0:32}" ergibt Breite
* 0 -- die Kodierung meint damit 32; r68 warnt dabei nur.
         bftst   d0{1:2}
         bftst   d0{d1:d2}
         bftst   (a0){1:2}
         bftst   8(a0){1:2}
         bftst   ziel(pc){1:2}
         bftst   d0{31:31}
         bftst   d0{0:32}
         bfchg   d0{1:2}
         bfclr   d0{1:2}
         bfset   d0{1:2}
         bfextu  d0{d1:d2},d3
         bfexts  d0{1:2},d3
         bfffo   d4{0:32},d3
         bfins   d3,d0{d1:d2}
         bfextu  (a1,d1.l){d2:1},d7
         bfins   d3,(a1,d1.l){d2:4}

* ---- Cachezeile bewegen (move16, 68040) ----------------------------------
* Nur die Form mit zwei Postinkrementen hat ein Erweiterungswort.
         move16  (a0)+,(a2)+
         move16  (a1)+,(a0)+
         move16  (a0)+,$12345678
         move16  $12345678,(a1)+
         move16  (a2),$12345678
         move16  $12345678,(a3)

* ---- MMU-Register bewegen (pmove, 68030) ---------------------------------
         pmove   (a0),tc
         pmove   tc,(a0)
         pmove   (a0),srp
         pmove   (a0),crp
         pmove   (a1),tt0
         pmove   (a1),tt1
         pmove   (a2),mmusr
         pmove   mmusr,(a2)
         pmove   8(a0),tc
         pmovefd (a0),tc

* ---- Kontrollregister des 68040/68060 (movec) ----------------------------
* "tc", "srp" und "mmusr" heissen bei pmove genauso und bedeuten dort
* etwas anderes.
         movec   d0,tc
         movec   tc,d0
         movec   d0,itt0
         movec   d0,dtt1
         movec   d0,mmusr
         movec   d0,urp
         movec   d0,srp
         movec   d0,buscr
         movec   d0,pcr

* ---- 32/32-Division mit Rest (divul/divsl, 68020) ------------------------
* Anders als "divu.l dr:dq" bleibt Bit 10 hier FREI -- der Dividend ist 32
* Bit breit, der Rest kommt trotzdem nach dr.
         divul.l d1,d2:d0
         divsl.l d1,d2:d0
         divul.l #10,d3:d4
         divsl.l (a0),d5:d6

* ---- PC-relativ auf einen externen Namen ---------------------------------
* Im Displacementwort steht der KONSTANTE Anteil des Ausdrucks, nicht 0.
         move.l  fremd(pc),d0
         move.l  fremd+4(pc),d1
         move.l  fremd-8(pc),d2
         lea     fremd+2(pc),a0

* ---- Daten und Referenzen ------------------------------------------------
         dc.l    ziel
         dc.w    ziel
         dc.b    ziel
         align   2
         dc.l    fremd
         dc.w    fremd
         dc.l    ziel-spaet
         dc.l    wert
         dc.l    puffer
* Differenz mit einem externen bzw. absoluten Anteil: r68 macht daraus ZWEI
* Referenzen auf denselben Offset, die abgezogene mit $40 im Typwort.
         dc.l    fremd-spaet
         dc.l    fremd-spaet+8
         dc.w    fremd-spaet
         dc.l    SPAETWERT-spaet
* Differenz zweier eigener Groessen -- auch ueber Abschnittsgrenzen -- laesst
* r68 ohne Referenz stehen.
         dc.l    wert-spaet
         dc.l    puffer-spaet
         dc.l    wert-puffer

         vsect
wert:    dc.l    5
zeiger:  dc.l    ziel
puffer:  ds.b    16
         ends
         ends
