* Makros, bedingte Assemblierung und der Systemaufruf. Orakel ist r68
* (test/insndiff.sh). Alles hier ist an r68 gemessen, s. README.
         opt     l

DEFINIERT equ    1
NULL     equ     0
F$Link   equ     $00
I$ReadLn equ     $8B

* ---- Makros -------------------------------------------------------------
* \1..\9 die Argumente (auch in Anfuehrungszeichen), \# ihre Zahl
* ZWEISTELLIG, \@ eine laufende Nummer FUENFSTELLIG, \0 nichts.
ZWEI     macro
         dc.b    \1,\2
         dc.b    \#
         endm
KETTE    macro
         dc.b    "\1",0
         endm
MARKE    macro
lok\@:   dc.b    \1
         dc.l    lok\@
         endm
INNEN    macro
         dc.b    \1+1
         endm
AUSSEN   macro
         INNEN   \1
         dc.b    \2
         endm
LAENGE   macro
         dc.b    \L1,\L2
         endm
BEDINGT  macro
         ifgt    \#-1
         dc.b    \2
         else
         dc.b    $ff
         endc
         endm

         psect   mac,0,0,1,0,0
         ZWEI    $11,$22
         ZWEI    $33,$44
         KETTE   abc
         MARKE   $55
marke2   MARKE   $66
         AUSSEN  $30,$40
         BEDINGT $01,$02
         BEDINGT $03
         LAENGE  a0,abcde
         LAENGE  x,
         dc.l    marke2

* KEIN rept hier: r68 V2.9.1 spult fuer jede Wiederholung um eine feste
* Byteanzahl zurueck und landet dabei MITTEN in einer vorangehenden Zeile --
* schon "delay35 / rept (35-5-9)/2 / nop / endr" (so steht es in
* MWOS/OS9/SRC/IO/SCF/DRVR/sc8x30.a) ergibt neun "bad label"-Fehler. Die
* erzeugten Bytes stimmen dabei zwar, aber als Orakel taugt das nicht.
* qr68 wiederholt genau den Rumpf zwischen rept und endr.

* ---- bedingte Assemblierung ---------------------------------------------
         ifeq    NULL
         dc.b    $11
         endc    (der Operand von endc ist Kommentar)
         ifeq    DEFINIERT
         dc.b    $22
         endc
         ifne    DEFINIERT
         dc.b    $33
         endc
         ifgt    DEFINIERT
         dc.b    $44
         endc
         iflt    DEFINIERT
         dc.b    $55
         endc
         ifge    NULL
         dc.b    $66
         endc
         ifdef   DEFINIERT
         dc.b    $77
         else
         dc.b    $88
         endc
         ifndef  DEFINIERT
         dc.b    $99
         else
         dc.b    $aa
         endc
* Ein uebersprungener Block darf auch Unuebersetzbares enthalten.
         ifdef   GARNICHTDA
         dc.b    $bb
         move.l  UNBEKANNT,d0
         quatsch mit sosse
         endc
         ifeq    NULL
         ifne    DEFINIERT
         dc.b    $cc
         endc
         dc.b    $dd
         endc
         ifne    NULL
         ifeq    NULL
         dc.b    $ee
         endc
         dc.b    $ef
         endc
         align   2

* ---- Systemaufruf --------------------------------------------------------
         os9     F$Link
         os9     I$ReadLn
         os9     $2A
         rts
         ends
