FUNC first_char 0 0
GARRAY __str0 c 6 1
GINIT __str0 0 72
GINIT __str0 1 97
GINIT __str0 2 108
GINIT __str0 3 108
GINIT __str0 4 111
GINIT __str0 5 0
ADDRG __str0
PUSH 0
PADD c
LOADIND c
RET
PUSH 0
RET
ENDFUNC
FUNC greeting 0 0
GARRAY __str1 c 11 1
GINIT __str1 0 72
GINIT __str1 1 97
GINIT __str1 2 108
GINIT __str1 3 108
GINIT __str1 4 111
GINIT __str1 5 44
GINIT __str1 6 32
GINIT __str1 7 81
GINIT __str1 8 57
GINIT __str1 9 33
GINIT __str1 10 0
ADDRG __str1
RETP
PUSH 0
RETP
ENDFUNC
FUNC main 0 0
CALL first_char 0
PRINT
CALLP greeting 0
STOREP 0
LABEL L0
LOADP 0
LOADIND c
JZ L1
LOADP 0
LOADIND c
PRINTC
LOADP 0
PUSH 1
PADD c
STOREP 0
JMP L0
LABEL L1
PUSH 10
PRINTC
PUSH 0
RET
PUSH 0
RET
ENDFUNC
OK
