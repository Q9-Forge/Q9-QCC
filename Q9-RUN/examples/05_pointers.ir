FUNC add_via_pointer 2 0
ADDRL 0
STOREP 2
ADDRL 1
STOREP 3
LOADP 2
LOADIND i
LOADP 3
LOADIND i
ADD
RET
PUSH 0
RET
ENDFUNC
FUNC bump_via_struct_pointer 1 0
PUSH 0
LOADP 0
IPADD c
PUSH 0
LOADP 0
IPADD c
LOADIND i
PUSH 1
ADD
STOREIND i
PUSH 0
LOADP 0
IPADD c
LOADIND i
RET
PUSH 0
RET
ENDFUNC
FUNC array_walk 2 0
PUSH 0
STOREL 4
LOADP 0
STOREP 2
LOADP 0
LOADL 1
PADD i
STOREP 3
LABEL L0
LOADP 2
LOADP 3
PCMPNE
JZ L1
LOADL 4
LOADP 2
LOADIND i
ADD
STOREL 4
LOADP 2
PUSH 1
PADD i
STOREP 2
JMP L0
LABEL L1
LOADL 4
RET
PUSH 0
RET
ENDFUNC
GARRAY numbers i 3 0
FUNC main 0 0
LARRAY 0 c 4
PUSH 0
PUSHADDR L 0
IPADD c
PUSH 41
STOREIND i
PUSH 4
PUSH 5
CALL add_via_pointer 2
PRINT
PUSHADDR L 0
CALL bump_via_struct_pointer 1
PRINT
PUSH 0
PUSH 1
STOREIDX G numbers i
PUSH 1
PUSH 2
STOREIDX G numbers i
PUSH 2
PUSH 3
STOREIDX G numbers i
PUSHADDR G numbers
PUSH 3
CALL array_walk 2
PRINT
PUSH 0
RET
PUSH 0
RET
ENDFUNC
OK
