GARRAY global_table i 4 0
FUNC fill_and_sum 1 0
LARRAY 1 i 4
PUSH 0
STOREL 2
LABEL L0
LOADL 2
LOADL 0
CMPLT
JZ L1
LOADL 2
LOADL 2
PUSH 2
MUL
STOREIDX L 1 i
LOADL 2
LOADL 2
STOREIDX G global_table i
LOADL 2
PUSH 1
ADD
STOREL 2
JMP L0
LABEL L1
PUSH 0
STOREL 3
PUSH 0
STOREL 2
LABEL L2
LOADL 2
LOADL 0
CMPLT
JZ L3
LOADL 3
LOADL 2
LOADIDX L 1 i
ADD
LOADL 2
LOADIDX G global_table i
ADD
STOREL 3
LOADL 2
PUSH 1
ADD
STOREL 2
JMP L2
LABEL L3
LOADL 3
RET
PUSH 0
RET
ENDFUNC
FUNC main 0 0
PUSH 4
CALL fill_and_sum 1
PRINT
PUSH 0
RET
PUSH 0
RET
ENDFUNC
OK
