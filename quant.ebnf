# Quant9 Grammar (EBNF) — complete working draft
# Overwritten per user request (includes generics, mixins, operators, control flow)

Program = { ImportNamespaceDecl } { SystemBlock | StructDecl | InterfaceDecl | FunctionDecl } .

ImportNamespaceDecl = "import" "namespace" NamespacePath ";" .
NamespacePath = Identifier { "." Identifier } .

# System namespaces / modules
SystemBlock = "namespace" NamespacePath "{" { StructDecl | InterfaceDecl | FunctionDecl } "}" .

# Interfaces (method signatures only)
InterfaceDecl = "interface" Identifier "{" { MethodSignature } "}" .
MethodSignature = Identifier "(" [ ParameterList ] ")" ":" Type ";" .

# Struct / Class declarations (single unified construct)
StructDecl = "type" Identifier "=" ( "class" | "struct" ) "{" { StructMember } "}" ";" .
StructMember = FieldDecl | MethodDecl | MixinDecl | ConstructorDecl .
FieldDecl = [ "public" | "private" ] [ "static" ] "let" Identifier ":" Type [ "=" Expression ] ";" .
MethodDecl = [ "public" | "private" ] [ "static" ] "function" Identifier "(" [ ParameterList ] ")" ":" Type Block .
ConstructorDecl = [ "public" | "private" ] "constructor" "(" [ ParameterList ] ")" Block .
MixinDecl = "mixin" Identifier ";" .

# Functions & variables
FunctionDecl = "function" Identifier "(" [ ParameterList ] ")" ":" Type Block .
ParameterList = Parameter { "," Parameter } .
Parameter = Identifier ":" Type .

# Variable with optional Decorator (memory-mapped)
VariableDecl = [ "[" Decorator "]" ] "let" Identifier ":" Type [ "=" Expression ] ";" .
Decorator = "&" HexNumber .

# LValues and Assignments (compound assignments included)
LValue = Identifier | DereferenceExpr | DynamicAccessExpr | FieldAccess .
FieldAccess = Identifier "." Identifier .
Assignment = LValue ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "<<=" | ">>=" | "&=" | "|=" | "^=" ) Expression ";" .

# Control flow / statements
Block = "{" { Statement } "}" .
Statement = VariableDecl | Assignment | FunctionCall ";" | Block | "return" [ Expression ] ";" | IfStmt | WhileStmt | ForStmt | DoWhileStmt | RepeatStmt | ForInStmt | SwitchStmt | BreakStmt | ContinueStmt | GotoStmt | LabelDecl .

IfStmt = "if" "(" Condition ")" Block [ "else" Block ] .
WhileStmt = "while" "(" Condition ")" Block .
DoWhileStmt = "do" Block "while" "(" Condition ")" ";" .
RepeatStmt = "repeat" Block "until" "(" Condition ")" ";" .
ForStmt = "for" "(" ( Assignment | VariableDecl | "" ) ";" [ Condition ] ";" [ Assignment ] ")" Block .
ForInStmt = "for" "(" "let" Identifier ":" Type "in" Expression ")" Block | "for" "(" "let" Identifier ":" Type "," Identifier ":" Type "in" Expression ")" Block .
SwitchStmt = "switch" "(" Expression ")" "{" { CaseClause } [ DefaultClause ] "}" .
CaseClause = "case" Literal ":" { Statement } .
DefaultClause = "default" ":" { Statement } .
BreakStmt = "break" ";" .
ContinueStmt = "continue" ";" .
GotoStmt = "goto" Identifier ";" .
LabelDecl = Identifier ":" .

# Function call
FunctionCall = Identifier "(" [ ArgList ] ")" .
ArgList = Expression { "," Expression } .

# Operators & Expressions (precedence rules)
Primary = Identifier | Number | HexNumber | StringLiteral | "(" Expression ")" | FunctionCall | AddressOfExpr | DereferenceExpr | CastExpr | DynamicAccessExpr | FieldAccess .
Postfix = Primary [ "++" | "--" ] .
Unary = [ "++" | "--" | "!" | "-" ] Postfix .
Term = Unary { ( "*" | "/" | "%" | "<<" | ">>" | "&" | "|" | "^" ) Unary } .
Expression = Term { ( "+" | "-" ) Term } .
Comparison = Expression [ ( "==" | "!=" | "<" | ">" | "<=" | ">=" ) Expression ] .
Condition = Comparison { ( "&&" | "||" ) Comparison } .

# Address / pointer / cast / array access
AddressOfExpr = "&" Identifier .
DereferenceExpr = "*" Identifier .
CastExpr = "(" Type ")" Expression .
DynamicAccessExpr = Identifier "[" Expression "]" .

# Types (with generics/monomorphisation syntax)
SimpleType = Identifier [ "<" TypeList ">" ] .
TypeList = Type { "," Type } .
Type = SimpleType | PointerType | ArrayType .
PointerType = "*" Type .
ArrayType = Type "[" Number "]" .

# Literals and tokens
Literal = Number | StringLiteral .
StringLiteral = '"' { /* any char except " or linebreak */ } '"' .
Identifier = letter { letter | digit | '_' } .
Number = digit { digit } .
HexNumber = "0x" hexDigit { hexDigit } .
letter = "a"~"z" | "A"~"Z" .
digit = "0"~"9" .
hexDigit = "0"~"9" | "A"~"F" | "a"~"f" .

# Whitespace / comments left to lexer conventions

