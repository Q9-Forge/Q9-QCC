* Q9 OS-9/68000 C startup module
* -----------------------------------------------------------------------------
* Purpose: initialize the C runtime and call main(argc, argv, envp).
* Based on: Microware OS-9 Professional V3.3 cstart.a, Edition 7.
* Q9 edition: 2026-09-11
*
* The startup sequence and OS-9/C ABI are kept compatible with the reference
* runtime. The definitions file is still external and will be replaced by a
* Q9-owned version in a later runtime work package.
* -----------------------------------------------------------------------------

        use     q9defs.d                         * Q9 definitions; see q9defs.d

Typ             equ     1                       * OS-9 program module
Edition         equ     7                       * Q9 release edition
StackSize       equ     2048+1024               * Standard stack reservation
CError          equ     257                     * Internal C error code

* Modulbeschreibung ----------------------------------------------------------

        psect   q9_cstart_a,(Q9Prgrm<<8)!Q9Objct,(Q9ReEnt<<8)!1,Edition,StackSize,_cstart,trapinit

CR              equ     $0d                     * Carriage return
Space           equ     $20                     * Space
Comma           equ     $2c                     * Comma
DQuote          equ     $22                     * Double quote
SQuote          equ     $27                     * Single quote

* Prozessdaten ---------------------------------------------------------------
* These areas reside in the Vsect. OS-9 passes the base address in A6.

        vsect
_sttop: ds.l    1                               * Top of the initial stack
_csl_a6:ds.l    1                               * CSL data pointer in OSK mode
        ends

        vsect
_mtop:  ds.l    1                               * Current end of data memory
_stbot: ds.l    1                               * Bottom of the stack
errno:  ds.l    1                               * Global C error code
_totmem:ds.l    1                               * Already allocated memory
_sbsize:ds.l    1                               * Upper limit for sbrk()
_pathcnt:ds.w  1                               * Number of inherited paths
_sysglob:ds.l  1                               * Pointer to system globals
_modhead:ds.l  1                               * Pointer to the process module header
_modname:ds.l  1                               * Pointer to the current module name
_procid:ds.l  1                                * Process ID
_maxstack:ds.l 1                               * Maximum stack depth reached
_glob_data:ds.l 1                              * Pointer to static C data
_csl_bsrentry:ds.l 1                           * CSL BSR entry point
q9_cstart_reserved:ds.l 1                      * Reserved runtime area
        ends

        vsect
_fcbs:  dc.l    _iob                            * Pointer to CIO file blocks
_ofcbs: dc.l    0                               * Compatibility CIO pointer
* Microware clib references the global variable as _environ.
* Q9 startup code previously defined only environ; both names must refer
* to the same process pointer so getenv/system can link with q9_cstart.
_environ:
environ:dc.l    EVNULL                          * Pointer to the environment list
_stklimit:dc.l  0                               * Stack limit not yet verified
        ends

* C-Einstieg -----------------------------------------------------------------
* Entry registers:
*   A3  module base, A4 system globals, A5 parameter area, A6 process data
*   D3  inherited path count, D5 parameter length, D6 initial data size

* Function: _cstart
* Establishes the process data area, initializes runtime state and invokes
* the application entry point.
* Parameters: OS-9 process registers and inherited argument state.
* Returns: Normally does not return; process termination is handled by exit.
_cstart:
        move.l  a6,_glob_data(a6)                * Save static data base
        move.l  a3,_modhead(a6)                 * Save module header
        move.l  d0,_procid(a6)                  * Save process ID
        movea.l a3,a0                           * Copy module address
        adda.l  Q9_M_ID(a0),a0                  * Apply module name offset
        move.l  a0,_modname(a6)                 * Save module name pointer
        move.l  d6,_totmem(a6)                  * Save initial size
        move.l  d6,_sbsize(a6)                  * Initial sbrk() limit
        move.w  d3,_pathcnt(a6)                 * Save inherited paths

        btst    #Q9SupStBit,Q9_M_Attr(a3)        * System-state module?
        beq.s   _cs10                           * No: ignore system pointer
        move.l  a4,_sysglob(a6)                 * Save system globals
        bne.s   _cs10                           * Valid pointer present
        move.l  0.l,_sysglob(a6)                * Old OS-9 convention: address 0
_cs10:

* Command-line arguments -----------------------------------------------------

        tst.l   d5                              * Are arguments present?
        beq.s   oldarg_a                        * No: use the old path
        btst    #0,d5                            * Odd length?
        bne.s   oldarg                          * Old OS-9 argument path
        lea     (a5,d5.l),a0                     * End of argument area
        tst.w   -2(a0)                           * New argv layout?
        bne.s   oldarg                          * No: use old layout
        subq.l  #4,a0                            * Skip environment end
        lea     -4(a0),a4                        * Last envp/argv element
        moveq   #1,d0                            * argv counter
        bra.s   newarg_b

oldarg:
        clr.b   -1(a5,d5.l)                      * Remove CR at argument end
oldarg_a:
        move.l  a5,a0                            * Copy argument base
        adda.l  Q9_M_Name(a3),a3                * Module name as argv[0]
        clr.l   -(sp)                            * argv terminator
        move.l  a3,-(sp)                         * argv[0]
        moveq.l #1,d2                            * At least one argument
        move.l  #_initarg-*-8,d0                 * Relative _initarg call
        jsr     (pcr,d0.l)
        bra.s   iobinit

newarg_a:
        lea     4(a0),a1                         * Save environment list
        move.l  a1,environ(a6)                  * Set environ
        moveq   #0,d2                            * Initialize argc
newarg_b:
        move.l  -(a0),a1                         * Read next offset
        move.l  a1,d7                            * Is the offset zero?
        beq.s   newarg_c                        * End of list
        adda.l  a5,a1                            * Convert offset to pointer
        clr.b   -1(a1)                            * Terminate previous string
        move.l  a1,(a0)                          * Store pointer back
        addq.l  #1,d2                            * Increment argc
        bra.s   newarg_b

newarg_c:
        subq.l  #1,d0                            * Check argv layout
        beq.s   newarg_a                        * Process another element
        tst.l   d2                               * Does a first argument exist?
        bne.s   newarg_e                        * Yes
        tst.w   -2(a0)                            * Was argv supplied by os9exec?
        beq.s   newarg_e                        * Yes: one argument exists
        clr.b   -1(a0)                            * Remove CR from old layout
        movea.l a0,a2                            * Save argv[0] check address
        addq.l  #4,a0                            * Point to next entry
        bra.s   newarg_f

newarg_e:
        move.l  a5,(a0)                          * Set argv[1] to argument base
        movea.l a0,a2                            * Save argv[0] check address
        addq.l  #1,d2                            * Account for missing argv element
newarg_f:
        addq.l  #1,d2                            * Count argv[0]
        tst.l   (a4)                             * Are more entries present?
        beq.s   newarg_i                        * No
        move.l  (a4),a4                          * Get last pointer
newarg_g:
        tst.b   (a4)+                            * Find end of string
        bne.s   newarg_g
        cmpa.l  a4,a2                            * Gap between areas?
        bls.s   newarg_s                        * No: normal layout
        cmpi.b  #$fc,(a4)+                       * argv[0] synchronization byte?
        bne.s   newarg_s                        * No
        addq.l  #1,a4                            * Skip version byte
        move.l  (a4),a3                          * Read argv[0] offset
        adda.l  a5,a3                            * Convert offset to pointer
        bra.s   newarg_t

newarg_i:
        cmpi.b  #$fc,2(a5)                       * Alternativer argv[0]-Aufbau?
        bne.s   newarg_s
        move.l  4(a5),a3                         * argv[0]-Offset lesen
        adda.l  a5,a3                            * Offset in Pointer umwandeln
        bra.s   newarg_t

newarg_s:
        adda.l  Q9_M_Name(a3),a3                 * Modulname als argv[0]
newarg_t:
        move.l  a3,-(a0)                         * argv[0] einsetzen
        move.l  a0,-(sp)                         * argv sichern
        clr.b   -1(a0)                            * CR des Environmentendes loeschen
        move.l  d2,-(sp)                         * argc sichern

* CIO-Initialisierung --------------------------------------------------------

iobinit:
        move.l  #_iobinit-*-8,a0                 * Relokativer _iobinit-Aufruf
        jsr     (pcr,a0.l)
        bcs     die                             * Fehler: Programm beenden

* Hauptprogramm aufrufen -----------------------------------------------------

        bsr.s   _fixtop                         * Speichergrenzen vorbereiten
        movem.l (sp)+,d0-d1                      * argc und argv laden
        suba.l  a5,a5                            * Zukuenftigen Framepointer loeschen
        move.l  environ(a6),-(sp)               * envp an main uebergeben
        move.l  #main-*-8,a0                     * Relokativer main-Aufruf
        jsr     (pcr,a0.l)
        moveq   #0,d0                            * Rueckgabestatus fuer exit()
        move.l  #exit-*-8,a0                     * Relokativer exit-Aufruf
        jsr     (pcr,a0.l)

* Speicher- und Stackverwaltung ---------------------------------------------

_fixtop:
        move.l  #end,a0                         * Ende der statischen Daten
        adda.l  a6,a0                            * In reale Adresse umwandeln
        move.l  a0,_mtop(a6)                    * Aktuelles Speicherende
        move.l  a7,_sttop(a6)                   * Obergrenze des Stacks
        move.l  a7,_stbot(a6)                   * Untere reservierte Stackgrenze
        move.l  #-252,d0                         * Sicherheitsabstand

_stkchec:
_stkcheck:
        add.l   a7,d0                            * Neue Stackgrenze berechnen
        cmp.l   _stbot(a6),d0                    * Bereits reservierter Bereich?
        blo.s   stk10                           * Weiter pruefen
        rts                                     * Genuegend Stack vorhanden
stk10:
        cmp.l   _mtop(a6),d0                     * Datenbereich ueberschritten?
        blo.s   fsterr                          * Ja: Stackfehler
        move.l  d0,_stbot(a6)                    * Neue Grenze speichern
        rts

fsterr:
        lea     fixserr(pc),a0                  * Fehlermeldung ausgeben
        bsr.s   PrtMsg
        move.l  #CError,-(a7)                   * Fehlercode fuer _exit
        move.l  #_os_exit-*-8,a0                * Relokativer _os_exit-Aufruf
        jsr     (pcr,a0.l)

* OS-9-Fehlermeldung ---------------------------------------------------------

PrtMsg:
        move.w  d1,-(sp)                        * Fehlercode sichern
        moveq   #100,d1                         * Maximale Meldungsgroesse
        moveq   #2,d0                           * Standardausgabe
        os9     I$WritLn                         * Meldung schreiben
        move.w  (sp)+,d1                        * Fehlercode wiederherstellen
        rts

* Oeffentliche Laufzeitfunktionen --------------------------------------------

stacksiz:
        move.l  _sttop(a6),d0                   * Anfangsadresse des Stacks
        sub.l   _stbot(a6),d0                   * Aktuell reservierte Groesse
        rts

freemem:
        move.l  _stbot(a6),d0                   * Untere Stackgrenze
        sub.l   _mtop(a6),d0                    * Freier Speicherbereich
        rts

* Uninitialisierter Trap-Handler ---------------------------------------------
* Eintritt:  A7 caller-a6, 4(A7) trap code, 6(A7) vector, 8(A7) return PC.

stacked         set     6*4                     * Offset nach Registersave
trapinit:
        movem.l d0-d1/a0-a3,-(a7)               * Arbeitsregister sichern
        move.w  6+stacked(a7),d0               * Trapvektor lesen
        subi.w  #$80,d0                         * Trapnummer bilden
        asr.w   #2,d0                           * Trapnummer skalieren
        cmpi.w  #T$Math,d0                      * Mathematik-Trap?
        bne.s   tryuser
        lea     m1nam(pc),a0                   * Mathematikmodul
trap_x:
        moveq   #0,d1                           * Kein Zusatzspeicher
        os9     F$TLink                         * Trapmodul laden
        bcc.s   trap_y
tryuser:
        move.l  #_utinit-*-8,a1                 * Benutzer-Trapinitialisierung
        jsr     (pcr,a1.l)
        bcs.s   die
trap_y:
        movem.l (a7)+,d0-d1/a0-a3               * Arbeitsregister restaurieren
        addq.l  #8,a7                           * Trapparameter entfernen
        subq.l  #4,(a7)                         * Ruecksprungadresse korrigieren
        rts

* Konstanten und Fehlermeldungen ---------------------------------------------

        dc.w    $4afb                          * Debugger-Markierung
        dc.w    StrEnd-*-2                      * Debugger-Stringlaenge
fixserr:
        dc.b    "**** Stack Overflow ****",CR,0
TrapErr:
        dc.b    "**** Can't install trap handler ****",CR,0
TrapEr1:
        dc.b    " **** ",0
m1nam:
        dc.b    "math",0
        align
EVNULL:
        dc.l    0                               * Leere Environmentliste
StrEnd:

* Fehlerausgang ---------------------------------------------------------------

badtrap:
        move.l  #E$IllFnc,d1                    * Fehlercode setzen
die:
        move.l  a0,-(sp)                        * Handlername sichern
        lea     TrapErr(pc),a0                  * Allgemeine Fehlermeldung
        bsr     PrtMsg
        movea.l #_iob,a1                        * CIO-Pufferbasis
        adda.l  a6,a1                           * In Prozessadresse umwandeln
        lea     TrapEr1(pc),a0                  * Meldungspraefix
        bsr.s   mover
        move.l  (sp)+,a0                        * Handlername zurueckholen
        subq.l  #1,a1                           * CR-Position korrigieren
        bsr.s   mover
        lea     TrapEr1(pc),a0                  * Meldungssuffix
        subq.l  #1,a1                           * CR-Position korrigieren
        bsr.s   mover
        move.b  #CR,-1(a1)                      * Meldung abschliessen
        movea.l #_iob,a0                        * CIO-Pufferbasis
        adda.l  a6,a0                           * In Prozessadresse umwandeln
        bsr     PrtMsg
        os9     F$Exit                          * Prozess beenden
        os9     F$Exit                          * Debugger-Sicherheitsausgang

mover:
        move.b  (a0)+,(a1)+                     * Zeichen kopieren
        bne.s   mover                           * Bis Nullbyte kopieren
        rts

        ends
