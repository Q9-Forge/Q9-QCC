# QCC driver builds: host executable and XCC-built Q9/68k module.
[global]
TOOLCHAIN_FILE = ../Q9-Make/toolchains/qmake.conf

[ACA]
all: macCla
macCla: mac
mac: $(Q9SDK)/macOS/ARM64/CMDS/qcc
$(Q9SDK)/macOS/ARM64/CMDS/qcc: src/qcc.c
	mkdir -p "$(Q9SDK)/macOS/ARM64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(Q9SDK)/macOS/ARM64/CMDS/qcc" src/qcc.c
clean:
	rm -f "$(Q9SDK)/macOS/ARM64/CMDS/qcc"

[ACI]
all: macX64
macX64: $(Q9SDK)/macOS/x86_64/CMDS/qcc
$(Q9SDK)/macOS/x86_64/CMDS/qcc: src/qcc.c
	mkdir -p "$(Q9SDK)/macOS/x86_64/CMDS" && $(HOST_CC) $(HOST_CFLAGS) -o "$(Q9SDK)/macOS/x86_64/CMDS/qcc" src/qcc.c
clean:
	rm -f "$(Q9SDK)/macOS/x86_64/CMDS/qcc"

[LGL]
all: linux
linux: $(HOST_OUTPUT_DIR)/qcc
$(HOST_OUTPUT_DIR)/qcc: src/qcc.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" src/qcc.c
clean:
	rm -f "$(HOST_OUTPUT_DIR)/qcc"

[AXQ]
all: macXCC
macXCC: mac-qcpp-host xcc
xcc: $(Q9SDK)/Q9/68k/CMDS_XCC/qcc
mac-qcpp-host: $(HOST_OUTPUT_DIR)/qcpp
$(HOST_OUTPUT_DIR)/qcpp: ../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -o "$(HOST_OUTPUT_DIR)/qcpp" ../Q9-FRONTEND-C/q9-qcpp/src/qcpp.c
$(Q9SDK)/Q9/68k/CMDS_XCC/qcc: src/qcc.c ../tools/build_xcc_sdk.sh
	bash ../tools/build_xcc_sdk.sh qcc
clean:
	rm -f "$(Q9SDK)/Q9/68k/CMDS_XCC/qcc"

[AQQ]
all: macQCC
macQCC: $(HOST_OUTPUT_DIR)/qcc
$(HOST_OUTPUT_DIR)/qcc: src/qcc.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" src/qcc.c
clean:
	rm -f "$(HOST_OUTPUT_DIR)/qcc"

[LQQ]
all: linuxQCC
linuxQCC: $(HOST_OUTPUT_DIR)/qcc
$(HOST_OUTPUT_DIR)/qcc: src/qcc.c
	mkdir -p "$(HOST_OUTPUT_DIR)" && $(HOST_CC) $(HOST_CFLAGS) -O2 -Wall -Wextra -o "$(HOST_OUTPUT_DIR)/qcc" src/qcc.c
clean:
	rm -f "$(HOST_OUTPUT_DIR)/qcc"

[QQQ]
all: q9QCC
q9QCC: /dd/CMDS_QCC/qcc
/dd/CMDS_QCC/qcc: src/qcc_q9.c src/qcc.c src/qcc_os9_bridge_q9.c
	qcc --largedata --stack 512K -o /dd/CMDS_QCC/qcc src/qcc_q9.c
clean:
	rm -f /dd/CMDS_QCC/qcc
