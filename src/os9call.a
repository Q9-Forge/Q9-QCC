* _os_write und _os_exit -- die beiden Systemaufrufe, die die Kette
* braucht. Damit faellt Microwares os_lib.l weg.
*
* WARUM DAS HIER STEHT: os_lib.l ist wie clib.l ein libgen-Archiv
* (Kennung $2d00d5bc) und damit fuer ql68 unlesbar. Solange die Kette
* daran haengt, muss mit l68 gebunden werden. Es sind aber nur zwei
* Aufrufe -- und ein Systemaufruf ist unter OS-9/68000 nichts weiter als
* TRAP #0 mit dem Servicewort dahinter.
*
* GEMESSEN, nicht geraten:
*   - Das Trap-Muster steht in Q9-QCC/runtime/os9/q9defs.d
*     ("Das Servicewort folgt im OS-9/68000-ABI direkt auf TRAP #0").
*   - Die Servicenummern stehen ausgeschrieben in
*     MWOS/OS9/SRC/DEFS/funcs.h: I_WRITE 0x8a, F_EXIT 0x06.
*   - Die Registerbelegung ist aus laufendem Code abgelesen (PrtMsg in
*     q9_cstart.a): d0 = Pfadnummer, d1 = Anzahl, a0 = Puffer.
*
* Die Konstanten stehen bewusst HIER und nicht in einem "use" auf die
* MWOS-Definitionen -- qclib soll ohne fremden Baum uebersetzbar sein.

Q9I_Create     equ     $83                      * I$Create, Datei anlegen
Q9I_Open       equ     $84                      * I$Open, Datei oeffnen
Q9I_Read       equ     $89                      * I$Read, Daten lesen
Q9I_Write      equ     $8a                      * I$Write, Daten schreiben
Q9I_Close      equ     $8f                      * I$Close, Pfad schliessen
Q9F_Exit       equ     $06                      * F$Exit, Prozess beenden

         psect   qos9,0,0,0,0,0

* error_code _os_write(path_id path, const void *buffer, u_int32 *count)
*
* C-Seite (Microware-Konvention): d0 = path, d1 = buffer, 4(a7) = &count.
* count ist ein IN/OUT-Zeiger: hinein die gewuenschte Anzahl, heraus die
* tatsaechlich geschriebene.
* OS-9 meldet einen Fehler ueber das Uebertragsbit, der Code steht in d1.

_os_write:
         movea.l d1,a0                           * Puffer nach a0
         movea.l 4(a7),a1                        * &count
         move.l  (a1),d1                         * gewuenschte Anzahl
         trap    #0
         dc.w    Q9I_Write
         bcs.s   ow_err
         move.l  d1,(a1)                         * tatsaechlich geschrieben
         moveq   #0,d0                           * kein Fehler
         rts
ow_err
         moveq   #0,d0
         move.w  d1,d0                           * Fehlercode zurueckgeben
         rts

* void _os_exit(int status) -- kehrt nicht zurueck.
* Der zweite Aufruf ist die Sicherung fuer den Fall, dass ein Debugger den
* ersten abfaengt; genauso macht es q9_cstart.a.

_os_exit:
         move.l  d0,d1                           * Status nach d1
         trap    #0
         dc.w    Q9F_Exit
         trap    #0
         dc.w    Q9F_Exit
         rts


* error_code _os_open(const char *name, u_int32 mode, path_id *path)
*
* C-Seite: d0 = name, d1 = mode, 4(a7) = &path.
* OS-9-Seite (am Original aus os_lib.l abgelesen): d0.w = Zugriffsmodus,
* a0 = Pfadname; zurueck kommt die Pfadnummer in d0. Microwares Fassung
* maskiert sie auf 16 Bit -- das tut diese auch, sonst stehen im oberen
* Wort Reste.

_os_open:
         movea.l d0,a0                           * Name nach a0
         move.l  d1,d0                           * Modus nach d0
         trap    #0
         dc.w    Q9I_Open
         bcs.s   oo_err
         andi.l  #$0000ffff,d0                   * nur die Pfadnummer
         movea.l 4(a7),a1                        * &path
         move.l  d0,(a1)
         moveq   #0,d0
         rts
oo_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_close(path_id path) -- d0 traegt den Pfad schon.

_os_close:
         trap    #0
         dc.w    Q9I_Close
         bcs.s   oc_err
         moveq   #0,d0
         rts
oc_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_read(path_id, void *buffer, u_int32 *count)
* Spiegelbild von _os_write: d0 = Pfad, d1 = Puffer, 4(a7) = &count.

_os_read:
         movea.l d1,a0                           * Puffer nach a0
         movea.l 4(a7),a1                        * &count
         move.l  (a1),d1                         * gewuenschte Anzahl
         trap    #0
         dc.w    Q9I_Read
         bcs.s   or_err
         move.l  d1,(a1)                         * tatsaechlich gelesen
         moveq   #0,d0
         rts
or_err
         moveq   #0,d0
         move.w  d1,d0
         rts

* error_code _os_create(const char *name, u_int32 mode, path_id *path,
*                       u_int32 perms)
* Wie _os_open, zusaetzlich die Dateirechte in d1.w (I$Create erwartet
* den Zugriffsmodus in d0.b und die Attribute in d1.w).

_os_create:
         movea.l d0,a0                           * Name nach a0
         move.l  d1,d0                           * Modus nach d0
         move.l  8(a7),d1                        * Rechte nach d1
         trap    #0
         dc.w    Q9I_Create
         bcs.s   ocr_err
         andi.l  #$0000ffff,d0
         movea.l 4(a7),a1
         move.l  d0,(a1)
         moveq   #0,d0
         rts
ocr_err
         moveq   #0,d0
         move.w  d1,d0
         rts

         ends
