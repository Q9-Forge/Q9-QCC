#!/bin/sh
# qmake PATH-fallback bootstrap -- not the real qmake, a stand-in for it.
#
# Install this directory LAST in PATH, after the real per-host CMDS
# directory (e.g. after $Q9SDK/Linux/CMDS). As long as the real qmake
# binary exists there, the shell's normal left-to-right PATH search finds
# it first and never reaches this script. `qmake -P <profile> clean`
# removes that binary along with everything else it built (qmake is one
# of the files its own clean rule deletes) -- the next plain "qmake" call
# then falls through PATH to here instead of failing with "command not
# found". This script rebuilds the real binary via Q9-Make's plain
# bootstrap Makefile (the same one-liner used the very first time, no
# q9makefile/qmake.conf needed), installs it back at the real location,
# and execs it with the original arguments, so even that first "broken"
# invocation still completes. Nothing here is a permanent replacement:
# the moment the real binary exists again, this script is bypassed exactly
# as before.
set -eu

self_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# self_dir is .../Q9-Make/tools/path-bootstrap; the plain Makefile lives
# two levels up, in Q9-Make itself.
qmake_src=$(CDPATH= cd -- "$self_dir/../.." && pwd)

: "${Q9SDK:?Set Q9SDK to the SDK root before calling qmake}"

case "$(uname -s)" in
	Darwin)
		case "$(uname -m)" in
			arm64) real="$Q9SDK/macOS/ARM64/CMDS/qmake" ;;
			*)     real="$Q9SDK/macOS/x86_64/CMDS/qmake" ;;
		esac
		;;
	Linux)
		real="$Q9SDK/Linux/CMDS/qmake"
		;;
	*)
		echo "qmake bootstrap: unsupported host $(uname -s) -- build qmake manually, see Q9-Make/README.md" >&2
		exit 1
		;;
esac

if [ ! -x "$real" ]; then
	# Q9-Make/build is a path on the SHARED Q9SDK filesystem -- the plain
	# Makefile's default BUILD=build would be reused (and its up-to-date
	# check fooled) by whichever OTHER host platform last bootstrapped
	# here, since source timestamps alone can't tell two platforms' object
	# code apart (hit live: a macOS Mach-O qmake got copied onto Linux and
	# failed "Exec format error"). A platform-namespaced BUILD directory
	# keeps every host's bootstrap build separate.
	build_dir="build/host-$(uname -s)"
	echo "qmake: not found at $real yet, bootstrapping via 'make' in $qmake_src ($build_dir) ..." >&2
	make -C "$qmake_src" BUILD="$build_dir" >&2
	mkdir -p "$(dirname "$real")"
	cp "$qmake_src/$build_dir/qmake" "$real"
	echo "qmake: installed at $real" >&2
fi

exec "$real" "$@"
